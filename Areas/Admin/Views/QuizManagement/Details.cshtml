@model QuizManagementDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết quiz";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <a asp-action="Index" class="text-sm font-semibold text-blue-600">Quay lại</a>
    <div class="bg-white border border-slate-200 rounded-xl p-6">
        <h1 class="text-2xl font-bold">@Model.Title</h1>
        <p class="text-sm text-slate-500">@Model.TopicTitle | @Model.TeacherName | @Model.Status</p>
        <p class="mt-3 text-sm text-slate-600">@Model.Description</p>
    </div>
    <div class="space-y-3">
        @foreach (var question in Model.Questions)
        {
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="font-semibold">@question.QuestionText</div>
                <div class="text-sm text-slate-500">@question.QuestionType | @question.Points.ToString("0.##") điểm</div>
                <div class="text-sm text-emerald-700 mt-1">Đáp án: @question.CorrectAnswer</div>
            </div>
        }
    </div>
</div>
