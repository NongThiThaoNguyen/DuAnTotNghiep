@model EditAssignmentAdminViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài tập";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6 max-w-4xl mx-auto">
    <div class="flex items-center justify-between">
        <div>
            <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-700 mb-2">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Quay lại danh sách bài tập
            </a>
            <h1 class="text-2xl font-bold text-slate-900">Chỉnh sửa bài tập</h1>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AssignmentId" />
        <div asp-validation-summary="All" class="text-xs text-rose-600 font-medium"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Title -->
            <div class="md:col-span-2">
                <label asp-for="Title" class="block text-sm font-semibold text-slate-700 mb-2">Tên bài tập <span class="text-rose-500">*</span></label>
                <input asp-for="Title" required placeholder="Nhập tiêu đề bài tập" class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all" />
                <span asp-validation-for="Title" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Topic -->
            <div>
                <label asp-for="TopicId" class="block text-sm font-semibold text-slate-700 mb-2">Topic liên quan</label>
                <select asp-for="TopicId" class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    <option value="">-- Chưa chọn topic --</option>
                    @foreach (var topic in Model.Topics)
                    {
                        <option value="@topic.Id" selected="@(Model.TopicId == topic.Id ? "selected" : null)">@topic.Text</option>
                    }
                </select>
            </div>

            <!-- Task Type -->
            <div>
                <label asp-for="TaskType" class="block text-sm font-semibold text-slate-700 mb-2">Loại bài tập <span class="text-rose-500">*</span></label>
                <select asp-for="TaskType" class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    <option value="ASSIGNMENT">Bài tập chính (ASSIGNMENT)</option>
                    <option value="PRACTICE">Luyện tập (PRACTICE)</option>
                    <option value="ESSAY">Viết luận (ESSAY)</option>
                    <option value="SPEAKING">Nói (SPEAKING)</option>
                </select>
            </div>

            <!-- Difficulty Level -->
            <div>
                <label asp-for="DifficultyLevel" class="block text-sm font-semibold text-slate-700 mb-2">Độ khó</label>
                <select asp-for="DifficultyLevel" class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    <option value="EASY">Dễ (EASY)</option>
                    <option value="MEDIUM">Trung bình (MEDIUM)</option>
                    <option value="HARD">Khó (HARD)</option>
                </select>
            </div>

            <!-- Status -->
            <div>
                <label asp-for="Status" class="block text-sm font-semibold text-slate-700 mb-2">Trạng thái lưu hành <span class="text-rose-500">*</span></label>
                <select asp-for="Status" class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
                    <option value="ACTIVE">Hoạt động (ACTIVE / PUBLISHED)</option>
                    <option value="CLOSED">Đã đóng (CLOSED)</option>
                    <option value="DRAFT">Bản nháp (DRAFT)</option>
                    <option value="ARCHIVED">Lưu trữ (ARCHIVED)</option>
                </select>
            </div>
        </div>

        <!-- Instruction -->
        <div>
            <label asp-for="Instruction" class="block text-sm font-semibold text-slate-700 mb-2">Nội dung / Yêu cầu chi tiết (Instruction) <span class="text-rose-500">*</span></label>
            <textarea asp-for="Instruction" rows="6" required placeholder="Nhập đề bài hoặc yêu cầu bài tập..." class="block w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"></textarea>
            <span asp-validation-for="Instruction" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <!-- Buttons -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <a asp-action="Index" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-xl transition-colors">
                Hủy bỏ
            </a>
            <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl transition-colors shadow-xs">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>
