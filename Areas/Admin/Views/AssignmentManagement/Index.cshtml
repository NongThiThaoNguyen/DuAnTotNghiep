@model AssignmentManagementIndexViewModel
@{
    ViewData["Title"] = "Quản lý bài tập";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var firstItem = Model.TotalItems == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.TotalItems, Model.CurrentPage * Model.PageSize);

    string StatusBadgeClass(string status)
    {
        return (status ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "ACTIVE" or "PUBLISHED" => "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200",
            "DRAFT" => "bg-blue-50 text-blue-700 ring-1 ring-blue-200",
            "ARCHIVED" => "bg-slate-100 text-slate-600 ring-1 ring-slate-200",
            _ => "bg-slate-100 text-slate-700 ring-1 ring-slate-200"
        };
    }
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">Quản lý bài tập toàn hệ thống</h1>
        <p class="text-sm text-slate-500">Theo dõi bài tập, giáo viên tạo, số bài nộp và trạng thái lưu hành.</p>
    </div>

    <form method="get" class="flex flex-col gap-3 bg-white border border-slate-200 rounded-xl p-4 sm:flex-row sm:items-center">
        <select name="topicId" class="rounded-lg border-slate-300 text-sm sm:min-w-72">
            <option value="">Tất cả topic</option>
            @foreach (var topic in Model.Topics)
            {
                <option value="@topic.Id" selected="@(Model.TopicId == topic.Id ? "selected" : null)">@topic.Text</option>
            }
        </select>
        <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-white text-sm font-semibold hover:bg-blue-700">Lọc</button>
        <a asp-action="Index" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Xóa lọc</a>
    </form>

    <p class="text-sm text-slate-500">Hiển thị @firstItem-@lastItem trong @Model.TotalItems bài tập.</p>

    <div class="overflow-x-auto bg-white border border-slate-200 rounded-xl">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500"><tr><th class="px-4 py-3">Bài tập</th><th class="px-4 py-3">Topic</th><th class="px-4 py-3">Giáo viên</th><th class="px-4 py-3">Submission</th><th class="px-4 py-3">Trạng thái</th><th class="px-4 py-3 text-right">Thao tác</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-4 py-3 font-semibold text-slate-900">@item.Title</td>
                            <td class="px-4 py-3">@item.TopicTitle</td>
                            <td class="px-4 py-3">@item.TeacherName</td>
                            <td class="px-4 py-3">@item.SubmissionCount</td>
                            <td class="px-4 py-3"><span class="rounded-full px-2 py-1 text-xs font-semibold @StatusBadgeClass(item.Status)">@item.Status</span></td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex justify-end gap-3 whitespace-nowrap">
                                    <a asp-action="Submissions" asp-route-assignmentId="@item.AssignmentId" class="text-blue-600 font-semibold hover:text-blue-700">Submissions</a>
                                    <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('Lưu trữ bài tập này? Bài nộp và lịch sử sẽ được giữ lại.');">
                                        <input type="hidden" name="assignmentId" value="@item.AssignmentId" />
                                        <input type="hidden" name="topicId" value="@Model.TopicId" />
                                        <button type="submit" class="text-red-600 font-semibold hover:text-red-700 whitespace-nowrap">Lưu trữ</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-4 py-10 text-center text-slate-500">
                            Không có bài tập phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">
            <a asp-action="Index"
               asp-route-topicId="@Model.TopicId"
               asp-route-page="@(Model.CurrentPage - 1)"
               class="font-semibold text-slate-600 hover:text-blue-600 @(Model.CurrentPage <= 1 ? "pointer-events-none opacity-40" : "")">Trước</a>
            <span class="font-medium text-slate-500">Trang @Model.CurrentPage / @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-topicId="@Model.TopicId"
               asp-route-page="@(Model.CurrentPage + 1)"
               class="font-semibold text-slate-600 hover:text-blue-600 @(Model.CurrentPage >= Model.TotalPages ? "pointer-events-none opacity-40" : "")">Sau</a>
        </div>
    }
</div>
