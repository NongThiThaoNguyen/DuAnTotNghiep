@model DuAnTotNghiep.Areas.Admin.ViewModels.AdminTeacherScheduleListViewModel
@{
    ViewData["Title"] = "Lịch giáo viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = Model.Filter;

    string NextDirection(string sortBy)
    {
        return string.Equals(filter.SortBy, sortBy, StringComparison.OrdinalIgnoreCase)
            && string.Equals(filter.SortDirection, "asc", StringComparison.OrdinalIgnoreCase)
                ? "desc"
                : "asc";
    }

    string SortIndicator(string sortBy)
    {
        if (!string.Equals(filter.SortBy, sortBy, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        return string.Equals(filter.SortDirection, "desc", StringComparison.OrdinalIgnoreCase) ? "↓" : "↑";
    }
}

<div class="space-y-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center gap-3 shadow-xs">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-red-50 text-red-800 border border-red-200 flex items-center gap-3 shadow-xs">
            <svg class="w-5 h-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
            <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header Page -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Lịch giảng viên</h1>
            <p class="text-sm text-slate-500 mt-1">Sắp xếp thời khóa biểu, lịch giảng dạy và phòng học cho đội ngũ giáo viên.</p>
        </div>
        <a asp-action="Create" class="rs-filter-btn-primary self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Tạo lịch thủ công
        </a>
    </div>

    <!-- KHU VỰC 1: GỢI Ý & TẠO LỊCH BẰNG AI (COMPACT LAYOUT) -->
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs">
        <div class="px-4 py-3 border-b border-slate-200 bg-slate-50/60 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <h2 class="text-sm font-bold text-slate-800">Gợi ý & Tạo lịch tự động (AI Gemini)</h2>
            </div>
            <span class="rs-badge rs-badge-warning text-xs">
                Google AI Gemini
            </span>
        </div>
        <div class="p-4">
            <form asp-action="GenerateAiSuggestions" method="post">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                    <div>
                        <label asp-for="AiRequest.TeacherId" class="rs-filter-label">Giáo viên</label>
                        <select asp-for="AiRequest.TeacherId" name="TeacherId" asp-items="Model.AvailableTeachers" class="block w-full py-1.5 px-2.5 text-xs border border-slate-300 rounded-lg bg-white">
                            <option value="">AI tự chọn</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="AiRequest.TopicId" class="rs-filter-label">Chủ đề</label>
                        <select asp-for="AiRequest.TopicId" name="TopicId" asp-items="Model.AvailableTopics" class="block w-full py-1.5 px-2.5 text-xs border border-slate-300 rounded-lg bg-white">
                            <option value="">Tùy chọn</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="AiRequest.FromDate" class="rs-filter-label">Từ ngày</label>
                        <input asp-for="AiRequest.FromDate" name="FromDate" type="date" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.ToDate" class="rs-filter-label">Đến ngày</label>
                        <input asp-for="AiRequest.ToDate" name="ToDate" type="date" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.SessionsCount" class="rs-filter-label">Số buổi</label>
                        <input asp-for="AiRequest.SessionsCount" name="SessionsCount" type="number" min="1" max="20" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.DurationMinutes" class="rs-filter-label">Phút/buổi</label>
                        <input asp-for="AiRequest.DurationMinutes" name="DurationMinutes" type="number" min="15" max="240" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.PreferredStartHour" class="rs-filter-label">Từ giờ (h)</label>
                        <input asp-for="AiRequest.PreferredStartHour" name="PreferredStartHour" type="number" min="0" max="23" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.PreferredEndHour" class="rs-filter-label">Đến giờ (h)</label>
                        <input asp-for="AiRequest.PreferredEndHour" name="PreferredEndHour" type="number" min="1" max="24" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" />
                    </div>
                    <div>
                        <label asp-for="AiRequest.Classroom" class="rs-filter-label">Phòng ưu tiên</label>
                        <input asp-for="AiRequest.Classroom" name="Classroom" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" placeholder="A101, Zoom..." />
                    </div>
                    <div class="col-span-2 lg:col-span-2">
                        <label asp-for="AiRequest.Notes" class="rs-filter-label">Yêu cầu thêm</label>
                        <input asp-for="AiRequest.Notes" name="Notes" class="block w-full py-1.5 px-2 text-xs border border-slate-300 rounded-lg bg-white" placeholder="Tránh thứ 7, ưu tiên sáng..." />
                    </div>
                    <div class="flex items-end col-span-2 sm:col-span-1 lg:col-span-1">
                        <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 h-8 px-3 bg-emerald-600 text-white text-xs font-semibold rounded-lg hover:bg-emerald-700 transition-colors shadow-xs">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            Gợi ý AI
                        </button>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.AiErrorMessage))
            {
                <div class="mt-3 p-3 rounded-lg bg-red-50 text-red-800 border border-red-200 text-xs font-medium">
                    @Model.AiErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AiSummary))
            {
                <div class="mt-3 p-3 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-medium">
                    @Model.AiSummary
                </div>
            }

            @if (Model.AiSuggestions.Any())
            {
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    @foreach (var suggestion in Model.AiSuggestions)
                    {
                        <div class="border border-slate-200 rounded-xl p-3 bg-white shadow-xs flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2">
                                    <h4 class="text-xs font-bold text-slate-900 truncate">@suggestion.Title</h4>
                                    <span class="rs-badge rs-badge-info text-[10px] px-1.5 py-0.5">AI</span>
                                </div>
                                <div class="mt-2 space-y-1 text-xs text-slate-600">
                                    <div class="font-semibold text-slate-800">@suggestion.TeacherName</div>
                                    <div class="text-slate-500">@suggestion.StartTime.ToString("dd/MM/yyyy HH:mm") - @suggestion.EndTime.ToString("HH:mm")</div>
                                    <div class="text-slate-500">Topic: @suggestion.TopicName | Phòng: @(string.IsNullOrWhiteSpace(suggestion.Classroom) ? "Online" : suggestion.Classroom)</div>
                                    <p class="text-[11px] text-slate-400 italic line-clamp-2 mt-1">"@suggestion.Reason"</p>
                                </div>
                            </div>
                            <form asp-action="ApplyAiSuggestion" method="post" class="mt-3 pt-2 border-t border-slate-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Title" value="@suggestion.Title" />
                                <input type="hidden" name="TeacherId" value="@suggestion.TeacherId" />
                                <input type="hidden" name="TopicId" value="@suggestion.TopicId" />
                                <input type="hidden" name="StartTime" value='@suggestion.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")' />
                                <input type="hidden" name="EndTime" value='@suggestion.EndTime.ToString("yyyy-MM-ddTHH:mm:ss")' />
                                <input type="hidden" name="Classroom" value="@suggestion.Classroom" />
                                <input type="hidden" name="Description" value="@suggestion.Description" />
                                <input type="hidden" name="Reason" value="@suggestion.Reason" />
                                <button type="submit" class="w-full inline-flex items-center justify-center gap-1 h-7 px-2 bg-blue-600 text-white text-xs font-semibold rounded-md hover:bg-blue-700 transition-colors">
                                    Áp dụng gợi ý này
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- KHU VỰC 2: BỘ LỌC LỊCH (UNIFIED RS-FILTER-BAR) -->
    <form method="get" asp-action="Index" class="rs-filter-bar">
        <input asp-for="Filter.SortBy" name="SortBy" type="hidden" />
        <input asp-for="Filter.SortDirection" name="SortDirection" type="hidden" />

        <div class="rs-filter-field rs-filter-field-lg">
            <label class="rs-filter-label">Tìm kiếm</label>
            <input asp-for="Filter.Keyword" name="Keyword" placeholder="Tiêu đề, giáo viên, phòng..." />
        </div>
        <div class="rs-filter-field rs-filter-field-lg">
            <label class="rs-filter-label">Giáo viên</label>
            <select asp-for="Filter.TeacherId" name="TeacherId" asp-items="Model.AvailableTeachers">
                <option value="">Tất cả giáo viên</option>
            </select>
        </div>
        <div class="rs-filter-field rs-filter-field-sm">
            <label class="rs-filter-label">Từ ngày</label>
            <input asp-for="Filter.FromDate" name="FromDate" type="date" />
        </div>
        <div class="rs-filter-field rs-filter-field-sm">
            <label class="rs-filter-label">Đến ngày</label>
            <input asp-for="Filter.ToDate" name="ToDate" type="date" />
        </div>
        <div class="rs-filter-actions">
            <button type="submit" class="rs-filter-btn-primary">Lọc</button>
            <a asp-action="Index" class="rs-filter-btn-secondary">Làm mới</a>
        </div>
    </form>

    <!-- KHU VỰC 3: BẢNG LỊCH GIẢNG VIÊN -->
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs">
        <div class="px-4 py-3 border-b border-slate-200 bg-slate-50/60 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-900">Bảng lịch giảng dạy</h2>
            <span class="text-xs text-slate-500">Hiển thị tổng cộng <strong class="text-slate-800">@Model.Items.Count()</strong> lịch</span>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500 tracking-wider">
                    <tr>
                        <th scope="col" class="px-4 py-3">
                            <a asp-action="Index"
                               asp-route-Keyword="@filter.Keyword"
                               asp-route-TeacherId="@filter.TeacherId"
                               asp-route-FromDate='@(filter.FromDate?.ToString("yyyy-MM-dd"))'
                               asp-route-ToDate='@(filter.ToDate?.ToString("yyyy-MM-dd"))'
                               asp-route-SortBy="startTime"
                               asp-route-SortDirection="@NextDirection("startTime")"
                               class="inline-flex items-center gap-1 text-slate-600 hover:text-blue-600">
                                Thời gian @SortIndicator("startTime")
                            </a>
                        </th>
                        <th scope="col" class="px-4 py-3">Lớp / Tiêu đề</th>
                        <th scope="col" class="px-4 py-3">
                            <a asp-action="Index"
                               asp-route-Keyword="@filter.Keyword"
                               asp-route-TeacherId="@filter.TeacherId"
                               asp-route-FromDate='@(filter.FromDate?.ToString("yyyy-MM-dd"))'
                               asp-route-ToDate='@(filter.ToDate?.ToString("yyyy-MM-dd"))'
                               asp-route-SortBy="teacher"
                               asp-route-SortDirection="@NextDirection("teacher")"
                               class="inline-flex items-center gap-1 text-slate-600 hover:text-blue-600">
                                Giáo viên @SortIndicator("teacher")
                            </a>
                        </th>
                        <th scope="col" class="px-4 py-3">
                            <a asp-action="Index"
                               asp-route-Keyword="@filter.Keyword"
                               asp-route-TeacherId="@filter.TeacherId"
                               asp-route-FromDate='@(filter.FromDate?.ToString("yyyy-MM-dd"))'
                               asp-route-ToDate='@(filter.ToDate?.ToString("yyyy-MM-dd"))'
                               asp-route-SortBy="topic"
                               asp-route-SortDirection="@NextDirection("topic")"
                               class="inline-flex items-center gap-1 text-slate-600 hover:text-blue-600">
                                Chủ đề @SortIndicator("topic")
                            </a>
                        </th>
                        <th scope="col" class="px-4 py-3">Phòng học</th>
                        <th scope="col" class="px-4 py-3 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-10 text-center text-slate-500">
                                <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Không có lịch nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="font-semibold text-slate-900">@item.StartTime.ToString("dd/MM/yyyy")</div>
                                    <div class="text-xs text-slate-500">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-slate-900">@item.Title</div>
                                    <div class="text-xs text-slate-500 truncate max-w-xs">@(item.Description ?? "Không có ghi chú")</div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="font-semibold text-slate-900">@item.TeacherName</div>
                                    <div class="text-xs text-slate-400">@item.TeacherEmail</div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-700">@item.TopicName</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="flex flex-col gap-1">
                                        <span class="rs-badge rs-badge-info text-xs self-start">
                                            @(string.IsNullOrWhiteSpace(item.Classroom) ? "Phòng Online" : item.Classroom)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.MeetUrl))
                                        {
                                            <a href="@item.MeetUrl" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200 w-fit">
                                                🎥 Google Meet
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-right">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="rs-filter-btn-secondary px-2.5 text-xs" style="height: 1.85rem;" title="Sửa lịch">
                                            Sửa
                                        </a>
                                        @if (string.IsNullOrWhiteSpace(item.MeetUrl))
                                        {
                                            <form asp-action="GenerateMeet" asp-route-id="@item.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rs-filter-btn-secondary px-2.5 text-xs text-emerald-700 hover:text-emerald-800" style="height: 1.85rem;" title="Tạo Google Meet">
                                                    Tạo Meet
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lịch này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="rs-filter-btn-secondary px-2.5 text-xs text-rose-600 hover:text-rose-700" style="height: 1.85rem;" title="Xóa lịch">
                                                Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="px-4 py-3 border-t border-slate-200 bg-white flex items-center justify-between text-xs">
                <span class="text-slate-500">
                    Trang <strong class="text-slate-800">@filter.Page</strong> / @Model.TotalPages
                </span>
                <div class="inline-flex gap-1">
                    @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a asp-action="Index"
                           asp-route-Keyword="@filter.Keyword"
                           asp-route-TeacherId="@filter.TeacherId"
                           asp-route-FromDate='@(filter.FromDate?.ToString("yyyy-MM-dd"))'
                           asp-route-ToDate='@(filter.ToDate?.ToString("yyyy-MM-dd"))'
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDirection="@filter.SortDirection"
                           asp-route-Page="@pageNumber"
                           class="px-2.5 py-1 rounded-md border text-xs font-semibold transition-colors @(filter.Page == pageNumber ? "bg-slate-800 text-white border-slate-800" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                            @pageNumber
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

