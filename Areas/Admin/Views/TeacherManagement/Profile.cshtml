@model TeacherProfileAdminViewModel
@{
    ViewData["Title"] = "Hồ sơ giáo viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <a asp-action="Index" class="text-sm font-semibold text-blue-600">Quay lại</a>
    <div class="bg-white border border-slate-200 rounded-xl p-6">
        <h1 class="text-2xl font-bold text-slate-900">@Model.FullName</h1>
        <p class="text-sm text-slate-500">@Model.Email | @Model.Phone | @Model.Status</p>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 text-sm">
            <div><dt class="font-semibold text-slate-500">Giới tính</dt><dd>@Model.Gender</dd></div>
            <div><dt class="font-semibold text-slate-500">Quốc gia</dt><dd>@Model.Country</dd></div>
            <div><dt class="font-semibold text-slate-500">Ngày sinh</dt><dd>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa có")</dd></div>
            <div><dt class="font-semibold text-slate-500">Bio</dt><dd>@Model.Bio</dd></div>
        </dl>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-6">
        <h2 class="font-bold text-slate-900">Topic đang phụ trách</h2>
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var topic in Model.AssignedTopics)
            {
                <span class="rounded-full bg-blue-50 text-blue-700 px-3 py-1 text-sm font-semibold">@topic</span>
            }
        </div>
    </div>
</div>
