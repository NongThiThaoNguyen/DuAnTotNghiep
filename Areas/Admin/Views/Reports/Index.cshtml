@model AdminReportsIndexViewModel
@{
    ViewData["Title"] = "Báo cáo & Thống kê Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var chartLabels = System.Text.Json.JsonSerializer.Serialize(Model.QuizAttemptsOverTime.Select(p => p.Label));
    var quizValues = System.Text.Json.JsonSerializer.Serialize(Model.QuizAttemptsOverTime.Select(p => p.Value));
    var attendanceValues = System.Text.Json.JsonSerializer.Serialize(Model.AttendanceOverTime.Select(p => p.Value));
    var studentValues = System.Text.Json.JsonSerializer.Serialize(Model.NewStudentsOverTime.Select(p => p.Value));
}

<div class="space-y-6">
    <!-- Top Header & Export Buttons -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Báo cáo & Thống kê Admin</h1>
            <p class="text-sm text-slate-500 mt-1">Tổng quan chỉ số hoạt động, hiệu suất học tập và thống kê hệ thống thực tế.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <!-- Export Excel Options Dropdown -->
            <details class="relative inline-block text-left" id="exportDetails">
                <summary class="inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-xl transition-colors cursor-pointer select-none shadow-xs list-none">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 01-2-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    Xuất Báo cáo Excel
                    <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </summary>
                <div class="origin-top-right absolute right-0 mt-2 w-56 rounded-xl shadow-lg bg-white ring-1 ring-black/5 border border-slate-200 divide-y divide-slate-100 z-50">
                    <div class="py-1">
                        <a asp-controller="Export" asp-action="ExportStudentReport" onclick="document.getElementById('exportDetails').removeAttribute('open')" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-700 font-medium">Báo cáo Học viên (.xlsx)</a>
                        <a asp-controller="Export" asp-action="ExportTeacherReport" onclick="document.getElementById('exportDetails').removeAttribute('open')" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-700 font-medium">Báo cáo Giáo viên (.xlsx)</a>
                        <a asp-controller="Export" asp-action="ExportAttendanceReport" onclick="document.getElementById('exportDetails').removeAttribute('open')" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-700 font-medium">Báo cáo Điểm danh (.xlsx)</a>
                        <a asp-controller="Export" asp-action="ExportUsers" onclick="document.getElementById('exportDetails').removeAttribute('open')" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-700 font-medium">Danh sách Người dùng (.xlsx)</a>
                    </div>
                </div>
            </details>

            <!-- Print / Export PDF -->
            <button onclick="window.print()" type="button" class="inline-flex items-center px-4 py-2.5 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-sm rounded-xl transition-colors shadow-xs">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                In / Xuất PDF
            </button>
        </div>
    </div>

    <!-- Time Filter Bar -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-slate-700 mr-1">Bộ lọc thời gian:</span>
                <a asp-action="Index" asp-route-period="7days" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors @(Model.Period == "7days" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                    7 ngày gần nhất
                </a>
                <a asp-action="Index" asp-route-period="30days" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors @(Model.Period == "30days" || string.IsNullOrEmpty(Model.Period) ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                    30 ngày gần nhất
                </a>
            </div>

            <!-- Custom date range option -->
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <input type="hidden" name="period" value="custom" />
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-hidden focus:ring-2 focus:ring-blue-500" />
                <span class="text-slate-400 text-xs">-</span>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-hidden focus:ring-2 focus:ring-blue-500" />
                <button type="submit" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg transition-colors">
                    Áp dụng
                </button>
            </div>
        </form>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a asp-action="StudentProgress" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Học viên</span>
                <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path></svg>
                </span>
            </div>
            <div class="text-3xl font-bold text-slate-900 mt-2">@Model.StudentCount</div>
            <p class="text-xs text-slate-400 mt-1">Xem tiến độ học tập →</p>
        </a>

        <a asp-action="TeacherActivity" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-emerald-300 hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Giáo viên</span>
                <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                </span>
            </div>
            <div class="text-3xl font-bold text-slate-900 mt-2">@Model.TeacherCount</div>
            <p class="text-xs text-slate-400 mt-1">Xem hiệu suất giảng dạy →</p>
        </a>

        <a asp-action="AttendanceSummary" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-purple-300 hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Lượt điểm danh</span>
                <span class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                </span>
            </div>
            <div class="text-3xl font-bold text-slate-900 mt-2">@Model.AttendanceCount</div>
            <p class="text-xs text-slate-400 mt-1">Trong khoảng thời gian đã lọc →</p>
        </a>

        <a asp-action="QuizPerformance" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-amber-300 hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Quiz Attempts</span>
                <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </span>
            </div>
            <div class="text-3xl font-bold text-slate-900 mt-2">@Model.QuizAttemptCount</div>
            <p class="text-xs text-slate-400 mt-1">Trong khoảng thời gian đã lọc →</p>
        </a>
    </div>

    <!-- Chart & Course Completion Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Line Chart -->
        <div class="lg:col-span-2 bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="font-bold text-slate-900 text-lg">Biểu đồ thống kê theo thời gian</h2>
                <div class="flex items-center gap-4 text-xs font-semibold">
                    <span class="inline-flex items-center text-blue-600"><span class="w-2.5 h-2.5 rounded-full bg-blue-600 mr-1.5"></span>Quiz Attempts</span>
                    <span class="inline-flex items-center text-purple-600"><span class="w-2.5 h-2.5 rounded-full bg-purple-600 mr-1.5"></span>Điểm danh</span>
                    <span class="inline-flex items-center text-emerald-600"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600 mr-1.5"></span>Học viên mới</span>
                </div>
            </div>
            <div class="h-72 w-full">
                <canvas id="overviewChart"></canvas>
            </div>
        </div>

        <!-- Course Completion Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between space-y-6">
            <div>
                <h2 class="font-bold text-slate-900 text-lg mb-1">Tỷ lệ hoàn thành khóa học</h2>
                <p class="text-xs text-slate-500">Thống kê tiến độ hoàn thành các Lộ trình học tập (Student Learning Paths) trên hệ thống.</p>
            </div>

            <div class="space-y-4">
                <div class="text-center py-4">
                    <div class="text-5xl font-extrabold text-blue-600">@Model.CourseCompletionRate%</div>
                    <div class="text-xs font-medium text-slate-500 mt-2">Tỷ lệ hoàn thành trung bình</div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
                    <div class="bg-blue-600 h-3 rounded-full transition-all duration-500" style="width: @Model.CourseCompletionRate%"></div>
                </div>

                <div class="grid grid-cols-2 gap-3 text-center pt-2">
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <div class="text-xs text-slate-500">Tổng lộ trình</div>
                        <div class="text-lg font-bold text-slate-900">@Model.TotalLearningPaths</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <div class="text-xs text-slate-500">Đã hoàn thành</div>
                        <div class="text-lg font-bold text-emerald-600">@Model.CompletedLearningPaths</div>
                    </div>
                </div>
            </div>

            <a asp-action="StudentProgress" class="block w-full py-2 text-center text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
                Xem chi tiết danh sách tiến độ →
            </a>
        </div>
    </div>

    <!-- Tables Grid: Top 5 Students & Teacher Performance -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Top 5 Students -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="font-bold text-slate-900 text-base">Top 5 học viên theo điểm trung bình Quiz</h2>
                <a asp-action="QuizPerformance" class="text-xs font-semibold text-blue-600 hover:text-blue-700">Xem tất cả</a>
            </div>

            @if (Model.TopStudents == null || !Model.TopStudents.Any())
            {
                <div class="p-6 text-center text-slate-500 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                    Chưa có kết quả làm Quiz của học viên nào.
                </div>
            }
            else
            {
                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="min-w-full divide-y divide-slate-200 text-xs">
                        <thead class="bg-slate-50 text-left font-semibold uppercase text-slate-500">
                            <tr>
                                <th class="px-3.5 py-3">Học viên</th>
                                <th class="px-3.5 py-3 text-center">Số lượt Quiz</th>
                                <th class="px-3.5 py-3 text-right">Điểm trung bình</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            @foreach (var student in Model.TopStudents)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="px-3.5 py-3">
                                        <div class="font-semibold text-slate-900">@student.StudentName</div>
                                        <div class="text-slate-400 text-[11px]">@student.Email</div>
                                    </td>
                                    <td class="px-3.5 py-3 text-center font-medium text-slate-700">@student.AttemptCount</td>
                                    <td class="px-3.5 py-3 text-right font-bold text-emerald-600">@student.AverageScore.ToString("0.##") / 10</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Teacher Performance Summary -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="font-bold text-slate-900 text-base">Thống kê hiệu suất Giáo viên</h2>
                <a asp-action="TeacherActivity" class="text-xs font-semibold text-blue-600 hover:text-blue-700">Xem tất cả</a>
            </div>

            @if (Model.TeacherPerformances == null || !Model.TeacherPerformances.Any())
            {
                <div class="p-6 text-center text-slate-500 bg-slate-50 rounded-xl border border-slate-100 text-xs">
                    Chưa có dữ liệu giáo viên.
                </div>
            }
            else
            {
                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="min-w-full divide-y divide-slate-200 text-xs">
                        <thead class="bg-slate-50 text-left font-semibold uppercase text-slate-500">
                            <tr>
                                <th class="px-3.5 py-3">Giáo viên</th>
                                <th class="px-3.5 py-3 text-center">Topic</th>
                                <th class="px-3.5 py-3 text-center">Quiz</th>
                                <th class="px-3.5 py-3 text-center">Bài tập</th>
                                <th class="px-3.5 py-3 text-center">Đã chấm</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            @foreach (var teacher in Model.TeacherPerformances)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="px-3.5 py-3 font-semibold text-slate-900">@teacher.TeacherName</td>
                                    <td class="px-3.5 py-3 text-center font-medium text-slate-700">@teacher.TopicCount</td>
                                    <td class="px-3.5 py-3 text-center font-medium text-slate-700">@teacher.QuizCount</td>
                                    <td class="px-3.5 py-3 text-center font-medium text-slate-700">@teacher.AssignmentCount</td>
                                    <td class="px-3.5 py-3 text-center font-bold text-emerald-600">@teacher.GradedSubmissionCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById('overviewChart').getContext('2d');
        var chartLabels = @Html.Raw(chartLabels);
        var quizValues = @Html.Raw(quizValues);
        var attendanceValues = @Html.Raw(attendanceValues);
        var studentValues = @Html.Raw(studentValues);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Quiz Attempts',
                        data: quizValues,
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.1)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Điểm danh',
                        data: attendanceValues,
                        borderColor: '#9333ea',
                        backgroundColor: 'rgba(147, 51, 234, 0.1)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Học viên mới',
                        data: studentValues,
                        borderColor: '#059669',
                        backgroundColor: 'rgba(5, 150, 105, 0.1)',
                        tension: 0.3,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        document.addEventListener('click', function (e) {
            var details = document.getElementById('exportDetails');
            if (details && !details.contains(e.target)) {
                details.removeAttribute('open');
            }
        });
    });
</script>
