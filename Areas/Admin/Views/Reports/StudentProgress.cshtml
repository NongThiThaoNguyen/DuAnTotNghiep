@model StudentProgressReportViewModel
@{
    ViewData["Title"] = "Báo cáo tiến độ học viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div class="flex justify-between items-center"><h1 class="text-2xl font-bold text-slate-900">Báo cáo tiến độ học viên</h1><a asp-controller="Export" asp-action="ExportStudentReport" class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-semibold">Xuất Excel</a></div>
    <div class="overflow-hidden bg-white border border-slate-200 rounded-xl">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500"><tr><th class="px-4 py-3">Học viên</th><th class="px-4 py-3">Trình độ</th><th class="px-4 py-3">Lộ trình</th><th class="px-4 py-3">Hoàn thành</th><th class="px-4 py-3">Tiến độ TB</th></tr></thead>
            <tbody class="divide-y divide-slate-100">@foreach (var item in Model.Items){<tr><td class="px-4 py-3"><div class="font-semibold">@item.StudentName</div><div class="text-xs text-slate-500">@item.Email</div></td><td class="px-4 py-3">@item.LevelName</td><td class="px-4 py-3">@item.LearningPathCount</td><td class="px-4 py-3">@item.CompletedPathCount</td><td class="px-4 py-3">@item.AverageProgress.ToString("0.##")%</td></tr>}</tbody>
        </table>
    </div>
</div>
