@model TeacherAssignmentCreateViewModel
@{
    ViewData["Title"] = "Tạo phân công";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-3xl space-y-6">
    <a asp-action="Index" class="text-sm font-semibold text-blue-600">Quay lại</a>
    <h1 class="text-2xl font-bold text-slate-900">Tạo phân công giáo viên</h1>
    <form asp-action="Assign" method="post" class="bg-white border border-slate-200 rounded-xl p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="text-sm font-semibold">Giáo viên</label>
            <select asp-for="TeacherId" class="mt-1 w-full rounded-lg border-slate-300">
                @foreach (var teacher in Model.Teachers)
                {
                    <option value="@teacher.Id">@teacher.Text</option>
                }
            </select>
        </div>
        <div>
            <label class="text-sm font-semibold">Topic</label>
            <select asp-for="TopicId" class="mt-1 w-full rounded-lg border-slate-300">
                @foreach (var topic in Model.Topics)
                {
                    <option value="@topic.Id">@topic.Text</option>
                }
            </select>
        </div>
        <div class="md:col-span-2"><label class="text-sm font-semibold">Tiêu đề</label><input asp-for="Title" class="mt-1 w-full rounded-lg border-slate-300" /></div>
        <div><label class="text-sm font-semibold">Bắt đầu</label><input asp-for="StartTime" type="datetime-local" class="mt-1 w-full rounded-lg border-slate-300" /></div>
        <div><label class="text-sm font-semibold">Kết thúc</label><input asp-for="EndTime" type="datetime-local" class="mt-1 w-full rounded-lg border-slate-300" /></div>
        <div class="md:col-span-2"><label class="text-sm font-semibold">Lớp học</label><input asp-for="Classroom" class="mt-1 w-full rounded-lg border-slate-300" /></div>
        <button class="md:col-span-2 rounded-lg bg-blue-600 px-4 py-2 text-white font-semibold">Lưu phân công</button>
    </form>
</div>
