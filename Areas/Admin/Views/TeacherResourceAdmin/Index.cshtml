@model TeacherResourceAdminIndexViewModel
@{
    ViewData["Title"] = "Tài liệu giáo viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <h1 class="text-2xl font-bold text-slate-900">Tài liệu giáo viên</h1>
    <form method="get" class="flex gap-3 bg-white border border-slate-200 rounded-xl p-4">
        <select name="teacherId" class="rounded-lg border-slate-300 text-sm">
            <option value="">Tất cả giáo viên</option>
            @foreach (var teacher in Model.Teachers)
            {
                <option value="@teacher.Id">@teacher.Text</option>
            }
        </select>
        <button class="rounded-lg bg-blue-600 px-4 text-white text-sm font-semibold">Lọc</button>
    </form>
    <div class="overflow-hidden bg-white border border-slate-200 rounded-xl">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500"><tr><th class="px-4 py-3">Tài liệu</th><th class="px-4 py-3">Giáo viên</th><th class="px-4 py-3">Loại</th><th class="px-4 py-3">Trạng thái</th><th></th></tr></thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="px-4 py-3"><div class="font-semibold">@item.SourceName</div><a href="@item.SourceUrl" target="_blank" class="text-xs text-blue-600">@item.SourceUrl</a></td>
                        <td class="px-4 py-3">@item.CreatedByName</td>
                        <td class="px-4 py-3">@item.SourceType</td>
                        <td class="px-4 py-3">@item.Status</td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <form asp-action="Approve" method="post"><input type="hidden" name="resourceId" value="@item.ResourceId" /><button class="text-emerald-600 font-semibold">Duyệt</button></form>
                                <form asp-action="Reject" method="post"><input type="hidden" name="resourceId" value="@item.ResourceId" /><button class="text-amber-600 font-semibold">Từ chối</button></form>
                                <form asp-action="Delete" method="post"><input type="hidden" name="resourceId" value="@item.ResourceId" /><button class="text-red-600 font-semibold">Xóa</button></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
