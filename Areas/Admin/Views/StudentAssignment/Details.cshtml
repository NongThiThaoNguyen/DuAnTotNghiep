@model StudentAssignmentDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết submission";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div>
        <a asp-action="Index" class="text-sm font-semibold text-blue-600">Quay lại</a>
        <h1 class="text-2xl font-bold text-slate-900">@Model.TaskTitle</h1>
        <p class="text-sm text-slate-500">@Model.StudentName | @Model.TopicTitle | @Model.Status | Điểm: @(Model.Score?.ToString("0.##") ?? "N/A")</p>
    </div>
    <section class="bg-white border border-slate-200 rounded-xl p-5 space-y-4">
        <div>
            <h2 class="font-semibold text-slate-900">Yêu cầu</h2>
            <p class="text-sm text-slate-600 whitespace-pre-line">@Model.TaskInstruction</p>
        </div>
        <div>
            <h2 class="font-semibold text-slate-900">Bài nộp</h2>
            <p class="text-sm text-slate-600 whitespace-pre-line">@(Model.SubmissionText ?? "Không có nội dung text")</p>
        </div>
        @if (!string.IsNullOrEmpty(Model.FileUrl))
        {
            <a href="@Model.FileUrl" target="_blank" class="text-sm font-semibold text-blue-600">File đính kèm</a>
        }
        @if (!string.IsNullOrEmpty(Model.AudioUrl))
        {
            <a href="@Model.AudioUrl" target="_blank" class="text-sm font-semibold text-blue-600 block">Audio đính kèm</a>
        }
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-lg bg-slate-50 p-4"><div class="font-semibold">AI feedback</div><p class="text-sm">@Model.AiFeedback</p></div>
            <div class="rounded-lg bg-slate-50 p-4"><div class="font-semibold">Teacher feedback</div><p class="text-sm">@Model.TeacherFeedback</p></div>
        </div>
    </section>
</div>
