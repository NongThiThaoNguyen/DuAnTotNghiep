@model StudentQuizDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết quiz attempt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div>
        <a asp-action="Index" class="text-sm font-semibold text-blue-600">Quay lại</a>
        <h1 class="text-2xl font-bold text-slate-900">@Model.QuizTitle</h1>
        <p class="text-sm text-slate-500">@Model.StudentName | @Model.Status | Điểm: @(Model.Score?.ToString("0.##") ?? "N/A")</p>
    </div>
    <div class="space-y-3">
        @foreach (var answer in Model.Answers)
        {
            <div class="bg-white border border-slate-200 rounded-xl p-4">
                <div class="font-semibold text-slate-900">@answer.QuestionText</div>
                <div class="mt-2 text-sm text-slate-600">Đáp án: @(answer.SelectedOptionText ?? answer.AnswerText ?? "Chưa trả lời")</div>
                <div class="mt-1 text-sm">Kết quả: @(answer.IsCorrect == true ? "Đúng" : answer.IsCorrect == false ? "Sai" : "Chưa chấm") | Điểm: @(answer.Score?.ToString("0.##") ?? "N/A")</div>
                @if (!string.IsNullOrWhiteSpace(answer.AiExplanation))
                {
                    <p class="mt-2 text-sm text-slate-500">@answer.AiExplanation</p>
                }
            </div>
        }
    </div>
</div>
