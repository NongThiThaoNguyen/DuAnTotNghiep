@model List<TeacherStudentChatRowViewModel>
@{
    ViewData["Title"] = "Chat giáo viên - học viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-chat-monitor" data-history-url="@Url.Action("History", "ChatMonitor", new { area = "Admin" })">
    <div class="flex items-center justify-between gap-4 mb-5"><div><a asp-action="Index" class="text-sm font-semibold text-indigo-600">Quay lại tổng quan</a><h1 class="text-2xl font-bold text-slate-900 mt-2">Giám sát chat giáo viên - học sinh</h1><p class="text-sm text-slate-500 mt-1">Chỉ xem dữ liệu trao đổi đã được lưu trong hệ thống.</p></div></div>
    <form method="get" class="chat-monitor-filters">
        <input name="search" value="@ViewBag.Search" placeholder="Tìm giáo viên, học sinh hoặc tin nhắn cuối..." />
        <select name="teacherId"><option value="">Tất cả giáo viên</option>@foreach (var teacher in ViewBag.Teachers){<option value="@teacher.Id" selected="@(ViewBag.TeacherId == teacher.Id ? "selected" : null)">@teacher.FullName</option>}</select>
        <select name="classroomId"><option value="">Tất cả lớp</option>@foreach (var classroom in ViewBag.Classrooms){<option value="@classroom.Id" selected="@(ViewBag.ClassroomId == classroom.Id ? "selected" : null)">@classroom.ClassName</option>}</select>
        <select name="status"><option value="">Mọi trạng thái</option><option value="UNREAD" selected="@(ViewBag.Status == "UNREAD" ? "selected" : null)">Có tin chưa đọc</option><option value="READ" selected="@(ViewBag.Status == "READ" ? "selected" : null)">Đã đọc</option></select>
        <input name="from" value="@ViewBag.From" type="date" /><input name="to" value="@ViewBag.To" type="date" /><button type="submit">Lọc</button><a asp-action="TeacherChats">Xóa lọc</a>
    </form>
    <div class="chat-monitor-table-wrap"><table class="chat-monitor-table"><thead><tr><th>Giáo viên</th><th>Học sinh</th><th>Lớp</th><th>Tin nhắn cuối</th><th>Thời gian</th><th>Số tin</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @foreach (var item in Model){<tr><td><strong>@item.TeacherName</strong></td><td>@item.StudentName</td><td>@item.ClassNames</td><td class="last-message">@item.LastMessageText</td><td>@item.LastMessageAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.MessageCount</td><td><span class="chat-status @(item.UnreadCount > 0 ? "unread" : "read")">@item.Status</span></td><td><button type="button" class="chat-view-button" data-teacher-id="@item.TeacherId" data-student-id="@item.StudentId" data-teacher="@item.TeacherName" data-student="@item.StudentName">Xem</button></td></tr>}
    @if (!Model.Any()){<tr><td colspan="8" class="empty-chat">Chưa có cuộc trò chuyện phù hợp.</td></tr>}</tbody></table></div>
</div>
<div id="chatHistoryDrawer" class="chat-history-drawer" aria-hidden="true"><div class="chat-drawer-panel"><div class="chat-drawer-header"><div><h2 id="chatDrawerTitle">Lịch sử chat</h2><p id="chatDrawerSubtitle"></p></div><button type="button" id="chatDrawerClose" aria-label="Đóng">&times;</button></div><input id="chatMessageSearch" class="chat-message-search" placeholder="Tìm trong tin nhắn..." /><div id="chatHistoryList" class="chat-history-list"></div></div></div>
<style>
.admin-chat-monitor{max-width:1200px}.chat-monitor-filters{display:grid;grid-template-columns:2fr 1fr .7fr 1fr 1fr 1fr auto auto;gap:8px;padding:14px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:16px}.chat-monitor-filters input,.chat-monitor-filters select{min-width:0;border:1px solid #cbd5e1;border-radius:8px;padding:9px;font-size:12px}.chat-monitor-filters button,.chat-monitor-filters a,.chat-view-button{border:0;border-radius:8px;padding:9px 12px;background:#4f46e5;color:#fff;font-size:12px;font-weight:700;text-decoration:none;cursor:pointer}.chat-monitor-filters a{background:#f1f5f9;color:#475569}.chat-monitor-table-wrap{overflow:auto;background:#fff;border:1px solid #e2e8f0;border-radius:12px}.chat-monitor-table{width:100%;border-collapse:collapse;font-size:13px}.chat-monitor-table th{background:#f8fafc;color:#64748b;text-align:left;font-size:11px;text-transform:uppercase;padding:12px}.chat-monitor-table td{padding:13px 12px;border-top:1px solid #f1f5f9;color:#334155}.last-message{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-status{padding:4px 8px;border-radius:999px;font-size:11px;font-weight:700}.chat-status.unread{background:#fff7ed;color:#c2410c}.chat-status.read{background:#ecfdf5;color:#047857}.empty-chat{text-align:center;padding:30px!important}.chat-history-drawer{position:fixed;inset:0;z-index:1000;background:rgba(15,23,42,.45);opacity:0;visibility:hidden;transition:.2s}.chat-history-drawer.is-open{opacity:1;visibility:visible}.chat-drawer-panel{margin-left:auto;width:min(520px,100%);height:100%;background:#fff;display:flex;flex-direction:column;box-shadow:-12px 0 30px #0f172a22}.chat-drawer-header{display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid #e2e8f0}.chat-drawer-header h2{margin:0;font-size:18px;color:#0f172a}.chat-drawer-header p{margin:5px 0 0;color:#64748b;font-size:12px}.chat-drawer-header button{border:0;background:transparent;font-size:28px;color:#64748b;cursor:pointer}.chat-message-search{margin:14px;border:1px solid #cbd5e1;border-radius:8px;padding:10px}.chat-history-list{padding:0 14px 20px;overflow:auto}.chat-history-message{margin:10px 0;padding:10px 12px;border-radius:10px;background:#f8fafc;border-left:3px solid #94a3b8}.chat-history-message.teacher{border-left-color:#4f46e5}.chat-history-message.student{border-left-color:#10b981}.chat-history-message strong{font-size:12px;color:#334155}.chat-history-message time{float:right;color:#94a3b8;font-size:10px}.chat-history-message p{margin:6px 0 0;color:#0f172a;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}@@media(max-width:800px){.chat-monitor-filters{grid-template-columns:1fr 1fr}.chat-monitor-filters input:first-child{grid-column:1/-1}.chat-monitor-table{min-width:900px}}
</style>
<script>
@@media(max-width:800px){.chat-monitor-filters{grid-template-columns:1fr 1fr}.chat-monitor-filters input:first-child{grid-column:1/-1}.chat-monitor-table{min-width:900px}}
function render(){const q=search.value.trim().toLowerCase();list.innerHTML='';messages.filter(m=>!q||m.messageText.toLowerCase().includes(q)).forEach(m=>{const el=document.createElement('article');el.className='chat-history-message '+(m.senderRole==='TEACHER'?'teacher':'student');el.innerHTML='<strong></strong><time></time><p></p>';el.querySelector('strong').textContent=m.senderName+' · '+(m.senderRole==='TEACHER'?'Giáo viên':'Học sinh');el.querySelector('time').textContent=new Date(m.createdAt).toLocaleString('vi-VN');el.querySelector('p').textContent=m.messageText;list.appendChild(el)});if(!list.children.length)list.innerHTML='<p class="empty-chat">Không có tin nhắn phù hợp.</p>'}
document.querySelectorAll('.chat-view-button').forEach(btn=>btn.addEventListener('click',async()=>{document.getElementById('chatDrawerTitle').textContent='Lịch sử chat';document.getElementById('chatDrawerSubtitle').textContent=btn.dataset.teacher+' ↔ '+btn.dataset.student;drawer.classList.add('is-open');drawer.setAttribute('aria-hidden','false');list.innerHTML='<p class="empty-chat">Đang tải...</p>';messages=await fetch(root.dataset.historyUrl+'?teacherId='+btn.dataset.teacherId+'&studentId='+btn.dataset.studentId).then(r=>r.json());render()}));document.getElementById('chatDrawerClose').onclick=()=>{drawer.classList.remove('is-open');drawer.setAttribute('aria-hidden','true')};drawer.addEventListener('click',e=>{if(e.target===drawer)document.getElementById('chatDrawerClose').click()});search.addEventListener('input',render)})();
</script>
