@model DuAnTotNghiep.Areas.Admin.ViewModels.AdminCourseDetailViewModel
@{
    ViewData["Title"] = "Chi tiết khóa học - " + Model.Title;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string DifficultyLabel(string? d) => (d ?? "").ToUpperInvariant() switch
    {
        "BEGINNER" => "Cơ bản",
        "BASIC"    => "Cơ bản",
        "ELEMENTARY" => "Sơ cấp",
        "INTERMEDIATE" => "Trung cấp",
        "UPPER_INTERMEDIATE" => "Trên trung cấp",
        "ADVANCED" => "Nâng cao",
        _ => d ?? "-"
    };

    string StatusLabel(string? s) => (s ?? "").ToUpperInvariant() switch
    {
        "ACTIVE"   => "Đang hoạt động",
        "INACTIVE" => "Tạm dừng",
        "ARCHIVED" => "Lưu trữ",
        _ => s ?? "-"
    };

    string StatusBadgeClass(string? s) => (s ?? "").ToUpperInvariant() switch
    {
        "ACTIVE"   => "bg-success",
        "INACTIVE" => "bg-warning",
        _ => "bg-secondary"
    };
}

<div class="container-fluid">
    <div class="d-flex align-items-center gap-2 mt-4 mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <h2 class="mb-0">@Model.Title</h2>
        <span class="badge @StatusBadgeClass(Model.Status)">@StatusLabel(Model.Status)</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <!-- Course Info -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header"><strong>Thông tin khóa học</strong></div>
                <div class="card-body">
                    <table class="table table-borderless mb-0 small">
                        <tbody>
                            <tr>
                                <td class="text-muted fw-semibold" style="width:40%">Mã khóa học</td>
                                <td>@(Model.TopicCode ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Kỹ năng</td>
                                <td>@Model.SkillName</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Trình độ</td>
                                <td>@(Model.LevelName ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Độ khó</td>
                                <td>@DifficultyLabel(Model.DifficultyLevel)</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Thời gian ước tính</td>
                                <td>@(Model.EstimatedMinutes.HasValue ? Model.EstimatedMinutes + " phút" : "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Người tạo</td>
                                <td>@(Model.CreatedByName ?? "Hệ thống")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-semibold">Ngày tạo</td>
                                <td>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Stats cards -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div class="card text-center p-3">
                        <div class="fw-bold" style="font-size:1.5rem;color:#2563eb">@Model.Lessons.Count</div>
                        <div class="small text-muted">Bài học</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center p-3">
                        <div class="fw-bold" style="font-size:1.5rem;color:#16a34a">@Model.StudentCount</div>
                        <div class="small text-muted">Học viên</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center p-3">
                        <div class="fw-bold" style="font-size:1.5rem;color:#d97706">@Model.Quizzes.Count</div>
                        <div class="small text-muted">Bài kiểm tra</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm flex-fill">
                    <svg class="w-4 h-4 me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Chỉnh sửa
                </a>
                <a asp-area="Admin" asp-controller="LearningTopics" asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary btn-sm flex-fill">
                    Xem topic
                </a>
            </div>
        </div>

        <div class="col-md-8">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="card mb-3">
                    <div class="card-header"><strong>Mô tả</strong></div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Description</p>
                    </div>
                </div>
            }

            <!-- Lessons -->
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <strong>Danh sách bài học (@Model.Lessons.Count)</strong>
                </div>
                <div class="card-body p-0">
                    @if (Model.Lessons.Any())
                    {
                        <table class="table table-borderless mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:3rem">#</th>
                                    <th>Tên bài học</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lesson in Model.Lessons)
                                {
                                    <tr>
                                        <td class="text-muted">@lesson.OrderIndex</td>
                                        <td>@lesson.Title</td>
                                        <td>@(lesson.EstimatedMinutes.HasValue ? lesson.EstimatedMinutes + " phút" : "-")</td>
                                        <td>
                                            @{
                                                var lStatus = (lesson.Status ?? "").ToUpperInvariant();
                                                var lBadge  = lStatus == "APPROVED" ? "bg-success"
                                                            : lStatus == "PENDING"  ? "bg-warning"
                                                            : "bg-secondary";
                                            }
                                            <span class="badge @lBadge" style="font-size:0.7rem">@lesson.Status</span>
                                        </td>
                                        <td>
                                            <a href="/Lesson/Detail/@lesson.Id" target="_blank"
                                               class="btn btn-outline-primary btn-sm" style="font-size:0.7rem">Xem</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3 small">Chưa có bài học nào</div>
                    }
                </div>
            </div>

            <!-- Quizzes -->
            <div class="card">
                <div class="card-header"><strong>Bài kiểm tra (@Model.Quizzes.Count)</strong></div>
                <div class="card-body p-0">
                    @if (Model.Quizzes.Any())
                    {
                        <table class="table table-borderless mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên bài kiểm tra</th>
                                    <th>Số câu hỏi</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quiz in Model.Quizzes)
                                {
                                    <tr>
                                        <td>@quiz.Title</td>
                                        <td>@quiz.QuestionCount</td>
                                        <td><span class="badge bg-info" style="font-size:0.7rem">@quiz.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3 small">Chưa có bài kiểm tra nào</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
