@model DuAnTotNghiep.Models.ViewModels.Onboarding.OnboardingStep2ViewModel
@{
    ViewData["Title"] = "Đánh giá trình độ";
    var isScoreBased = ViewBag.GoalCode == "IELTS" || ViewBag.GoalCode == "TOEIC";
}

@section Styles {
    <style>
        .level-card-body {
            border: 2px solid #e2e8f0;
            transition: all 0.2s ease;
        }
        .level-card-body:hover {
            border-color: #93c5fd;
        }
        .level-radio:checked + .level-card-body {
            border-color: #2563eb !important;
            background-color: rgba(239, 246, 255, 0.6) !important;
            box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.15) !important;
        }
        .level-radio:checked + .level-card-body .level-badge {
            background-color: #2563eb !important;
            color: #ffffff !important;
        }
    </style>
}

<div class="max-w-5xl mx-auto py-3 px-4">
    <partial name="_OnboardingStepper" model="2" />
    <div class="bg-white shadow-xl shadow-slate-200/50 rounded-2xl p-5 sm:p-7 border border-slate-200/80 mt-2">
        
        <form method="post" asp-action="Level">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="GoalCode" />
            
            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-3 text-sm font-medium"></div>

            <!-- SECTION 1: Current Level -->
            <h3 class="text-xl font-bold mb-1 text-slate-800">Trình độ hiện tại của bạn?</h3>
            <p class="text-slate-500 text-xs mb-4">Self-assessment giúp AI hiểu rõ vạch xuất phát của bạn. Hãy chọn trình độ bạn cảm thấy phù hợp nhất.</p>

            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 mb-5">
                <label class="cursor-pointer block relative">
                    <input type="radio" asp-for="CurrentLevelId" value="" class="hidden level-radio" checked="@(Model.CurrentLevelId == null)" />
                    <div class="level-card-body h-full rounded-xl p-2.5 bg-white flex items-center">
                        <div class="level-badge flex-shrink-0 w-9 h-9 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center font-bold text-sm mr-2.5 transition-colors">
                            ?
                        </div>
                        <div class="min-w-0">
                            <h6 class="font-bold text-slate-800 text-xs sm:text-sm mb-0.5 truncate">Không chắc chắn</h6>
                            <p class="text-slate-500 text-[11px] truncate">Chưa đánh giá</p>
                        </div>
                    </div>
                </label>

                @if (ViewBag.Levels != null)
                {
                    foreach (var level in ViewBag.Levels)
                    {
                        <label class="cursor-pointer block relative">
                            <input type="radio" asp-for="CurrentLevelId" value="@level.Id" class="hidden level-radio" />
                            <div class="level-card-body h-full rounded-xl p-2.5 bg-white flex items-center">
                                <div class="level-badge flex-shrink-0 min-w-[2.5rem] h-9 px-1.5 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center font-bold text-[10px] sm:text-xs mr-2.5 transition-colors text-center overflow-hidden">
                                    @level.Code
                                </div>
                                <div class="min-w-0">
                                    <h6 class="font-bold text-slate-800 text-xs sm:text-sm mb-0.5 truncate">@level.Name</h6>
                                    <p class="text-slate-500 text-[11px] truncate" title="@level.Description">@level.Description</p>
                                </div>
                            </div>
                        </label>
                    }
                }
            </div>

            <hr class="border-slate-200 my-4" />

            <!-- SECTION 2: Target -->
            <h3 class="text-lg font-bold mb-1 text-slate-800">Mục tiêu mong muốn</h3>
            <p class="text-slate-500 text-xs mb-3">Bạn muốn đạt được thành tích nào trong tương lai?</p>

            @if (isScoreBased)
            {
                <div class="mb-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <label asp-for="TargetScore" class="block font-bold text-slate-700 text-sm mb-1.5">Điểm số @ViewBag.GoalCode mục tiêu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                            </svg>
                        </div>
                        <input asp-for="TargetScore" class="block w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 text-sm transition-colors" type="number" step="0.5" placeholder="Ví dụ: @(ViewBag.GoalCode == "IELTS" ? "6.5" : "800")" />
                    </div>
                    <span asp-validation-for="TargetScore" class="text-red-500 text-xs mt-1 block font-medium"></span>
                    <p class="text-slate-500 text-xs mt-1.5">Nhập điểm số mục tiêu bạn muốn đạt được để AI thiết kế lộ trình phù hợp.</p>
                </div>
            }
            else
            {
                <div class="mb-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <label asp-for="TargetLevelId" class="block font-bold text-slate-700 text-sm mb-1.5">Trình độ mục tiêu</label>
                    <select asp-for="TargetLevelId" class="block w-full py-2.5 px-3 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 text-sm bg-white transition-colors">
                        <option value="">-- Chọn trình độ mong muốn --</option>
                        @if (ViewBag.Levels != null)
                        {
                            foreach (var level in ViewBag.Levels)
                            {
                                <option value="@level.Id">@level.Code - @level.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="TargetLevelId" class="text-red-500 text-xs mt-1 block font-medium"></span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState["TargetLevelId"]?.Errors.Count > 0)
            {
                <div class="bg-red-50 text-red-600 p-3 rounded-lg mb-4 flex items-center gap-2.5 text-xs">
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                    <span class="font-medium">@ViewData.ModelState["TargetLevelId"]?.Errors[0].ErrorMessage</span>
                </div>
            }

            <div class="flex items-center justify-between mt-5 pt-4 border-t border-slate-100">
                <a asp-action="Goal" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-600 text-sm font-medium hover:bg-slate-50 transition-colors">Quay lại</a>
                <button type="submit" class="px-7 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 shadow-lg shadow-blue-600/30 transition-all flex items-center gap-2">
                    Tiếp tục
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                var btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = 'Đang lưu... <svg class="animate-spin ml-2 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
                btn.classList.add('opacity-75', 'cursor-not-allowed');
            }
        });
    </script>
}
