@model DuAnTotNghiep.Models.ViewModels.Onboarding.OnboardingStep2ViewModel
@{
    ViewData["Title"] = "Đánh giá trình độ";
    var isScoreBased = ViewBag.GoalCode == "IELTS" || ViewBag.GoalCode == "TOEIC";
    string goalName = ViewBag.GoalCode == "TOEIC" ? "TOEIC" : (ViewBag.GoalCode == "IELTS" ? "IELTS" : "bài thi");
}

@section Styles {
    <style>
        .level-card-wrapper {
            position: relative;
        }
        .level-card-body {
            border: 2px solid #e2e8f0;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .level-card-body:hover {
            border-color: #93c5fd;
            box-shadow: 0 4px 12px -2px rgba(147, 197, 253, 0.25);
            transform: translateY(-1px);
        }
        .level-radio:checked + .level-card-body {
            border-color: #2563eb !important;
            background-color: rgba(239, 246, 255, 0.8) !important;
            box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.2) !important;
        }
        .level-radio:checked + .level-card-body .level-badge {
            background-color: #2563eb !important;
            color: #ffffff !important;
        }
        .level-check-icon {
            display: none;
        }
        .level-radio:checked + .level-card-body .level-check-icon {
            display: flex;
        }
    </style>
}

<div class="max-w-5xl mx-auto py-4 px-4 font-sans">
    <partial name="_OnboardingStepper" model="2" />

    <div class="bg-white shadow-xl shadow-slate-200/50 rounded-3xl p-6 sm:p-8 border border-slate-200/80 mt-2 space-y-6">
        
        <form method="post" asp-action="Level" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="GoalCode" />
            
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs font-semibold p-3 bg-red-50 rounded-xl border border-red-100"></div>

            <!-- SECTION 1: Current Level Header -->
            <div>
                <h2 class="text-2xl font-black text-slate-900 leading-tight">Trình độ hiện tại của bạn?</h2>
                <p class="text-slate-500 text-sm mt-1">Chọn trình độ bạn cảm thấy phù hợp. Nếu không chắc, hệ thống sẽ giúp bạn xác định.</p>
            </div>

            <!-- Level Selection Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                <!-- Option: Không chắc chắn -->
                <label class="level-card-wrapper cursor-pointer block">
                    <input type="radio" asp-for="CurrentLevelId" value="" class="hidden level-radio" checked="@(Model.CurrentLevelId == null)" />
                    <div class="level-card-body h-full rounded-2xl p-3.5 bg-white flex items-center justify-between relative overflow-hidden">
                        <div class="flex items-center gap-3 min-w-0 flex-1">
                            <div class="level-badge flex-shrink-0 w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-black text-sm transition-colors shadow-2xs">
                                ?
                            </div>
                            <div class="min-w-0 flex-1">
                                <h3 class="font-extrabold text-slate-900 text-xs sm:text-sm leading-tight break-words">Không chắc chắn</h3>
                                <p class="text-slate-500 text-[11px] font-medium leading-snug mt-0.5">Chưa đánh giá</p>
                            </div>
                        </div>
                        <div class="level-check-icon w-5 h-5 rounded-full bg-blue-600 text-white items-center justify-center shrink-0 ml-1.5 shadow-2xs">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                    </div>
                </label>

                <!-- Active Levels from ViewBag -->
                @if (ViewBag.Levels != null)
                {
                    foreach (var level in ViewBag.Levels)
                    {
                        bool isSelected = (Model.CurrentLevelId == level.Id);

                        <label class="level-card-wrapper cursor-pointer block">
                            <input type="radio" asp-for="CurrentLevelId" value="@level.Id" class="hidden level-radio" checked="@isSelected" />
                            <div class="level-card-body h-full rounded-2xl p-3.5 bg-white flex items-center justify-between relative overflow-hidden">
                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                    <div class="level-badge flex-shrink-0 min-w-[2.5rem] px-2 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-black text-xs transition-colors text-center shadow-2xs">
                                        @level.Code
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h3 class="font-extrabold text-slate-900 text-xs sm:text-sm leading-tight break-words">@level.Name</h3>
                                        <p class="text-slate-500 text-[11px] font-medium leading-snug mt-0.5 line-clamp-2" title="@level.Description">@level.Description</p>
                                    </div>
                                </div>
                                <div class="level-check-icon w-5 h-5 rounded-full bg-blue-600 text-white items-center justify-center shrink-0 ml-1.5 shadow-2xs">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                </div>
                            </div>
                        </label>
                    }
                }
            </div>

            <!-- Guidance Note Under Level Grid -->
            <div class="p-3.5 bg-blue-50/70 border border-blue-100 rounded-2xl flex items-center gap-2.5 text-xs text-blue-900 font-medium">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Không chắc? Hãy chọn <strong>Không chắc chắn</strong> để hệ thống đánh giá trình độ của bạn.</span>
            </div>

            <hr class="border-slate-150 my-4" />

            <!-- SECTION 2: Target -->
            <div class="space-y-3">
                <div>
                    <h3 class="text-lg font-extrabold text-slate-900 leading-tight">Mục tiêu mong muốn</h3>
                    <p class="text-slate-500 text-xs mt-0.5">Bạn muốn đạt được thành tích nào trong tương lai?</p>
                </div>

                @if (isScoreBased)
                {
                    <div class="p-4 bg-slate-50/70 rounded-2xl border border-slate-200/80 space-y-2">
                        <label asp-for="TargetScore" class="block font-bold text-slate-800 text-sm">
                            Điểm số @goalName mục tiêu <span class="text-slate-400 font-normal text-xs ml-1">(Không bắt buộc)</span>
                        </label>
                        <div class="relative max-w-md">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                </svg>
                            </div>
                            <input asp-for="TargetScore" class="block w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm font-medium outline-none transition-all bg-white" type="number" step="0.5" placeholder="Ví dụ: @(ViewBag.GoalCode == "IELTS" ? "6.5" : "800")" />
                        </div>
                        <span asp-validation-for="TargetScore" class="text-red-500 text-xs font-semibold block"></span>
                        <p class="text-slate-500 text-xs">Nhập điểm số mục tiêu bạn muốn đạt được để AI thiết kế lộ trình phù hợp.</p>
                    </div>
                }
                else
                {
                    <div class="p-4 bg-slate-50/70 rounded-2xl border border-slate-200/80 space-y-2">
                        <label asp-for="TargetLevelId" class="block font-bold text-slate-800 text-sm">
                            Trình độ mục tiêu <span class="text-slate-400 font-normal text-xs ml-1">(Không bắt buộc)</span>
                        </label>
                        <div class="max-w-md">
                            <select asp-for="TargetLevelId" class="block w-full py-2.5 px-3.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm font-medium bg-white transition-all outline-none">
                                <option value="">-- Chọn trình độ mong muốn --</option>
                                @if (ViewBag.Levels != null)
                                {
                                    foreach (var level in ViewBag.Levels)
                                    {
                                        <option value="@level.Id">@level.Code - @level.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <span asp-validation-for="TargetLevelId" class="text-red-500 text-xs font-semibold block"></span>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["TargetLevelId"]?.Errors.Count > 0)
                {
                    <div class="bg-red-50 text-red-600 p-3 rounded-xl flex items-center gap-2 text-xs font-semibold border border-red-100">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                        <span>@ViewData.ModelState["TargetLevelId"]?.Errors[0].ErrorMessage</span>
                    </div>
                }
            </div>

            <!-- Footer: Navigation & Progress Indicator -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-150">
                <a asp-action="Goal" class="w-full sm:w-auto px-6 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-bold hover:bg-slate-50 transition-colors text-center cursor-pointer">
                    Quay lại
                </a>

                <!-- Progress Indicator -->
                <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                    <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700">Bước 2 / 5</span>
                </div>

                <!-- Primary Action Button -->
                <button type="submit" class="w-full sm:w-auto px-8 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-lg shadow-blue-600/25 hover:shadow-blue-600/35 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 cursor-pointer">
                    <span>Tiếp tục</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                var btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = 'Đang lưu... <svg class="animate-spin ml-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
                btn.classList.add('opacity-75', 'cursor-not-allowed');
            }
        });
    </script>
}
