@model DuAnTotNghiep.Models.ViewModels.LearningPath.LevelUpResultViewModel
@{
    ViewData["Title"] = "Kết quả đánh giá thăng hạng";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="max-w-3xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-8 font-sans">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden text-center p-8 sm:p-12 space-y-6">
        @if (Model.Promoted)
        {
            <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto shadow-inner animate-bounce">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-xs font-black uppercase tracking-wider">
                Thăng hạng thành công!
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900">
                Chúc mừng bạn đã đạt trình độ @Model.NewLevelName!
            </h1>
        }
        else
        {
            <div class="w-20 h-20 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto shadow-inner">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-xs font-black uppercase tracking-wider">
                Cần cố gắng thêm
            </div>
            <h1 class="text-3xl font-black text-slate-900">
                Kết Quả Đánh Giá: @Model.Percentage%
            </h1>
        }

        <p class="text-slate-600 text-sm leading-relaxed max-w-lg mx-auto">
            @Model.Message
        </p>

        <!-- Score Grid -->
        <div class="grid grid-cols-2 gap-4 max-w-md mx-auto pt-2">
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-150">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 block mb-1">Điểm đạt được</span>
                <span class="text-2xl font-black text-indigo-600">@Model.EarnedScore.ToString("0.#") / @Model.MaxScore.ToString("0.#")</span>
            </div>
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-150">
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 block mb-1">Tỷ lệ chính xác</span>
                <span class="text-2xl font-black @(Model.Percentage >= 70 ? "text-green-600" : "text-amber-600")">@Model.Percentage.ToString("0.#")%</span>
            </div>
        </div>

        <!-- Skill Breakdown (Duolingo Style) -->
        @if (Model.SkillBreakdown != null && Model.SkillBreakdown.Any())
        {
            <div class="border-t border-slate-100 pt-6 text-left space-y-4">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-400 text-center">Phân tích năng lực theo kỹ năng</h3>
                <div class="space-y-3">
                    @foreach (var skill in Model.SkillBreakdown)
                    {
                        <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-150 space-y-2">
                            <div class="flex items-center justify-between text-xs font-bold">
                                <span class="text-slate-900">@skill.SkillName</span>
                                <span class="@(skill.Percentage >= 70 ? "text-green-600" : "text-amber-600")">@skill.Percentage% - @skill.Status</span>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500 @(skill.Percentage >= 70 ? "bg-green-500" : "bg-amber-500")" style="width: @skill.Percentage.ToString("0.#").Replace(",", ".")%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
            <a asp-action="Index" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-extrabold text-sm transition-all shadow-lg shadow-indigo-600/25">
                Về Lộ Trình Học Mới
            </a>
            @if (!Model.Promoted)
            {
                <a asp-action="LevelUpAssessment" class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 font-bold text-xs transition-all">
                    Làm lại bài kiểm tra
                </a>
            }
        </div>
    </div>
</div>
