@model DuAnTotNghiep.Models.ViewModels.PlacementTest.TestResultViewModel
@{
    ViewData["Title"] = "Kết quả bài kiểm tra đầu vào";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    string levelColor = "from-indigo-600 to-blue-600 text-white";
    if (Model.EstimatedLevel.Contains("Beginner", StringComparison.OrdinalIgnoreCase))
    {
        levelColor = "from-emerald-500 to-teal-600 text-white";
    }
    else if (Model.EstimatedLevel.Contains("Elementary", StringComparison.OrdinalIgnoreCase))
    {
        levelColor = "from-blue-500 to-indigo-600 text-white";
    }
    else if (Model.EstimatedLevel.Contains("Upper", StringComparison.OrdinalIgnoreCase))
    {
        levelColor = "from-purple-600 to-pink-600 text-white";
    }
    else if (Model.EstimatedLevel.Contains("Advanced", StringComparison.OrdinalIgnoreCase))
    {
        levelColor = "from-amber-500 to-orange-600 text-white";
    }
}

<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8 font-sans space-y-8">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 rounded-2xl p-4 flex items-center gap-3 shadow-sm">
            <svg class="w-5 h-5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="text-sm text-green-800 font-bold">
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <!-- Overall Result Header & Stats -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden relative p-6 sm:p-10 space-y-8">
        <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-blue-500 via-indigo-600 to-purple-600"></div>

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-6">
            <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block mb-1">Kết quả bài thi Placement Test</span>
                <h1 class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight">Báo Cáo Năng Lực Đánh Giá</h1>
                <p class="text-xs text-slate-500 mt-1">Hoàn thành lúc: @(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>
            </div>

            @if (Model.AiCompleted)
            {
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-200">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span>
                    AI đã phân tích xong
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    AI đang tổng hợp lộ trình...
                </span>
            }
        </div>

        <!-- Overall Score & Level Card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Overall Score Card -->
            <div class="flex flex-col items-center justify-center p-8 bg-slate-50 rounded-2xl border border-slate-150 text-center space-y-2">
                <span class="text-xs font-extrabold text-slate-400 uppercase tracking-wider">Tổng điểm kiểm tra</span>
                <div class="text-5xl font-black text-indigo-600 tracking-tight">
                    @Model.TotalScore.ToString("0.#") <span class="text-2xl text-slate-400 font-bold">/ @Model.MaxScore.ToString("0.#")</span>
                </div>
                <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100 mt-1">
                    Tỷ lệ đúng: @Model.Percentage.ToString("0.#")%
                </div>
            </div>

            <!-- Estimated Level Card -->
            <div class="flex flex-col items-center justify-center p-8 bg-slate-50 rounded-2xl border border-slate-150 text-center space-y-3">
                <span class="text-xs font-extrabold text-slate-400 uppercase tracking-wider">Trình độ được đánh giá</span>
                <div class="px-8 py-3.5 rounded-2xl bg-gradient-to-r @levelColor shadow-md font-black text-2xl tracking-wide">
                    @Model.EstimatedLevel
                </div>
                <p class="text-xs text-slate-600 font-medium max-w-sm text-center leading-relaxed">
                    @(string.IsNullOrEmpty(Model.LevelDescription) ? "Đã xếp loại trình độ dựa trên điểm kiểm tra thực tế." : Model.LevelDescription)
                </p>
                <div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    Trạng thái: @Model.StatusText
                </div>
            </div>
        </div>

        <!-- Metric Details -->
        <div class="grid grid-cols-3 gap-4 border-t border-slate-100 pt-6 text-center">
            <div class="p-3 rounded-xl bg-slate-50">
                <div class="text-2xl font-black text-slate-800">@Model.TotalQuestions</div>
                <div class="text-[11px] font-bold text-slate-400 uppercase mt-0.5">Tổng số câu</div>
            </div>
            <div class="p-3 rounded-xl bg-green-50/60 border border-green-100">
                <div class="text-2xl font-black text-green-600">@Model.CorrectAnswers</div>
                <div class="text-[11px] font-bold text-green-700 uppercase mt-0.5">Câu trả lời đúng</div>
            </div>
            <div class="p-3 rounded-xl bg-red-50/60 border border-red-100">
                <div class="text-2xl font-black text-red-500">@Model.IncorrectAnswers</div>
                <div class="text-[11px] font-bold text-red-700 uppercase mt-0.5">Câu sai / Chưa làm</div>
            </div>
        </div>
    </div>

    <!-- Weaknesses Summary -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-amber-50/70 rounded-2xl p-6 border border-amber-200/60 flex items-start gap-4 shadow-xs">
            <div class="bg-amber-100 text-amber-700 p-3 rounded-xl shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div>
                <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider">Kỹ năng cần tập trung</h3>
                <p class="text-lg font-black text-amber-950 mt-0.5">@(Model.WeakestSkill ?? "Đang cập nhật")</p>
                <p class="text-xs text-amber-700 mt-1 leading-relaxed">Hệ thống AI sẽ thiết kế thêm bài tập và chủ đề luyện tập riêng cho kỹ năng này.</p>
            </div>
        </div>

        <div class="bg-blue-50/70 rounded-2xl p-6 border border-blue-200/60 flex items-start gap-4 shadow-xs">
            <div class="bg-blue-100 text-blue-700 p-3 rounded-xl shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
            </div>
            <div>
                <h3 class="text-xs font-bold text-blue-800 uppercase tracking-wider">Chủ đề ưu tiên ôn tập</h3>
                <p class="text-lg font-black text-blue-950 mt-0.5">@(Model.WeakestTopic ?? "Đồ thị & Ngữ pháp tổng hợp")</p>
                <p class="text-xs text-blue-700 mt-1 leading-relaxed">Tăng cường đọc hiểu và giải các bài tập mẫu xoay quanh chủ đề này.</p>
            </div>
        </div>
    </div>

    <!-- Skill Performance Breakdown -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/80 flex items-center justify-between">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2m0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2"></path></svg>
                Điểm Số Chi Tiết Theo Kỹ Năng (Skill Breakdown)
            </h3>
            <span class="text-xs font-bold text-slate-400">Grammar, Vocabulary, Reading, Listening</span>
        </div>

        <div class="p-6">
            @if (Model.SkillScores != null && Model.SkillScores.Any())
            {
                <div class="space-y-4">
                    @foreach (var skill in Model.SkillScores)
                    {
                        string badgeColor = skill.Percentage >= 75 ? "bg-green-50 text-green-700 border-green-200" : (skill.Percentage >= 50 ? "bg-amber-50 text-amber-700 border-amber-200" : "bg-red-50 text-red-700 border-red-200");
                        string barColor = skill.Percentage >= 75 ? "bg-green-500" : (skill.Percentage >= 50 ? "bg-amber-500" : "bg-red-500");

                        <div class="p-4 rounded-2xl border border-slate-150 bg-slate-50/50 space-y-2.5">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="font-extrabold text-slate-900 text-sm">@skill.SkillName</span>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border @badgeColor">
                                        @skill.Percentage.ToString("0.#")%
                                    </span>
                                </div>
                                <span class="text-xs font-bold text-slate-600">
                                    @skill.EarnedScore.ToString("0.#") / @skill.MaxScore.ToString("0.#") điểm
                                </span>
                            </div>

                            <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500 @barColor" style="width: @skill.Percentage.ToString("0.#").Replace(",", ".")%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-slate-400 italic text-center py-6 text-sm">Chưa có dữ liệu phân tích kỹ năng.</p>
            }
        </div>
    </div>

    <!-- Actions Navigation -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="/Student/Home" class="w-full sm:w-auto px-6 py-3 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 font-bold text-xs transition-all text-center cursor-pointer flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Về Dashboard
        </a>

        <button type="button" onclick="document.getElementById('retakeModal').classList.remove('hidden')" class="w-full sm:w-auto px-6 py-3 rounded-xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-800 font-extrabold text-xs transition-all text-center cursor-pointer flex items-center justify-center gap-2 shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Làm lại bài kiểm tra
        </button>

        <a href="/Student/ClassEnrollment" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-extrabold text-sm transition-all shadow-lg shadow-indigo-600/25 text-center cursor-pointer flex items-center justify-center gap-2">
            <span>Tiến hành Chọn Lớp học phù hợp</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
    </div>

</div>

<!-- Modal xác nhận thi lại -->
<div id="retakeModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('retakeModal').classList.add('hidden')"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 space-y-6 animate-[fadeIn_0.2s_ease-out]">
        <div class="flex items-center gap-3">
            <div class="bg-amber-100 text-amber-600 p-3 rounded-2xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div>
                <h3 class="text-lg font-black text-slate-900">Xác nhận làm lại bài kiểm tra</h3>
                <p class="text-xs text-slate-500 mt-0.5">Placement Test</p>
            </div>
        </div>

        <div class="space-y-3 text-sm text-slate-600 leading-relaxed">
            <p>Bạn có chắc chắn muốn <strong class="text-slate-900">làm lại bài kiểm tra đầu vào</strong> không?</p>
            <ul class="space-y-2 text-xs">
                <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Kết quả bài thi mới sẽ được sử dụng để đánh giá lại trình độ của bạn.</span>
                </li>
                <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>AI sẽ phân tích lại năng lực và cập nhật lộ trình học tập cho bạn.</span>
                </li>
                <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Kết quả lần thi trước vẫn được lưu trong lịch sử.</span>
                </li>
            </ul>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="button" onclick="document.getElementById('retakeModal').classList.add('hidden')" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-sm transition-all">
                Hủy
            </button>
            <form asp-area="Student" asp-controller="PlacementTest" asp-action="Retake" method="post" class="flex-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="testId" value="@Model.PlacementTestId" />
                <button type="submit" class="w-full px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-extrabold text-sm transition-all shadow-lg shadow-amber-500/25">
                    Làm lại ngay
                </button>
            </form>
        </div>
    </div>
</div>
