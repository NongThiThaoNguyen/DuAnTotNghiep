@model DuAnTotNghiep.Models.ViewModels.PlacementTest.TestQuestionViewModel

<div class="mb-4">
    <p class="font-medium text-slate-800 text-lg mb-3">@Html.Raw(Model.QuestionText)</p>
    
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="Question Image" class="max-w-full h-auto mb-4 rounded shadow-sm" />
    }

    <div class="space-y-2 mt-2">
        @foreach (var option in Model.Options)
        {
            var isChecked = (Model.ExistingAnswer == option.Id.ToString()) ? "checked" : "";
            var activeClass = (Model.ExistingAnswer == option.Id.ToString()) ? "border-indigo-600 bg-indigo-50/60 ring-1 ring-indigo-600" : "border-slate-300";

            <label class="mcq-option-label relative flex items-center cursor-pointer rounded-lg border bg-white p-4 shadow-sm transition-all hover:border-indigo-400 @activeClass">
                <input type="radio" name="answers[@Model.QuestionId]" value="@option.Id" class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 mr-3 flex-shrink-0" @isChecked />
                <span class="flex-1 text-sm font-medium text-slate-900">@option.Text</span>
            </label>
        }
    </div>
</div>
