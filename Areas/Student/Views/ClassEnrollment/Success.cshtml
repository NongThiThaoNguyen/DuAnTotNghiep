@model DuAnTotNghiep.Models.ViewModels.Student.EnrollmentSuccessViewModel
@{
    ViewData["Title"] = "Đã chọn lớp thành công";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-enrollment.css" asp-append-version="true" />
}

<div class="ce-page">
    <!-- Success Container -->
    <div class="ce-success-container">
        <!-- Celebration Animation -->
        <div class="ce-success-animation">
            <div class="ce-success-circle">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="ce-confetti ce-confetti-1"></div>
            <div class="ce-confetti ce-confetti-2"></div>
            <div class="ce-confetti ce-confetti-3"></div>
            <div class="ce-confetti ce-confetti-4"></div>
            <div class="ce-confetti ce-confetti-5"></div>
            <div class="ce-confetti ce-confetti-6"></div>
        </div>

        <h1 class="ce-success-title">Đã chọn lớp học thành công!</h1>
        <p class="ce-success-subtitle">Lựa chọn lớp học của bạn đã được ghi nhận. Hệ thống sẵn sàng để chuyển sang bước chọn giáo viên.</p>

        <!-- Enrollment Details -->
        <div class="ce-success-card">
            <div class="ce-success-detail">
                <div class="ce-success-detail-icon">
                    <i class="fa-solid fa-chalkboard"></i>
                </div>
                <div>
                    <span class="ce-success-detail-label">Lớp học</span>
                    <span class="ce-success-detail-value">@Model.ClassName</span>
                </div>
            </div>

            <div class="ce-success-detail">
                <div class="ce-success-detail-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <span class="ce-success-detail-label">Trình độ</span>
                    <span class="ce-success-detail-value">@Model.LevelName</span>
                </div>
            </div>

            <div class="ce-success-detail">
                <div class="ce-success-detail-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div>
                    <span class="ce-success-detail-label">Lịch học</span>
                    <span class="ce-success-detail-value">@Model.ScheduleDisplay</span>
                </div>
            </div>

            <div class="ce-success-detail">
                <div class="ce-success-detail-icon">
                    <i class="fa-regular fa-clock"></i>
                </div>
                <div>
                    <span class="ce-success-detail-label">Ngày đăng ký</span>
                    <span class="ce-success-detail-value">@Model.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Next Step Banner -->
        @if (Model.NeedsTeacherSelection)
        {
            <div class="ce-next-step-banner">
                <div class="ce-next-step-icon">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <div class="ce-next-step-content">
                    <span class="ce-next-step-label">Bước tiếp theo</span>
                    <span class="ce-next-step-text">Chọn giáo viên phù hợp với bạn</span>
                </div>
                <i class="fa-solid fa-arrow-right ce-next-step-arrow"></i>
            </div>
        }

        <!-- Actions -->
        <div class="ce-success-actions">
            @if (Model.NeedsTeacherSelection)
            {
                <a href="@Url.Action("SelectTeacher", "ClassEnrollment", new { area = "Student" })" class="ce-btn ce-btn-primary ce-btn-large">
                    <i class="fa-solid fa-user-tie"></i> Chọn giáo viên ngay
                </a>
            }
            <a href="@Url.Action("Index", "Home")" class="ce-btn ce-btn-secondary">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
