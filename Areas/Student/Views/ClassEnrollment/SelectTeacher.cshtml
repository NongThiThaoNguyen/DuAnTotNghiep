@model DuAnTotNghiep.Models.ViewModels.Student.TeacherSelectionViewModel
@{
    ViewData["Title"] = "Chọn giáo viên";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-enrollment.css" asp-append-version="true" />
    <style>
        /* ── Teacher Selection Specific Styles ── */
        .ts-header {
            text-align: center;
            padding: 2.5rem 1rem 1.5rem;
        }
        .ts-step-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: .35rem .9rem;
            border-radius: 2rem;
            margin-bottom: 1rem;
        }
        .ts-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--ce-text-primary, #1e293b);
            margin: 0 0 .5rem;
        }
        .ts-subtitle {
            color: var(--ce-text-secondary, #64748b);
            font-size: 1rem;
            margin: 0;
        }
        .ts-class-badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(99,102,241,.08);
            color: #6366f1;
            font-size: .85rem;
            font-weight: 600;
            padding: .3rem .8rem;
            border-radius: .5rem;
            margin-top: .75rem;
        }

        /* ── Random Button ── */
        .ts-random-bar {
            max-width: 960px;
            margin: 1rem auto 1.5rem;
            padding: 0 1rem;
            display: flex;
            justify-content: flex-end;
        }
        .ts-random-form { margin: 0; }
        .ts-btn-random {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: linear-gradient(135deg,#f093fb,#f5576c);
            color: #fff;
            border: none;
            padding: .65rem 1.4rem;
            border-radius: .75rem;
            font-size: .9rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 4px 14px rgba(245,87,108,.3);
        }
        .ts-btn-random:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245,87,108,.4);
        }

        /* ── Teacher Grid ── */
        .ts-grid {
            max-width: 960px;
            margin: 0 auto 3rem;
            padding: 0 1rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.25rem;
        }
        .ts-card {
            background: #fff;
            border-radius: 1.25rem;
            border: 2px solid transparent;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            overflow: hidden;
            transition: transform .25s, border-color .25s, box-shadow .25s;
            position: relative;
        }
        .ts-card:not(.ts-card--full):hover {
            transform: translateY(-4px);
            border-color: #6366f1;
            box-shadow: 0 8px 30px rgba(99,102,241,.18);
        }
        .ts-card--full {
            opacity: .55;
            cursor: not-allowed;
        }
        .ts-card--current {
            border-color: #10b981;
            box-shadow: 0 4px 18px rgba(16,185,129,.15);
        }

        .ts-card-top {
            background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
            padding: 1.5rem 1.25rem 2.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }
        .ts-card--current .ts-card-top { background: linear-gradient(135deg,#059669,#10b981); }

        .ts-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,.5);
            margin-bottom: .75rem;
        }
        .ts-avatar-placeholder {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            color: rgba(255,255,255,.8);
            margin-bottom: .75rem;
        }
        .ts-teacher-name {
            color: #fff;
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
        }
        .ts-current-label {
            position: absolute;
            top: .75rem;
            right: .75rem;
            background: rgba(255,255,255,.25);
            color: #fff;
            font-size: .7rem;
            font-weight: 600;
            padding: .2rem .55rem;
            border-radius: 1rem;
        }
        .ts-full-label {
            position: absolute;
            top: .75rem;
            right: .75rem;
            background: rgba(0,0,0,.3);
            color: #fff;
            font-size: .7rem;
            font-weight: 600;
            padding: .2rem .55rem;
            border-radius: 1rem;
        }

        .ts-card-body {
            padding: 1.25rem 1.25rem 1rem;
            margin-top: -1.25rem;
            background: #fff;
            border-radius: 1rem 1rem 0 0;
            position: relative;
        }
        .ts-bio {
            color: #64748b;
            font-size: .83rem;
            line-height: 1.5;
            margin: 0 0 .85rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .ts-info-row {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .82rem;
            color: #475569;
            margin-bottom: .45rem;
        }
        .ts-info-row i { color: #6366f1; width: 16px; flex-shrink: 0; }

        .ts-slots-bar {
            margin: .85rem 0 0;
            background: #f1f5f9;
            border-radius: .5rem;
            height: 6px;
            overflow: hidden;
        }
        .ts-slots-fill {
            height: 100%;
            background: linear-gradient(90deg,#6366f1,#8b5cf6);
            border-radius: .5rem;
            transition: width .5s ease;
        }
        .ts-slots-fill--full { background: #ef4444; }
        .ts-slots-text {
            font-size: .75rem;
            color: #94a3b8;
            margin-top: .35rem;
        }

        .ts-card-foot {
            padding: .85rem 1.25rem 1.25rem;
        }
        .ts-btn-pick {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            background: linear-gradient(135deg,#6366f1,#8b5cf6);
            color: #fff;
            border: none;
            padding: .7rem 1rem;
            border-radius: .75rem;
            font-size: .9rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 4px 14px rgba(99,102,241,.3);
        }
        .ts-btn-pick:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99,102,241,.4);
        }
        .ts-btn-pick:disabled {
            background: #cbd5e1;
            box-shadow: none;
            cursor: not-allowed;
        }
        .ts-btn-pick--current {
            background: linear-gradient(135deg,#059669,#10b981);
            box-shadow: 0 4px 14px rgba(16,185,129,.3);
        }
        .ts-btn-pick--current:hover:not(:disabled) {
            box-shadow: 0 6px 20px rgba(16,185,129,.4);
        }

        /* ── Empty state ── */
        .ts-empty {
            max-width: 480px;
            margin: 3rem auto;
            text-align: center;
            padding: 2rem;
        }
        .ts-empty i { font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem; }
        .ts-empty h3 { font-size: 1.2rem; color: #475569; margin: 0 0 .5rem; }
        .ts-empty p { color: #94a3b8; font-size: .9rem; }

        /* ── Alert ── */
        .ts-alert {
            max-width: 960px;
            margin: 0 auto 1.25rem;
            padding: 0 1rem;
        }
        .ts-alert-inner {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            padding: .85rem 1rem;
            border-radius: .75rem;
            font-size: .9rem;
        }

        @@media (max-width: 640px) {
            .ts-title { font-size: 1.5rem; }
            .ts-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<div class="ce-page">
    <!-- Header -->
    <div class="ts-header">
        <div class="ts-step-badge">
            <i class="fa-solid fa-4"></i> Bước 4 / 4
        </div>
        <h1 class="ts-title">Chọn giáo viên của bạn</h1>
        <p class="ts-subtitle">Chọn giáo viên phù hợp hoặc để hệ thống chọn ngẫu nhiên cho bạn</p>
        <div class="ts-class-badge">
            <i class="fa-solid fa-chalkboard"></i>
            Lớp: <strong>@Model.ClassName</strong> &nbsp;·&nbsp; Trình độ: <strong>@Model.LevelName</strong>
        </div>
    </div>

    <!-- Error alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ts-alert">
            <div class="ts-alert-inner">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <!-- Random Button -->
    <div class="ts-random-bar">
        <form asp-area="Student" asp-controller="ClassEnrollment" asp-action="RandomTeacher" method="post" class="ts-random-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="ts-btn-random">
                <i class="fa-solid fa-dice"></i> 🎲 Phân giáo viên ngẫu nhiên
            </button>
        </form>
    </div>

    <!-- Teachers Grid -->
    @if (Model.Teachers.Any())
    {
        <div class="ts-grid">
            @foreach (var t in Model.Teachers)
            {
                bool isCurrent = t.ClassroomId == Model.CurrentClassroomId;
                int pct = t.MaxStudents > 0 ? (int)((double)t.CurrentStudents / t.MaxStudents * 100) : 0;

                <div class="ts-card @(t.IsFull ? "ts-card--full" : "") @(isCurrent ? "ts-card--current" : "")">
                    <div class="ts-card-top">
                        @if (isCurrent)
                        {
                            <span class="ts-current-label"><i class="fa-solid fa-star"></i> Lớp đang chọn</span>
                        }
                        @if (t.IsFull)
                        {
                            <span class="ts-full-label"><i class="fa-solid fa-lock"></i> Đã đầy</span>
                        }

                        @if (!string.IsNullOrEmpty(t.AvatarUrl))
                        {
                            <img src="@t.AvatarUrl" class="ts-avatar" alt="@t.TeacherName" />
                        }
                        else
                        {
                            <div class="ts-avatar-placeholder">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                        }
                        <p class="ts-teacher-name">@t.TeacherName</p>
                    </div>

                    <div class="ts-card-body">
                        @if (!string.IsNullOrEmpty(t.Bio))
                        {
                            <p class="ts-bio">@t.Bio</p>
                        }
                        <div class="ts-info-row">
                            <i class="fa-solid fa-chalkboard"></i>
                            <span>@t.ClassName</span>
                        </div>
                        <div class="ts-info-row">
                            <i class="fa-solid fa-calendar"></i>
                            <span>@t.ScheduleDisplay</span>
                        </div>
                        <div class="ts-info-row">
                            <i class="fa-solid fa-users"></i>
                            <span>@t.CurrentStudents / @t.MaxStudents học sinh</span>
                        </div>

                        <div class="ts-slots-bar">
                            <div class="ts-slots-fill @(t.IsFull ? "ts-slots-fill--full" : "")"
                                 style="width: @pct%"></div>
                        </div>
                        <div class="ts-slots-text">
                            @if (t.IsFull)
                            {
                                <span style="color:#ef4444">Đã đầy chỗ</span>
                            }
                            else
                            {
                                <span>Còn @t.RemainingSlots chỗ trống</span>
                            }
                        </div>
                    </div>

                    <div class="ts-card-foot">
                        <form asp-area="Student" asp-controller="ClassEnrollment" asp-action="PickTeacher" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="classroomId" value="@t.ClassroomId" />
                            <button type="submit"
                                    class="ts-btn-pick @(isCurrent ? "ts-btn-pick--current" : "")"
                                    @(t.IsFull ? "disabled" : "")>
                                @if (t.IsFull)
                                {
                                    <i class="fa-solid fa-ban"></i>
                                    <span>Hết chỗ</span>
                                }
                                else if (isCurrent)
                                {
                                    <i class="fa-solid fa-check"></i>
                                    <span>Chọn giáo viên này</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-hand-pointer"></i>
                                    <span>Chọn giáo viên này</span>
                                }
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ts-empty">
            <i class="fa-solid fa-user-slash"></i>
            <h3>Chưa có giáo viên nào</h3>
            <p>Hiện tại chưa có giáo viên phụ trách lớp cùng trình độ. Vui lòng liên hệ nhà trường để được hỗ trợ.</p>
        </div>
    }
</div>
