@model DuAnTotNghiep.Models.ViewModels.Student.ClassSelectionViewModel
@{
    ViewData["Title"] = "Chọn lớp học";
    var errorMsg = TempData["ErrorMessage"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-enrollment.css" asp-append-version="true" />
}

<div class="ce-page">
    <!-- Header -->
    <div class="ce-header">
        <div class="ce-header-icon">
            <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div class="ce-header-text">
            <h1 class="ce-title">Chọn lớp học</h1>
            <p class="ce-subtitle">Bước 2: Chọn lớp phù hợp với trình độ của bạn sau khi hoàn thành kiểm tra đầu vào</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="ce-alert ce-alert-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@errorMsg</span>
        </div>
    }

    <!-- Student Level Badge -->
    <div class="ce-level-badge">
        <div class="ce-level-badge-inner">
            <div class="ce-level-icon">
                <i class="fa-solid fa-chart-simple"></i>
            </div>
            <div>
                <span class="ce-level-label">Trình độ của bạn</span>
                <span class="ce-level-value">@Model.StudentLevel</span>
            </div>
        </div>
    </div>

    @if (Model.AlreadyEnrolled && Model.CurrentEnrollment != null)
    {
        <!-- Already Enrolled -->
        <div class="ce-enrolled-card">
            <div class="ce-enrolled-header">
                <div class="ce-enrolled-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <h2 class="ce-enrolled-title">Bạn đã đăng ký lớp học</h2>
                    <p class="ce-enrolled-subtitle">Bạn đang tham gia lớp bên dưới. Mỗi học viên chỉ được đăng ký 1 lớp.</p>
                </div>
            </div>
            <div class="ce-enrolled-body">
                <div class="ce-enrolled-info-grid">
                    <div class="ce-info-item">
                        <i class="fa-solid fa-chalkboard"></i>
                        <div>
                            <span class="ce-info-label">Lớp</span>
                            <span class="ce-info-value">@Model.CurrentEnrollment.ClassName</span>
                        </div>
                    </div>
                    <div class="ce-info-item">
                        <i class="fa-solid fa-layer-group"></i>
                        <div>
                            <span class="ce-info-label">Trình độ</span>
                            <span class="ce-info-value">@Model.CurrentEnrollment.LevelName</span>
                        </div>
                    </div>
                    <div class="ce-info-item">
                        <i class="fa-solid fa-user-tie"></i>
                        <div>
                            <span class="ce-info-label">Giáo viên</span>
                            <span class="ce-info-value">@Model.CurrentEnrollment.TeacherName</span>
                        </div>
                    </div>
                    <div class="ce-info-item">
                        <i class="fa-solid fa-calendar-days"></i>
                        <div>
                            <span class="ce-info-label">Lịch học</span>
                            <span class="ce-info-value">@Model.CurrentEnrollment.ScheduleDisplay</span>
                        </div>
                    </div>
                </div>
                <div class="ce-enrolled-footer">
                    <span class="ce-enrolled-date">
                        <i class="fa-regular fa-clock"></i>
                        Đăng ký lúc @Model.CurrentEnrollment.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </span>
                    <a href="@Url.Action("Index", "Home")" class="ce-btn ce-btn-primary">
                        <i class="fa-solid fa-house"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Class List -->
        @if (Model.AvailableClasses.Count == 0)
        {
            <div class="ce-empty-state">
                <div class="ce-empty-icon">
                    <i class="fa-solid fa-inbox"></i>
                </div>
                <h2>Chưa có lớp phù hợp</h2>
                <p>Hiện tại chưa có lớp học nào phù hợp với trình độ <strong>@Model.StudentLevel</strong> của bạn. Vui lòng quay lại sau.</p>
                <a href="@Url.Action("Index", "Home")" class="ce-btn ce-btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Về trang chủ
                </a>
            </div>
        }
        else
        {
            <div class="ce-stats-bar">
                <span><i class="fa-solid fa-list"></i> <strong>@Model.AvailableClasses.Count</strong> lớp phù hợp</span>
                <span><i class="fa-solid fa-door-open"></i> <strong>@Model.AvailableClasses.Count(c => !c.IsFull)</strong> lớp còn chỗ</span>
            </div>

            <div class="ce-class-grid">
                @foreach (var cls in Model.AvailableClasses)
                {
                    <div class="ce-class-card @(cls.IsFull ? "ce-class-card-full" : "")">
                        @if (cls.IsFull)
                        {
                            <div class="ce-badge-full">
                                <i class="fa-solid fa-ban"></i> ĐẦY
                            </div>
                        }

                        <div class="ce-class-card-header">
                            <div class="ce-class-level-tag">@cls.LevelCode</div>
                            <h3 class="ce-class-name">@cls.ClassName</h3>
                        </div>

                        <div class="ce-class-card-body">
                            <div class="ce-class-detail">
                                <i class="fa-solid fa-user-tie"></i>
                                <div>
                                    <span class="ce-detail-label">Giáo viên</span>
                                    <span class="ce-detail-value">@cls.TeacherName</span>
                                </div>
                            </div>

                            <div class="ce-class-detail">
                                <i class="fa-solid fa-calendar-days"></i>
                                <div>
                                    <span class="ce-detail-label">Lịch học</span>
                                    <span class="ce-detail-value">@cls.ScheduleDisplay</span>
                                </div>
                            </div>

                            <div class="ce-class-detail">
                                <i class="fa-solid fa-calendar-check"></i>
                                <div>
                                    <span class="ce-detail-label">Ngày khai giảng</span>
                                    <span class="ce-detail-value">@cls.StartDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <!-- Capacity Bar -->
                            <div class="ce-capacity">
                                <div class="ce-capacity-header">
                                    <span class="ce-capacity-label">
                                        <i class="fa-solid fa-users"></i> Sĩ số
                                    </span>
                                    <span class="ce-capacity-count">
                                        @cls.CurrentStudents / @cls.MaxStudents
                                    </span>
                                </div>
                                <div class="ce-capacity-bar">
                                    @{
                                        var pct = cls.MaxStudents > 0 ? (double)cls.CurrentStudents / cls.MaxStudents * 100 : 0;
                                        var barClass = pct >= 90 ? "ce-bar-danger" : pct >= 70 ? "ce-bar-warning" : "ce-bar-ok";
                                    }
                                    <div class="ce-capacity-fill @barClass" style="width: @pct.ToString("0")%"></div>
                                </div>
                                <span class="ce-remaining @(cls.IsFull ? "ce-remaining-full" : "")">
                                    @if (cls.IsFull)
                                    {
                                        <text>Hết chỗ</text>
                                    }
                                    else
                                    {
                                        <text>Còn @cls.RemainingSlots chỗ trống</text>
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="ce-class-card-footer">
                            @if (cls.IsFull)
                            {
                                <button class="ce-btn ce-btn-disabled" disabled>
                                    <i class="fa-solid fa-ban"></i> Lớp đã đầy
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("Confirm", "ClassEnrollment", new { id = cls.ClassroomId })"
                                   class="ce-btn ce-btn-primary ce-btn-enroll">
                                    <i class="fa-solid fa-hand-pointer"></i> Chọn lớp này
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
