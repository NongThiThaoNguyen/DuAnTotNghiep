@model DuAnTotNghiep.Models.ViewModels.Student.ClassEnrollConfirmViewModel
@{
    ViewData["Title"] = "Xác nhận đăng ký lớp";
    var cls = Model.ClassInfo;
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-enrollment.css" asp-append-version="true" />
}

<div class="ce-page">
    <!-- Back link -->
    <a href="@Url.Action("Index", "ClassEnrollment")" class="ce-back-link">
        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách lớp
    </a>

    <!-- Confirm Header -->
    <div class="ce-confirm-header">
        <div class="ce-confirm-icon">
            <i class="fa-solid fa-clipboard-check"></i>
        </div>
        <h1 class="ce-title">Xác nhận đăng ký lớp</h1>
        <p class="ce-subtitle">Vui lòng kiểm tra thông tin bên dưới trước khi xác nhận đăng ký</p>
    </div>

    <!-- Confirm Card -->
    <div class="ce-confirm-card">
        <!-- Student Info -->
        <div class="ce-confirm-section">
            <h3 class="ce-confirm-section-title">
                <i class="fa-solid fa-user-graduate"></i> Thông tin học viên
            </h3>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Họ tên</span>
                <span class="ce-confirm-value">@Model.StudentName</span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Trình độ</span>
                <span class="ce-confirm-value ce-level-highlight">@Model.StudentLevel</span>
            </div>
        </div>

        <div class="ce-confirm-divider"></div>

        <!-- Class Info -->
        <div class="ce-confirm-section">
            <h3 class="ce-confirm-section-title">
                <i class="fa-solid fa-chalkboard-user"></i> Thông tin lớp học
            </h3>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Tên lớp</span>
                <span class="ce-confirm-value"><strong>@cls.ClassName</strong></span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Trình độ</span>
                <span class="ce-confirm-value">@cls.LevelName (@cls.LevelCode)</span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Giáo viên</span>
                <span class="ce-confirm-value">@cls.TeacherName</span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Lịch học</span>
                <span class="ce-confirm-value">@cls.ScheduleDisplay</span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Ngày khai giảng</span>
                <span class="ce-confirm-value">@cls.StartDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="ce-confirm-info-row">
                <span class="ce-confirm-label">Sĩ số hiện tại</span>
                <span class="ce-confirm-value">@cls.CurrentStudents / @cls.MaxStudents (còn @cls.RemainingSlots chỗ)</span>
            </div>
        </div>

        <!-- Warning -->
        <div class="ce-confirm-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Sau khi xác nhận, bạn sẽ được đăng ký vào lớp này. Mỗi học viên chỉ được đăng ký <strong>1 lớp duy nhất</strong>.</span>
        </div>

        <!-- Actions -->
        <div class="ce-confirm-actions">
            <a href="@Url.Action("Index", "ClassEnrollment")" class="ce-btn ce-btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
            <form method="post" asp-action="Enroll" asp-controller="ClassEnrollment" asp-area="Student" id="enrollForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classroomId" value="@cls.ClassroomId" />
                <button type="submit" class="ce-btn ce-btn-primary ce-btn-confirm" id="btnConfirmEnroll">
                    <i class="fa-solid fa-check-circle"></i> Xác nhận đăng ký
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prevent double-submit
        document.getElementById('enrollForm').addEventListener('submit', function () {
            var btn = document.getElementById('btnConfirmEnroll');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
        });
    </script>
}
