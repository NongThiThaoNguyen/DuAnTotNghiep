@model IEnumerable<DuAnTotNghiep.Models.ReferenceSource>
@using DuAnTotNghiep.Models.Enums
@{
    ViewData["Title"] = "Kho tài liệu tham khảo";
    var keyword = ViewBag.Keyword as string;
    var sourceType = ViewBag.SourceType as ReferenceSourceType?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Học liệu</span>
        <h1>Kho tài liệu tham khảo</h1>
        <p>Quản lý sách điện tử, podcast và liên kết học tập để học viên tham khảo đúng nguồn.</p>
    </div>
    <a asp-action="Create"
       class="btn btn-primary"
       data-teacher-modal
       data-modal-title="Thêm học liệu mới"
       data-modal-size="lg">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        Tải lên học liệu
    </a>
</div>

<form method="get" class="teacher-toolbar mb-4" aria-label="Bộ lọc học liệu">
    <div class="teacher-toolbar-field is-wide">
        <label for="resourceKeyword">Tìm kiếm</label>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="resourceKeyword" type="text" name="keyword" value="@keyword" placeholder="Tên học liệu, tác giả hoặc tổ chức" />
        </div>
    </div>

    <div class="teacher-toolbar-field">
        <label for="resourceType">Loại tài liệu</label>
        <select id="resourceType" name="sourceType" class="form-select">
            <option value="">Tất cả tài liệu</option>
            <option value="TEACHER_CREATED" selected="@(sourceType == ReferenceSourceType.TEACHER_CREATED ? "selected" : null)">Giáo viên biên soạn</option>
            <option value="OFFICIAL" selected="@(sourceType == ReferenceSourceType.OFFICIAL ? "selected" : null)">Chính thống</option>
            <option value="OPEN_LICENSE" selected="@(sourceType == ReferenceSourceType.OPEN_LICENSE ? "selected" : null)">Giấy phép mở</option>
            <option value="REFERENCE_ONLY" selected="@(sourceType == ReferenceSourceType.REFERENCE_ONLY ? "selected" : null)">Chỉ tham khảo</option>
        </select>
    </div>

    <div class="teacher-action-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
            Lọc
        </button>
        <a asp-action="Index" class="teacher-icon-button" title="Làm mới" aria-label="Làm mới bộ lọc">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </a>
    </div>
</form>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Tên học liệu</th>
                <th>Tác giả/Tổ chức</th>
                <th class="text-center">Phân loại</th>
                <th class="text-center">Chính sách</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="teacher-empty-row">Không tìm thấy tài liệu nào.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="teacher-table-title">
                            <strong>@item.SourceName</strong>
                            @if (!string.IsNullOrEmpty(item.SourceUrl))
                            {
                                <a href="@item.SourceUrl" target="_blank" rel="noopener" class="teacher-resource-link">@item.SourceUrl</a>
                            }
                        </div>
                    </td>
                    <td>@(item.Author ?? "N/A") / @(item.Organization ?? "N/A")</td>
                    <td class="text-center">
                        <span class="teacher-status">@item.SourceType</span>
                    </td>
                    <td class="text-center">@item.UsagePolicy</td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="teacher-icon-button" title="Xem" aria-label="Xem @item.SourceName">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="teacher-icon-button"
                               title="Sửa"
                               aria-label="Sửa @item.SourceName"
                               data-teacher-modal
                               data-modal-title="Chỉnh sửa học liệu"
                               data-modal-size="lg">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="teacher-icon-button btn-action-delete"
                               title="Xóa"
                               aria-label="Xóa @item.SourceName"
                               data-teacher-modal
                               data-modal-title="Xóa học liệu"
                               data-modal-size="md">
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="teacher-pagination" aria-label="Phân trang học liệu">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="/Teacher/Resources?page=@p&keyword=@keyword&sourceType=@sourceType"
               class="btn @(currentPage == p ? "btn-primary" : "btn-secondary")"
               aria-current="@(currentPage == p ? "page" : null)">
                @p
            </a>
        }
    </nav>
}
