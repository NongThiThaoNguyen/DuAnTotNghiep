@model DuAnTotNghiep.Models.ReferenceSource
@{
    ViewData["Title"] = "Chi tiết học liệu - " + Model.SourceName;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chi tiết học liệu</span>
        <h1>@Model.SourceName</h1>
        <p>@(Model.Description ?? "Không có mô tả chi tiết.")</p>
    </div>
    <div class="teacher-action-group">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Kho học liệu
        </a>
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary"
           data-teacher-modal
           data-modal-title="Chỉnh sửa học liệu"
           data-modal-size="lg">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            Chỉnh sửa
        </a>
    </div>
</div>

<div class="teacher-panel">
    <div class="teacher-meta-pills mb-3">
        <span class="teacher-status">Phân loại: @Model.SourceType</span>
        <span class="teacher-status is-success">Chính sách: @Model.UsagePolicy</span>
        <span class="teacher-status">@Model.Status</span>
    </div>

    <dl class="teacher-detail-grid">
        <div>
            <dt>Tác giả</dt>
            <dd>@(Model.Author ?? "N/A")</dd>
        </div>
        <div>
            <dt>Tổ chức / NXB</dt>
            <dd>@(Model.Organization ?? "N/A")</dd>
        </div>
        <div>
            <dt>Ghi chú giấy phép</dt>
            <dd>@(Model.LicenseNote ?? "N/A")</dd>
        </div>
        <div>
            <dt>Trạng thái duyệt</dt>
            <dd>@Model.Status</dd>
        </div>
    </dl>

    @if (!string.IsNullOrEmpty(Model.SourceUrl))
    {
        <div class="teacher-callout mt-4">
            <span>Liên kết tài nguyên</span>
            <a href="@Model.SourceUrl" target="_blank" rel="noopener">@Model.SourceUrl</a>
        </div>
    }
</div>
