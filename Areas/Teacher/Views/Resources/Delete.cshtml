@model DuAnTotNghiep.Models.ReferenceSource
@{
    ViewData["Title"] = "Xóa học liệu - " + Model.SourceName;
}

<div class="teacher-danger-shell">
    <div class="teacher-danger-header">
        <span class="teacher-danger-icon" aria-hidden="true">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </span>
        <h1>Xác nhận gỡ bỏ học liệu?</h1>
        <p>Học liệu sẽ bị gỡ khỏi kho tài liệu tham khảo của học viên.</p>
    </div>

    <div class="teacher-panel teacher-danger-panel">
        <dl class="teacher-detail-grid is-compact">
            <div>
                <dt>Tên học liệu</dt>
                <dd>@Model.SourceName</dd>
            </div>
            <div>
                <dt>Tác giả</dt>
                <dd>@(Model.Author ?? "N/A")</dd>
            </div>
            <div>
                <dt>Phân loại nguồn</dt>
                <dd>@Model.SourceType</dd>
            </div>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="teacher-form-actions">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-secondary teacher-page-cancel">Hủy</a>
            <button type="button" class="btn btn-secondary teacher-modal-cancel" data-teacher-modal-close>Hủy</button>
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        </form>
    </div>
</div>
