@model DuAnTotNghiep.Models.ReferenceSource
@using DuAnTotNghiep.Models.Enums
@{
    ViewData["Title"] = "Thêm học liệu mới";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Học liệu</span>
        <h1>Tải lên học liệu mới</h1>
        <p>Ghi rõ nguồn, chính sách sử dụng và mô tả để học viên có thể tham khảo đúng bối cảnh.</p>
    </div>
</div>

<div class="teacher-panel teacher-form-panel">
    <form asp-action="Create" method="post" class="teacher-form">
        <div asp-validation-summary="ModelOnly" class="teacher-validation-summary"></div>

        <div class="teacher-form-grid">
            <div class="teacher-field-wide">
                <label asp-for="SourceName">Tên học liệu</label>
                <input asp-for="SourceName" placeholder="Ví dụ: Cambridge English Grammar in Use" required />
                <span asp-validation-for="SourceName" class="teacher-field-error"></span>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="SourceUrl">Đường dẫn tài liệu</label>
                <input asp-for="SourceUrl" placeholder="https://example.com/document.pdf" />
                <span asp-validation-for="SourceUrl" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="SourceType">Phân loại nguồn</label>
                <select asp-for="SourceType" required>
                    <option value="@ReferenceSourceType.TEACHER_CREATED">Giảng viên biên soạn</option>
                    <option value="@ReferenceSourceType.OFFICIAL">Nguồn chính thống</option>
                    <option value="@ReferenceSourceType.OPEN_LICENSE">Giấy phép mở</option>
                    <option value="@ReferenceSourceType.REFERENCE_ONLY">Chỉ tham khảo</option>
                </select>
                <span asp-validation-for="SourceType" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="UsagePolicy">Chính sách sử dụng</label>
                <select asp-for="UsagePolicy" required>
                    <option value="@ReferenceUsagePolicy.REFERENCE_ONLY">Chỉ tham khảo</option>
                    <option value="@ReferenceUsagePolicy.OPEN_LICENSE">Phát hành miễn phí</option>
                    <option value="@ReferenceUsagePolicy.RESTRICTED">Giới hạn sử dụng</option>
                </select>
                <span asp-validation-for="UsagePolicy" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="Author">Tác giả</label>
                <input asp-for="Author" placeholder="Tên tác giả" />
                <span asp-validation-for="Author" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="Organization">Tổ chức / Nhà xuất bản</label>
                <input asp-for="Organization" placeholder="Ví dụ: Cambridge University Press" />
                <span asp-validation-for="Organization" class="teacher-field-error"></span>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="LicenseNote">Ghi chú bản quyền / Giấy phép</label>
                <input asp-for="LicenseNote" placeholder="Ví dụ: CC-BY-SA, All Rights Reserved" />
                <span asp-validation-for="LicenseNote" class="teacher-field-error"></span>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="Description">Tóm tắt mô tả tài liệu</label>
                <textarea asp-for="Description" rows="4" placeholder="Tóm tắt ngắn gọn nội dung và giá trị học tập"></textarea>
                <span asp-validation-for="Description" class="teacher-field-error"></span>
            </div>
        </div>

        <div class="teacher-form-actions">
            <a asp-action="Index" class="btn btn-secondary teacher-page-cancel">Hủy</a>
            <button type="button" class="btn btn-secondary teacher-modal-cancel" data-teacher-modal-close>Hủy</button>
            <button type="submit" class="btn btn-primary">Tải lên</button>
        </div>
    </form>
</div>
