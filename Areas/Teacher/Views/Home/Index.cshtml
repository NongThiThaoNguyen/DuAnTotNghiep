@model DuAnTotNghiep.Models.ViewModels.Teacher.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan giảng dạy";
}

<header class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Không gian giảng dạy</span>
        <h1>Tổng quan giảng dạy</h1>
        <p>Theo dõi lớp học, công việc cần chấm và lịch dạy của bạn.</p>
    </div>
    <a class="btn btn-secondary-ailearn"
       asp-area="Teacher"
       asp-controller="Schedule"
       asp-action="Index">
        <i class="fa-regular fa-calendar" aria-hidden="true"></i>
        Xem lịch dạy
    </a>
</header>

<section class="teacher-panel teacher-welcome" aria-labelledby="teacherWelcomeTitle">
    <span class="teacher-welcome-mark" aria-hidden="true">
        <i class="fa-solid fa-chalkboard-user"></i>
    </span>
    <div>
        <h2 id="teacherWelcomeTitle">Xin chào, @Model.TeacherName</h2>
        <p>Những việc cần ưu tiên hôm nay đã được tổng hợp bên dưới.</p>
    </div>
</section>

<section class="teacher-stat-grid" aria-label="Chỉ số giảng dạy">
    <article class="teacher-stat">
        <span class="teacher-stat-label">Khóa học đang dạy</span>
        <strong class="teacher-stat-value">@Model.CoursesCount</strong>
        <span class="teacher-stat-note">Khóa học đang hoạt động</span>
    </article>
    <article class="teacher-stat">
        <span class="teacher-stat-label">Học viên</span>
        <strong class="teacher-stat-value">@Model.StudentsCount</strong>
        <span class="teacher-stat-note">Học viên trên hệ thống</span>
    </article>
    <article class="teacher-stat">
        <span class="teacher-stat-label">Bài cần chấm</span>
        <strong class="teacher-stat-value teacher-stat-value-danger">@Model.PendingSubmissionsCount</strong>
        <span class="teacher-stat-note">Bài đang chờ phản hồi</span>
    </article>
    <article class="teacher-stat">
        <span class="teacher-stat-label">Lịch hôm nay</span>
        <strong class="teacher-stat-value">@Model.TodaySchedulesCount</strong>
        <span class="teacher-stat-note">Ca giảng dạy đã lên lịch</span>
    </article>
</section>

<div class="teacher-dashboard-grid">
    <div class="teacher-dashboard-main">
        <section class="teacher-panel">
            <header class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Cần xử lý</span>
                    <h2>Bài tập nộp gần đây</h2>
                </div>
                <a asp-area="Teacher" asp-controller="Assignments" asp-action="Index">Xem tất cả</a>
            </header>

            <div class="teacher-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Học viên</th>
                            <th>Bài tập</th>
                            <th>Ngày nộp</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentSubmissions.Any())
                        {
                            <tr>
                                <td colspan="5" class="teacher-empty-row">Không có bài tập mới cần chấm.</td>
                            </tr>
                        }
                        @foreach (var submission in Model.RecentSubmissions)
                        {
                            <tr>
                                <td><strong>@submission.StudentName</strong></td>
                                <td>@submission.TaskTitle</td>
                                <td>@submission.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (submission.Status == "SUBMITTED")
                                    {
                                        <span class="teacher-status is-warning">Đợi chấm</span>
                                    }
                                    else
                                    {
                                        <span class="teacher-status is-success">Đã chấm</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-primary-ailearn btn-sm"
                                       asp-area="Teacher"
                                       asp-controller="Assignments"
                                       asp-action="Grade"
                                       asp-route-id="@submission.Id"
                                       data-teacher-modal
                                       data-modal-title="Chấm bài tập"
                                       data-modal-size="xl">
                                        Chấm điểm
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="teacher-panel">
            <header class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Kết quả học tập</span>
                    <h2>Lượt làm quiz mới nhất</h2>
                </div>
                <a asp-area="Teacher" asp-controller="Grades" asp-action="Index">Mở sổ điểm</a>
            </header>

            <div class="teacher-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Học viên</th>
                            <th>Bài quiz</th>
                            <th>Ngày làm</th>
                            <th class="text-end">Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentQuizAttempts.Any())
                        {
                            <tr>
                                <td colspan="4" class="teacher-empty-row">Chưa có lượt làm quiz gần đây.</td>
                            </tr>
                        }
                        @foreach (var attempt in Model.RecentQuizAttempts)
                        {
                            <tr>
                                <td><strong>@attempt.StudentName</strong></td>
                                <td>@attempt.QuizTitle</td>
                                <td>@(attempt.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa nộp")</td>
                                <td class="text-end">
                                    <strong class="@(attempt.Score >= 50 ? "teacher-score-pass" : "teacher-score-low")">
                                        @(attempt.Score?.ToString("0.0") ?? "-")
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <aside class="teacher-dashboard-aside" aria-label="Lịch và phân bố khóa học">
        <section class="teacher-panel">
            <header class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Hôm nay</span>
                    <h2>Lịch dạy</h2>
                </div>
                <span class="teacher-status">@Model.TodaySchedules.Count ca</span>
            </header>

            <div class="teacher-schedule-list">
                @if (!Model.TodaySchedules.Any())
                {
                    <div class="teacher-empty-state">Hôm nay bạn không có lịch giảng dạy.</div>
                }
                @foreach (var schedule in Model.TodaySchedules)
                {
                    <article class="teacher-schedule-item">
                        <h3>@schedule.Title</h3>
                        <p><i class="fa-regular fa-clock" aria-hidden="true"></i> @schedule.StartTime.ToString("HH:mm") - @schedule.EndTime.ToString("HH:mm")</p>
                        <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @(schedule.Classroom ?? "Trực tuyến")</p>
                    </article>
                }
            </div>

            <a class="btn btn-secondary-ailearn w-100"
               asp-area="Teacher"
               asp-controller="Schedule"
               asp-action="Index">Xem lịch đầy đủ</a>
        </section>

        <section class="teacher-panel">
            <header class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Nội dung</span>
                    <h2>Phân bố khóa học</h2>
                </div>
            </header>

            <div class="teacher-progress-list">
                @for (var index = 0; index < Model.ChartLabels.Count; index++)
                {
                    var label = Model.ChartLabels[index];
                    var value = Model.ChartValues[index];
                    var maxValue = Model.ChartValues.Any() ? Model.ChartValues.Max() : 0;
                    var percent = maxValue > 0 ? (double)value / maxValue * 100 : 0;

                    <div class="teacher-progress-item">
                        <div>
                            <span>@label</span>
                            <strong>@value khóa</strong>
                        </div>
                        <div class="teacher-progress-track" role="progressbar" aria-label="@label" aria-valuenow="@value" aria-valuemin="0" aria-valuemax="@maxValue">
                            <span class="teacher-progress-value" style="--teacher-progress: @percent%"></span>
                        </div>
                    </div>
                }
            </div>
        </section>
    </aside>
</div>
