@model List<DuAnTotNghiep.Models.ViewModels.Teacher.StudentAttendanceViewModel>
@{
    ViewData["Title"] = "Điểm danh học viên";
    var topicId = ViewBag.TopicId as int?;
    var selectedDate = ViewBag.SelectedDate as string;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Lớp học</span>
        <h1>Điểm danh học viên</h1>
        <p>Điểm danh chuyên cần và ghi chú tình hình học tập hàng ngày.</p>
    </div>
    <a asp-action="History" class="btn btn-secondary">
        <i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i>
        Lịch sử điểm danh
    </a>
</div>

<!-- Selection Bar -->
<form method="get" class="teacher-toolbar mb-4" aria-label="Bộ lọc điểm danh">
    <div class="teacher-toolbar-field is-wide">
        <label for="topicSelect">Khóa học</label>
        <select id="topicSelect" name="topicId" asp-items="ViewBag.TopicsList" class="form-select">
            <option value="">-- Chọn khóa học --</option>
        </select>
    </div>

    <div class="teacher-toolbar-field">
        <label for="attendanceDate">Ngày điểm danh</label>
        <input id="attendanceDate" type="date" name="date" value="@selectedDate" class="form-control" />
    </div>

    <div class="teacher-action-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter me-1" aria-hidden="true"></i> Tải danh sách
        </button>
        <a asp-action="Index" class="teacher-icon-button" title="Làm mới" aria-label="Làm mới bộ lọc">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </a>
    </div>
</form>

@if (topicId.HasValue)
{
    <div class="teacher-panel">
        <div class="teacher-section-header">
            <div>
                <span class="teacher-section-kicker">Danh sách lớp</span>
                <h2>Sổ điểm danh (@Model.Count học viên)</h2>
            </div>
            @if (Model.Any())
            {
                <button type="button" class="btn btn-secondary" onclick="markAllPresent()">
                    <i class="fa-solid fa-check-double me-1"></i> Tất cả đi học
                </button>
            }
        </div>

        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="topicId" value="@topicId" />
            <input type="hidden" name="date" value="@selectedDate" />

            <div class="teacher-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="width:30%">Học viên</th>
                            <th class="text-center" style="width:45%">Trạng thái điểm danh</th>
                            <th style="width:25%">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="teacher-empty-row">Không có học viên nào trong danh sách lớp này.</td>
                            </tr>
                        }
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model[i].StudentName</strong>
                                    <div class="text-muted" style="font-size:0.78rem;">@Model[i].StudentEmail</div>
                                    <input type="hidden" name="attendances[@i].StudentId" value="@Model[i].StudentId" />
                                    <input type="hidden" name="attendances[@i].StudentName" value="@Model[i].StudentName" />
                                    <input type="hidden" name="attendances[@i].StudentEmail" value="@Model[i].StudentEmail" />
                                </td>
                                <td class="text-center">
                                    <div class="att-status-group">
                                        <input type="radio" class="att-radio" name="attendances[@i].Status" id="pres_@i" value="PRESENT" @(Model[i].Status == "PRESENT" ? "checked" : "") />
                                        <label for="pres_@i" class="att-btn att-present">✓ Đi học</label>

                                        <input type="radio" class="att-radio" name="attendances[@i].Status" id="late_@i" value="LATE" @(Model[i].Status == "LATE" ? "checked" : "") />
                                        <label for="late_@i" class="att-btn att-late">⏰ Muộn</label>

                                        <input type="radio" class="att-radio" name="attendances[@i].Status" id="exc_@i" value="EXCUSED" @(Model[i].Status == "EXCUSED" ? "checked" : "") />
                                        <label for="exc_@i" class="att-btn att-excused">📋 Có phép</label>

                                        <input type="radio" class="att-radio" name="attendances[@i].Status" id="abs_@i" value="ABSENT" @(Model[i].Status == "ABSENT" ? "checked" : "") />
                                        <label for="abs_@i" class="att-btn att-absent">✗ Vắng</label>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" name="attendances[@i].Remarks" value="@Model[i].Remarks"
                                           placeholder="Lý do nghỉ, đi muộn..."
                                           style="width:100%;padding:0.35rem 0.6rem;border:1px solid var(--rs-line);border-radius:6px;font-size:0.8rem;background:var(--rs-surface);color:var(--rs-ink);outline:none;" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Any())
            {
                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu kết quả điểm danh
                    </button>
                </div>
            }
        </form>
    </div>
}

@section Styles {
<style>
/* ── Attendance Status Button Group ── */
.att-status-group {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    justify-content: center;
}

.att-radio {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
}

.att-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: all 0.15s ease;
    line-height: 1.3;
    white-space: nowrap;
    user-select: none;
}

/* Default – unselected */
.att-present  { background: #f0fdf4; border-color: #bbf7d0; color: #16a34a; }
.att-late     { background: #fffbeb; border-color: #fde68a; color: #d97706; }
.att-excused  { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; }
.att-absent   { background: #fef2f2; border-color: #fecaca; color: #dc2626; }

/* Selected (checked) state */
.att-radio:checked + .att-present  { background: #16a34a; border-color: #15803d; color: #fff; box-shadow: 0 2px 6px rgba(22,163,74,.35); }
.att-radio:checked + .att-late     { background: #d97706; border-color: #b45309; color: #fff; box-shadow: 0 2px 6px rgba(217,119,6,.35); }
.att-radio:checked + .att-excused  { background: #2563eb; border-color: #1d4ed8; color: #fff; box-shadow: 0 2px 6px rgba(37,99,235,.35); }
.att-radio:checked + .att-absent   { background: #dc2626; border-color: #b91c1c; color: #fff; box-shadow: 0 2px 6px rgba(220,38,38,.35); }

/* Hover on unselected */
.att-present:hover  { background: #dcfce7; }
.att-late:hover     { background: #fef3c7; }
.att-excused:hover  { background: #dbeafe; }
.att-absent:hover   { background: #fee2e2; }
</style>
}

@section Scripts {
<script>
    function markAllPresent() {
        document.querySelectorAll('input[type="radio"][value="PRESENT"]').forEach(radio => {
            radio.checked = true;
        });
    }
</script>
}
