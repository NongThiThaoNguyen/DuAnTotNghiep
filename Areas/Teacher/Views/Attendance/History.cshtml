@model IEnumerable<DuAnTotNghiep.Models.Attendance>
@{
    ViewData["Title"] = "Lịch sử điểm danh";

    var list = Model.ToList();
    var totalCount = list.Count;
    var presentCount = list.Count(r => r.Status == "PRESENT" || r.Status == "LATE");
    var absentCount = list.Count(r => r.Status == "ABSENT");
    var rate = totalCount > 0 ? (presentCount * 100.0 / totalCount) : 0;
}

<div class="max-w-7xl mx-auto py-6 px-4 space-y-6 font-sans">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 mb-4 text-sm text-emerald-800 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 mb-4 text-sm text-rose-800 rounded-xl bg-rose-50 border border-rose-200 flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
            @TempData["ErrorMessage"]
        </div>
    }
    
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 leading-tight">Lịch sử điểm danh</h1>
            <p class="text-slate-500 text-sm">Xem lịch sử chuyên cần và cập nhật thông tin điểm danh của học viên.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="@Url.Action("ExportExcel", "Attendance", new { area = "Teacher", topicId = Context.Request.Query["topicId"], startDate = Context.Request.Query["startDate"], endDate = Context.Request.Query["endDate"] })" class="px-3 py-2 text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-xl transition-all inline-flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Xuất Excel
            </a>
            <a href="@Url.Action("ExportPdf", "Attendance", new { area = "Teacher", topicId = Context.Request.Query["topicId"], startDate = Context.Request.Query["startDate"], endDate = Context.Request.Query["endDate"] })" target="_blank" class="px-3 py-2 text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-xl transition-all inline-flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                Xuất PDF
            </a>
            <a href="/Teacher/Attendance" class="px-3 py-2 text-xs font-bold text-blue-600 hover:text-blue-700 hover:bg-blue-50 border border-blue-100 rounded-xl transition-all">&larr; Quay lại điểm danh</a>
        </div>
    </div>

    <!-- Summary Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Card 1: Tổng lượt điểm danh -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Tổng lượt điểm danh</p>
                <h3 class="text-2xl font-black text-slate-900 mt-1" id="statTotalCount">@totalCount</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            </div>
        </div>

        <!-- Card 2: Có mặt & Tỷ lệ chuyên cần -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Có mặt</p>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200" id="statRateBadge">
                        @rate.ToString("0.0")% chuyên cần
                    </span>
                </div>
                <h3 class="text-2xl font-black text-emerald-600 mt-1" id="statPresentCount">@presentCount</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>

        <!-- Card 3: Vắng mặt -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Vắng mặt</p>
                <h3 class="text-2xl font-black text-rose-600 mt-1" id="statAbsentCount">@absentCount</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4">
        <!-- Form server submit for Course & Date Range -->
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end" id="historyFilterForm">
            <!-- Topic Filter -->
            <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Khóa học</label>
                <select name="topicId" asp-items="ViewBag.TopicsList" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-slate-50/50">
                    <option value="">Tất cả khóa học</option>
                </select>
            </div>

            <!-- Start Date -->
            <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Từ ngày</label>
                <input type="date" name="startDate" value="@Context.Request.Query["startDate"]" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-slate-50/50" />
            </div>

            <!-- End Date -->
            <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Đến ngày</label>
                <input type="date" name="endDate" value="@Context.Request.Query["endDate"]" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-slate-50/50" />
            </div>

            <!-- Action buttons -->
            <div class="flex gap-2">
                <button type="submit" class="flex-1 py-2 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-all shadow-sm cursor-pointer text-center">Tải dữ liệu</button>
                <a href="/Teacher/Attendance/History" class="p-2 text-sm font-bold text-slate-500 border border-slate-200 hover:bg-slate-50 rounded-xl transition-all cursor-pointer" title="Làm mới">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H12V4"></path></svg>
                </a>
            </div>
        </form>

        <hr class="border-slate-100" />

        <!-- Realtime Client Filters -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Student Search -->
            <div>
                <label for="historySearchInput" class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Tìm kiếm học viên (Realtime)</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                    <input type="text" id="historySearchInput" placeholder="Nhập tên học viên..." class="w-full pl-9 pr-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-slate-50/50" />
                </div>
            </div>

            <!-- Status Filter -->
            <div>
                <label for="historyStatusFilter" class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Lọc trạng thái điểm danh</label>
                <select id="historyStatusFilter" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-slate-50/50">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="PRESENT">✓ Có mặt</option>
                    <option value="ABSENT">✗ Vắng mặt</option>
                    <option value="LATE">⏰ Đi muộn</option>
                    <option value="EXCUSED">📋 Có phép</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Table List -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm" id="historyTable">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50/50 text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <th class="py-3.5 px-6">Ngày điểm danh</th>
                        <th class="py-3.5 px-6">Khóa học</th>
                        <th class="py-3.5 px-6">Học viên</th>
                        <th class="py-3.5 px-6 text-center" style="width: 170px;">Trạng thái</th>
                        <th class="py-3.5 px-6">Ghi chú</th>
                        <th class="py-3.5 px-6 text-end" style="width: 90px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!list.Any())
                    {
                        <tr id="emptyModelRow">
                            <td colspan="6" class="py-8 text-center text-slate-400">Không tìm thấy bản ghi điểm danh nào.</td>
                        </tr>
                    }
                    @foreach (var record in list)
                    {
                        <tr class="history-row hover:bg-slate-50/40 transition-colors"
                            data-id="@record.Id"
                            data-student="@record.Student.FullName.ToLower()"
                            data-status="@record.Status">
                            <td class="py-4 px-6 font-bold text-slate-800">@record.AttendanceDate.ToString("dd/MM/yyyy")</td>
                            <td class="py-4 px-6 font-semibold text-slate-700">@record.Topic.Title</td>
                            <td class="py-4 px-6 font-medium text-slate-600">@record.Student.FullName</td>
                            
                            <!-- Inline Editable Status -->
                            <td class="py-4 px-6 text-center">
                                <select class="status-select w-full px-2 py-1 text-xs font-bold rounded-lg border border-slate-200 focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white">
                                    <option value="PRESENT" selected="@(record.Status == "PRESENT")">✓ Có mặt</option>
                                    <option value="LATE" selected="@(record.Status == "LATE")">⏰ Đi muộn</option>
                                    <option value="EXCUSED" selected="@(record.Status == "EXCUSED")">📋 Có phép</option>
                                    <option value="ABSENT" selected="@(record.Status == "ABSENT")">✗ Vắng</option>
                                </select>
                            </td>

                            <!-- Inline Editable Remarks -->
                            <td class="py-4 px-6">
                                <input type="text" class="remarks-input w-full px-2.5 py-1 text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-blue-500 bg-slate-50/50"
                                       value="@(record.Remarks ?? "")" placeholder="Ghi chú..." />
                            </td>

                            <!-- Save Button -->
                            <td class="py-4 px-6 text-end">
                                <button type="button" class="save-row-btn px-2.5 py-1 text-xs font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-all">
                                    Lưu
                                </button>
                            </td>
                        </tr>
                    }
                    <tr id="noDataRow" style="display: none;">
                        <td colspan="6" class="py-8 text-center text-slate-400">Không tìm thấy kết quả phù hợp với bộ lọc.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Hidden AntiForgeryToken Form for AJAX -->
<form id="csrfForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('historySearchInput');
            const statusFilter = document.getElementById('historyStatusFilter');
            const rows = document.querySelectorAll('.history-row');
            const noDataRow = document.getElementById('noDataRow');

            const statTotal = document.getElementById('statTotalCount');
            const statPresent = document.getElementById('statPresentCount');
            const statAbsent = document.getElementById('statAbsentCount');
            const statRateBadge = document.getElementById('statRateBadge');

            function filterAndRecalculate() {
                const searchText = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const selectedStatus = statusFilter ? statusFilter.value.trim() : '';

                let visibleTotal = 0;
                let visiblePresent = 0;
                let visibleAbsent = 0;

                rows.forEach(function (row) {
                    const studentName = row.getAttribute('data-student') || '';
                    const currentStatus = row.getAttribute('data-status') || '';

                    const matchesSearch = !searchText || studentName.includes(searchText);
                    const matchesStatus = !selectedStatus || currentStatus === selectedStatus;

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                        visibleTotal++;

                        if (currentStatus === 'PRESENT' || currentStatus === 'LATE') {
                            visiblePresent++;
                        } else if (currentStatus === 'ABSENT') {
                            visibleAbsent++;
                        }
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noDataRow) {
                    noDataRow.style.display = (rows.length > 0 && visibleTotal === 0) ? '' : 'none';
                }

                if (statTotal) statTotal.textContent = visibleTotal;
                if (statPresent) statPresent.textContent = visiblePresent;
                if (statAbsent) statAbsent.textContent = visibleAbsent;

                if (statRateBadge) {
                    const rate = visibleTotal > 0 ? (visiblePresent * 100.0 / visibleTotal).toFixed(1) : '0.0';
                    statRateBadge.textContent = rate + '% chuyên cần';
                }
            }

            if (searchInput) searchInput.addEventListener('input', filterAndRecalculate);
            if (statusFilter) statusFilter.addEventListener('change', filterAndRecalculate);

            const tokenElement = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]');
            const csrfToken = tokenElement ? tokenElement.value : '';

            document.querySelectorAll('.save-row-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const row = btn.closest('.history-row');
                    if (!row) return;

                    const id = row.getAttribute('data-id');
                    const statusSelect = row.querySelector('.status-select');
                    const remarksInput = row.querySelector('.remarks-input');

                    const newStatus = statusSelect ? statusSelect.value : 'PRESENT';
                    const newRemarks = remarksInput ? remarksInput.value.trim() : '';

                    btn.disabled = true;
                    btn.textContent = '...';

                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('status', newStatus);
                    formData.append('remarks', newRemarks);

                    fetch('@Url.Action("UpdateRecord", "Attendance", new { area = "Teacher" })', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': csrfToken,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        btn.disabled = false;
                        btn.textContent = 'Lưu';

                        if (data.success) {
                            row.setAttribute('data-status', newStatus);
                            filterAndRecalculate();

                            btn.classList.remove('bg-blue-50', 'text-blue-700', 'border-blue-200');
                            btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                            btn.textContent = '✓ Đã lưu';

                            setTimeout(function () {
                                btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                                btn.classList.add('bg-blue-50', 'text-blue-700', 'border-blue-200');
                                btn.textContent = 'Lưu';
                            }, 1500);
                        } else {
                            alert(data.message || 'Lỗi khi cập nhật!');
                        }
                    })
                    .catch(err => {
                        btn.disabled = false;
                        btn.textContent = 'Lưu';
                        alert('Lỗi kết nối khi lưu!');
                    });
                });
            });

            document.querySelectorAll('.status-select').forEach(function (select) {
                select.addEventListener('change', function () {
                    const row = select.closest('.history-row');
                    if (row) {
                        row.setAttribute('data-status', select.value);
                        filterAndRecalculate();
                    }
                });
            });
        });
    </script>
}
