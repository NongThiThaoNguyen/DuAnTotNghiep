@model DuAnTotNghiep.Models.ViewModels.Teacher.EditCourseViewModel
@{
    ViewData["Title"] = "Chỉnh sửa khóa học";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Khóa học</span>
        <h1>Chỉnh sửa khóa học</h1>
        <p>Cập nhật thông tin hiển thị, trình độ và trạng thái của khóa học.</p>
    </div>
</div>

<div class="teacher-panel teacher-form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="teacher-form">
        <div asp-validation-summary="ModelOnly" class="teacher-validation-summary"></div>
        <input type="hidden" asp-for="Id" />

        <div class="teacher-form-grid">
            <div class="teacher-field-wide">
                <label asp-for="Title">Tên khóa học</label>
                <input asp-for="Title" required />
                <span asp-validation-for="Title" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="SkillId">Kỹ năng</label>
                <select asp-for="SkillId" required>
                    @foreach (var skill in Model.SkillOptions)
                    {
                        <option value="@skill.Id">@skill.Name</option>
                    }
                </select>
            </div>

            <div>
                <label asp-for="ProficiencyLevelId">Trình độ</label>
                <select asp-for="ProficiencyLevelId">
                    <option value="">Không chọn</option>
                    @foreach (var level in Model.LevelOptions)
                    {
                        <option value="@level.Id">@level.Code - @level.Name</option>
                    }
                </select>
            </div>

            <div>
                <label asp-for="DifficultyLevel">Độ khó</label>
                <select asp-for="DifficultyLevel" required>
                    <option value="BASIC">Cơ bản</option>
                    <option value="MEDIUM">Trung bình</option>
                    <option value="ADVANCED">Nâng cao</option>
                </select>
            </div>

            <div>
                <label asp-for="EstimatedMinutes">Thời lượng</label>
                <input asp-for="EstimatedMinutes" type="number" min="0" />
            </div>

            <div>
                <label asp-for="OrderIndex">Thứ tự</label>
                <input asp-for="OrderIndex" type="number" min="0" />
            </div>

            <div class="teacher-field-wide">
                <label class="teacher-check">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Khóa học đang hoạt động</span>
                </label>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="Description">Mô tả khóa học</label>
                <textarea asp-for="Description" rows="4"></textarea>
            </div>
        </div>

        <div class="teacher-form-actions">
            <a asp-action="Index" class="btn btn-secondary teacher-page-cancel">Hủy</a>
            <button type="button" class="btn btn-secondary teacher-modal-cancel" data-teacher-modal-close>Hủy</button>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
    </form>
</div>
