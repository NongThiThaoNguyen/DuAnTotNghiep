@model DuAnTotNghiep.Models.LearningTopic
@{
    ViewData["Title"] = "Xóa khóa học - " + Model.Title;
}

<div class="teacher-danger-shell">
    <div class="teacher-danger-header">
        <span class="teacher-danger-icon" aria-hidden="true">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </span>
        <h1>Xác nhận xóa khóa học?</h1>
        <p>Hành động này không thể hoàn tác. Các dữ liệu bài học liên quan có thể bị ảnh hưởng.</p>
    </div>

    <div class="teacher-panel teacher-danger-panel">
        <dl class="teacher-detail-grid is-compact">
            <div>
                <dt>Tên khóa học</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>Kỹ năng</dt>
                <dd>@(Model.Skill?.SkillName ?? "Tổng quát")</dd>
            </div>
            @if (Model.Level != null)
            {
                <div>
                    <dt>Trình độ</dt>
                    <dd>@Model.Level.Code (@Model.Level.Name)</dd>
                </div>
            }
        </dl>

        <form asp-action="Delete" method="post" class="teacher-form-actions">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-secondary teacher-page-cancel">Hủy</a>
            <button type="button" class="btn btn-secondary teacher-modal-cancel" data-teacher-modal-close>Hủy</button>
            <button type="submit" class="btn btn-danger">Đồng ý xóa</button>
        </form>
    </div>
</div>
