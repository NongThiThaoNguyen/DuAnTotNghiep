@model DuAnTotNghiep.Models.ViewModels.Teacher.CourseIndexViewModel
@{
    ViewData["Title"] = "Khóa học giảng dạy";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Không gian nội dung</span>
        <h1>Khóa học giảng dạy</h1>
        <p>Quản lý lộ trình, kỹ năng và bài học theo cùng một cấu trúc học thuật.</p>
    </div>
    <a asp-action="Create"
       class="btn btn-primary"
       data-teacher-modal
       data-modal-title="Tạo khóa học mới"
       data-modal-size="lg">
        <i class="fa-solid fa-plus me-1"></i> Tạo khóa học mới
    </a>
</div>

<form method="get" class="teacher-toolbar mb-4" aria-label="Bộ lọc khóa học">
    <div class="teacher-toolbar-field is-wide">
        <label for="courseSearch">Tìm kiếm</label>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="courseSearch"
                   type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Tên khóa học hoặc mã chủ đề" />
        </div>
    </div>

    <div class="teacher-toolbar-field">
        <label for="courseSkill">Kỹ năng</label>
        <select id="courseSkill" name="skill" class="form-select">
            <option value="">Tất cả kỹ năng</option>
            @foreach (var option in Model.SkillOptions)
            {
                <option value="@option.Code" selected="@(Model.Skill == option.Code ? "selected" : null)">@option.Name</option>
            }
        </select>
    </div>

    <div class="teacher-action-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
            Lọc
        </button>
        <a asp-action="Index" class="teacher-icon-button" title="Làm mới" aria-label="Làm mới bộ lọc">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </a>
    </div>
</form>

<div class="teacher-course-grid">
    @if (!Model.Courses.Any())
    {
        <div class="teacher-empty-state teacher-course-empty">
            <div>
                <i class="fa-solid fa-magnifying-glass"></i>
                <p>Không tìm thấy khóa học nào khớp với bộ lọc hiện tại.</p>
            </div>
        </div>
    }

    @foreach (var course in Model.Courses)
    {
        <article class="teacher-course-card">
        <a asp-action="Details" asp-route-id="@course.Id"
           class="teacher-course-cover teacher-course-cover--img"
           data-skill="@course.SkillCode?.ToUpper()"
           aria-label="Xem chi tiết @course.Title">
            @if (!string.IsNullOrEmpty(course.ThumbnailUrl))
            {
                <img src="@course.ThumbnailUrl"
                     alt="@course.Title"
                     class="teacher-course-thumb-img"
                     onerror="this.onerror=null; this.style.display='none';" />
            }
            <span class="teacher-course-thumb-icon" aria-hidden="true">
                <i class="fa-solid fa-graduation-cap"></i>
            </span>
            <span class="teacher-course-thumb-gradient"></span>
            <span class="teacher-status teacher-course-thumb-tag">@course.DifficultyLevel</span>
        </a>

            <div class="teacher-course-body">
                <div class="teacher-meta-pills">
                    <span class="teacher-status">@course.SkillName</span>
                    @if (!string.IsNullOrWhiteSpace(course.LevelName))
                    {
                        <span class="teacher-status is-success">@course.LevelName</span>
                    }
                    @if (!course.IsActive)
                    {
                        <span class="teacher-status">Đã ẩn</span>
                    }
                </div>

                <a asp-action="Details" asp-route-id="@course.Id" class="teacher-course-title">
                    @course.Title
                </a>
                <p>@(course.Description ?? "Chưa có mô tả chi tiết cho khóa học này.")</p>

                <div class="teacher-course-meta">
                    <span><i class="fa-solid fa-book-open" aria-hidden="true"></i> @course.LessonCount bài học</span>
                    <span><i class="fa-solid fa-users" aria-hidden="true"></i> @course.StudentCount học viên</span>
                </div>

                <div class="teacher-card-actions">
                    <a asp-action="Details" asp-route-id="@course.Id" class="teacher-icon-button" title="Xem chi tiết" aria-label="Xem chi tiết @course.Title">
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@course.Id"
                       class="teacher-icon-button"
                       title="Chỉnh sửa"
                       aria-label="Chỉnh sửa @course.Title"
                       data-teacher-modal
                       data-modal-title="Chỉnh sửa khóa học"
                       data-modal-size="lg">
                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@course.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="teacher-icon-button btn-action-delete"
                                title="Xóa"
                                aria-label="Xóa @course.Title"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa khóa học này?');">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>
        </article>
    }
</div>
