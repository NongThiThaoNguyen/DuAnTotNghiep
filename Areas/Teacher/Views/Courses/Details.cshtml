@model DuAnTotNghiep.Models.ViewModels.Teacher.CourseDetailViewModel
@{
    ViewData["Title"] = "Chi tiết khóa học - " + Model.Title;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chi tiết khóa học</span>
        <h1>@Model.Title</h1>
        <p>@(Model.Description ?? "Chưa có mô tả chi tiết cho khóa học này.")</p>
    </div>
    <div class="teacher-action-group">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Danh sách
        </a>
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary"
           data-teacher-modal
           data-modal-title="Chỉnh sửa khóa học"
           data-modal-size="lg">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            Chỉnh sửa
        </a>
    </div>
</div>

<div class="teacher-panel mb-4">
    <div class="teacher-meta-pills mb-3">
        <span class="teacher-status">Kỹ năng: @Model.SkillName</span>
        @if (!string.IsNullOrWhiteSpace(Model.LevelName))
        {
            <span class="teacher-status is-success">Trình độ: @Model.LevelCode (@Model.LevelName)</span>
        }
        <span class="teacher-status is-warning">Độ khó: @Model.DifficultyLevel</span>
    </div>

    <dl class="teacher-detail-grid">
        <div>
            <dt>Mã chủ đề</dt>
            <dd>@(Model.TopicCode ?? "N/A")</dd>
        </div>
        <div>
            <dt>Thời lượng</dt>
            <dd>@(Model.EstimatedMinutes ?? 0) phút</dd>
        </div>
        <div>
            <dt>Thứ tự</dt>
            <dd>@Model.OrderIndex</dd>
        </div>
        <div>
            <dt>Trạng thái</dt>
            <dd>@Model.Status</dd>
        </div>
    </dl>
</div>

<div class="teacher-dashboard-grid">
    <section class="teacher-panel">
        <div class="teacher-section-header">
            <div>
                <span class="teacher-section-kicker">Bài học</span>
                <h2>Bài học trong khóa (@Model.Lessons.Count)</h2>
            </div>
            <a asp-controller="Lessons" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-secondary">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Thêm bài học
            </a>
        </div>
        <div class="teacher-list">
            @if (!Model.Lessons.Any())
            {
                <div class="teacher-empty-state">Khóa học này chưa có bài học nào.</div>
            }
            @foreach (var lesson in Model.Lessons)
            {
                <div class="teacher-list-row">
                    <div>
                        <strong>@lesson.Title</strong>
                        <span>@(lesson.EstimatedMinutes ?? 0) phút · @lesson.Status</span>
                    </div>
                    <a asp-controller="Lessons" asp-action="Edit" asp-route-id="@lesson.Id" class="teacher-icon-button" title="Sửa bài học" aria-label="Sửa bài học @lesson.Title">
                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="teacher-panel">
        <div class="teacher-section-header">
            <div>
                <span class="teacher-section-kicker">Đánh giá</span>
                <h2>Bài trắc nghiệm (@Model.Quizzes.Count)</h2>
            </div>
            <a asp-controller="Quizzes" asp-action="Create" asp-route-topicId="@Model.Id" class="btn btn-secondary">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Thêm quiz
            </a>
        </div>
        <div class="teacher-list">
            @if (!Model.Quizzes.Any())
            {
                <div class="teacher-empty-state">Khóa học này chưa có bài trắc nghiệm.</div>
            }
            @foreach (var quiz in Model.Quizzes)
            {
                <div class="teacher-list-row">
                    <div>
                        <strong>@quiz.Title</strong>
                        <span>@quiz.QuestionCount câu hỏi · @quiz.Status</span>
                    </div>
                    <a asp-controller="Quizzes" asp-action="Edit" asp-route-id="@quiz.Id" class="teacher-icon-button" title="Sửa quiz" aria-label="Sửa quiz @quiz.Title">
                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
    </section>
</div>
