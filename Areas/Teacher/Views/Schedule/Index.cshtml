@model IEnumerable<DuAnTotNghiep.Models.Schedule>
@{
    ViewData["Title"] = "Lịch giảng dạy";

    // ── Week navigation ──────────────────────────────────────────────────────
    var today = DateTime.Today;
    var weekStartParam = ViewBag.WeekStart as DateTime?;
    var weekStart = weekStartParam ?? today.AddDays(-(int)(today.DayOfWeek == DayOfWeek.Sunday ? 6 : today.DayOfWeek - DayOfWeek.Monday));
    var weekEnd = weekStart.AddDays(6);
    var prevWeek = weekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = weekStart.AddDays(7).ToString("yyyy-MM-dd");

    string[] dayNames = { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "CN" };

    // ── Predefined time slots ────────────────────────────────────────────────
    var timeSlots = new[]
    {
        (Start: 7,  End: 9,  Label: "07:00 – 09:00"),
        (Start: 9,  End: 11, Label: "09:00 – 11:00"),
        (Start: 11, End: 13, Label: "11:00 – 13:00"),
        (Start: 13, End: 15, Label: "13:00 – 15:00"),
        (Start: 15, End: 17, Label: "15:00 – 17:00"),
        (Start: 17, End: 19, Label: "17:00 – 19:00"),
        (Start: 19, End: 21, Label: "19:00 – 21:00"),
    };

    // Group schedules by (dayOfWeek, slotIndex)
    // A schedule fits a slot if its start hour overlaps
    Schedule? GetSlot(DateTime day, int slotStart, int slotEnd)
    {
        return Model.FirstOrDefault(s =>
            s.StartTime.Date == day.Date &&
            s.StartTime.Hour >= slotStart && s.StartTime.Hour < slotEnd);
    }

    string[] cardColors = {
        "#e8f4fd,#2196f3", "#fce8fd,#9c27b0", "#e8fdf0,#43a047",
        "#fdf6e8,#f57c00", "#fdecea,#e53935", "#e8f0fd,#3f51b5",
        "#fdf8e8,#f9a825"
    };
    var colorMap = new Dictionary<int, string>();
    int ci = 0;
    foreach (var s in Model) { if (!colorMap.ContainsKey(s.Id)) { colorMap[s.Id] = cardColors[ci++ % cardColors.Length]; } }

    string Bg(int id)  => colorMap.ContainsKey(id) ? colorMap[id].Split(',')[0] : "#f5f5f5";
    string Acc(int id) => colorMap.ContainsKey(id) ? colorMap[id].Split(',')[1] : "#888";
}

<style>
/* ── Timetable ──────────────────────────────────────────────────── */
:root {
    --tt-border: #e8ecf0;
    --tt-head-bg: #f7f9fc;
    --tt-today: #fffbeb;
    --tt-today-head: #fef3c7;
    --tt-slot-w: 90px;
    --tt-row-h: 96px;
    --tt-radius: 10px;
    --tt-font: 'Inter', 'Segoe UI', sans-serif;
}
.tt-wrap {
    font-family: var(--tt-font);
    background: #fff;
    border: 1px solid var(--tt-border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
}
/* ── Week nav bar ── */
.tt-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--tt-border);
    background: var(--tt-head-bg);
    gap: 8px;
    flex-wrap: wrap;
}
.tt-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid var(--tt-border);
    background: #fff;
    font-size: .78rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    text-decoration: none;
    transition: all .15s;
}
.tt-nav-btn:hover { background: #f1f5f9; border-color: #94a3b8; color: #111; }
.tt-nav-btn.today { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
.tt-nav-btn.today:hover { background: #1e40af; }
.tt-week-label {
    font-size: .92rem;
    font-weight: 700;
    color: #111827;
    text-align: center;
    flex: 1;
}
.tt-week-sub {
    font-size: .7rem;
    font-weight: 600;
    color: #f59e0b;
    letter-spacing: .06em;
    text-transform: uppercase;
    display: block;
}

/* ── Grid ── */
.tt-grid {
    display: grid;
    grid-template-columns: var(--tt-slot-w) repeat(7, 1fr);
    overflow-x: auto;
}
.tt-head-row {
    display: contents;
}
.tt-head-cell {
    padding: 10px 8px 8px;
    text-align: center;
    background: var(--tt-head-bg);
    border-bottom: 2px solid var(--tt-border);
    border-right: 1px solid var(--tt-border);
    position: sticky;
    top: 0;
    z-index: 2;
}
.tt-head-cell:first-child { border-right: 2px solid var(--tt-border); }
.tt-head-day { font-size: .72rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .06em; }
.tt-head-date {
    width: 30px; height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .9rem;
    font-weight: 800;
    color: #374151;
    margin: 3px auto 0;
}
.tt-head-cell.is-today { background: var(--tt-today-head); }
.tt-head-cell.is-today .tt-head-date {
    background: #f59e0b;
    color: #fff;
    box-shadow: 0 2px 8px rgba(245,158,11,.4);
}
/* slot label column */
.tt-slot-label {
    padding: 8px 10px;
    text-align: right;
    font-size: .68rem;
    font-weight: 700;
    color: #9ca3af;
    border-right: 2px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
    background: var(--tt-head-bg);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    line-height: 1.3;
}
.tt-cell {
    height: var(--tt-row-h);
    border-right: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
    padding: 6px;
    position: relative;
    transition: background .12s;
    vertical-align: top;
}
.tt-cell.is-today-col { background: var(--tt-today); }
.tt-cell.is-past { opacity: .55; }
.tt-cell:hover { background: #f8faff; }
.tt-cell-add {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .15s;
    cursor: pointer;
}
.tt-cell:hover .tt-cell-add { opacity: 1; }
.tt-cell-add-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #e0e7ff;
    color: #4338ca;
    border: 1.5px dashed #6366f1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .75rem;
}

/* ── Event card ── */
.tt-event {
    border-radius: 8px;
    padding: 7px 9px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 3px;
    cursor: pointer;
    text-decoration: none;
    border-left: 3px solid;
    transition: transform .12s, box-shadow .12s;
    overflow: hidden;
}
.tt-event:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }
.tt-event-name {
    font-size: .75rem;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tt-event-time { font-size: .65rem; font-weight: 600; opacity: .72; }
.tt-event-room { font-size: .65rem; opacity: .65; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tt-event-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 20px;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    width: fit-content;
}
.tt-now-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse 1.5s infinite;
    display: inline-block;
    margin-right: 3px;
}
@@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.25)} }

/* ── List below ── */
.tt-list-wrap {
    background: #fff;
    border: 1px solid var(--tt-border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    margin-top: 1.25rem;
}
.tt-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--tt-border);
    background: var(--tt-head-bg);
    gap: 10px;
    flex-wrap: wrap;
}
.tt-search {
    position: relative;
    flex: 1;
    min-width: 200px;
}
.tt-search input {
    width: 100%;
    padding: 7px 14px 7px 36px;
    border: 1px solid var(--tt-border);
    border-radius: 10px;
    font-size: .82rem;
    background: #fff;
    outline: none;
    transition: border-color .15s;
}
.tt-search input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }
.tt-search-icon {
    position: absolute;
    left: 11px; top: 50%;
    transform: translateY(-50%);
    color: #9ca3af;
    font-size: .82rem;
}
table.tt-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
.tt-table thead th { padding: 10px 14px; background: var(--tt-head-bg); font-weight: 700; font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; border-bottom: 1px solid var(--tt-border); }
.tt-table tbody tr { transition: background .1s; }
.tt-table tbody tr:hover { background: #f8faff; }
.tt-table tbody td { padding: 11px 14px; border-bottom: 1px solid #f1f5f9; color: #374151; vertical-align: middle; }
.tt-table .pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: .7rem;
    font-weight: 700;
}
.pill-online { background: #eff6ff; color: #2563eb; }
.pill-offline { background: #f0fdf4; color: #16a34a; }
.pill-done { background: #f1f5f9; color: #64748b; }
.pill-now { background: #dcfce7; color: #15803d; }
.pill-coming { background: #fef3c7; color: #d97706; }
</style>

<div class="px-4" style="max-width:1280px;margin:0 auto;padding-top:4px;">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-5 border-b border-slate-100 pb-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900">Lịch giảng dạy</h1>
            <p class="text-slate-500 text-sm mt-0.5">Thời khóa biểu — lớp trực tiếp &amp; trực tuyến của bạn.</p>
        </div>
        <a href="/Teacher/Schedule/Create" class="tt-nav-btn" style="background:#4f46e5;color:#fff;border-color:#4338ca;padding:9px 18px;">
            <i class="fa-solid fa-plus"></i> Thêm lịch dạy
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium mb-4">
            <i class="fa-solid fa-circle-check text-emerald-500"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- ═══════════════ TIMETABLE GRID ═══════════════ -->
    <div class="tt-wrap">
        <!-- Nav bar -->
        <div class="tt-nav">
            <a href="/Teacher/Schedule?weekStart=@prevWeek" class="tt-nav-btn">
                <i class="fa-solid fa-chevron-left"></i> Tuần trước
            </a>

            <div class="tt-week-label">
                @(weekStart.Month == weekEnd.Month
                    ? $"{weekStart:dd} – {weekEnd:dd} tháng {weekEnd.Month}/{weekEnd.Year}"
                    : $"{weekStart:dd/MM} – {weekEnd:dd/MM/yyyy}")
                @if (weekStart <= today && today <= weekEnd)
                {
                    <span class="tt-week-sub">✦ Tuần này</span>
                }
            </div>

            <div style="display:flex;gap:6px;">
                <a href="/Teacher/Schedule" class="tt-nav-btn today">Hôm nay</a>
                <a href="/Teacher/Schedule?weekStart=@nextWeek" class="tt-nav-btn">
                    Tuần sau <i class="fa-solid fa-chevron-right"></i>
                </a>
            </div>
        </div>

        <!-- Grid -->
        <div class="tt-grid">

            <!-- Header row -->
            <div class="tt-head-cell" style="background:#f7f9fc;border-right:2px solid #e8ecf0;">
                <div class="tt-head-day" style="color:#d1d5db;font-size:.65rem;">CA DẠY</div>
            </div>
            @for (int d = 0; d < 7; d++)
            {
                var day = weekStart.AddDays(d);
                var isToday = day.Date == today;
                <div class="tt-head-cell @(isToday ? "is-today" : "")">
                    <div class="tt-head-day">@dayNames[d]</div>
                    <div class="tt-head-date">@day.Day</div>
                    @if (isToday)
                    {
                        <div style="font-size:.58rem;color:#f59e0b;font-weight:700;letter-spacing:.05em;margin-top:1px;">HÔM NAY</div>
                    }
                    else
                    {
                        <div style="font-size:.62rem;color:#d1d5db;margin-top:1px;">@day.ToString("dd/MM")</div>
                    }
                </div>
            }

            <!-- Time slot rows -->
            @foreach (var slot in timeSlots)
            {
                <!-- Slot label -->
                <div class="tt-slot-label">@slot.Label</div>

                @for (int d = 0; d < 7; d++)
                {
                    var day = weekStart.AddDays(d);
                    var isToday = day.Date == today;
                    var isPast = day.Date < today || (day.Date == today && slot.End <= DateTime.Now.Hour);
                    var ev = GetSlot(day, slot.Start, slot.End);
                    var createUrl = $"/Teacher/Schedule/Create";

                    <div class="tt-cell @(isToday ? "is-today-col" : "") @(isPast && ev == null ? "is-past" : "")">
                        @if (ev != null)
                        {
                            var bg = Bg(ev.Id);
                            var acc = Acc(ev.Id);
                            var isNow = ev.StartTime <= DateTime.Now && DateTime.Now <= ev.EndTime;
                            var isDone = ev.EndTime < DateTime.Now;
                            <a href="/Teacher/Schedule/Edit/@ev.Id" class="tt-event"
                               style="background:@bg;border-left-color:@acc;color:#1e293b;">
                                <div class="tt-event-name" title="@ev.Title">
                                    @if (isNow) { <span class="tt-now-dot"></span> }
                                    @ev.Title
                                </div>
                                <div class="tt-event-time">
                                    <i class="fa-regular fa-clock" style="font-size:.6rem;"></i>
                                    @ev.StartTime.ToString("HH:mm") – @ev.EndTime.ToString("HH:mm")
                                </div>
                                @if (!string.IsNullOrEmpty(ev.Classroom))
                                {
                                    <div class="tt-event-room">
                                        <i class="fa-solid fa-location-dot" style="font-size:.6rem;"></i>
                                        @ev.Classroom
                                    </div>
                                }
                                @if (ev.Topic != null)
                                {
                                    <div class="tt-event-room" style="font-weight:600;opacity:.8;">@ev.Topic.Title</div>
                                }
                                <div style="margin-top:auto;">
                                    @if (isNow)
                                    {
                                        <span class="tt-event-badge" style="background:@acc;color:#fff;opacity:.9;">Đang dạy</span>
                                    }
                                    else if (isDone)
                                    {
                                        <span class="tt-event-badge" style="background:rgba(0,0,0,.06);color:#64748b;">Đã xong</span>
                                    }
                                    else
                                    {
                                        <span class="tt-event-badge" style="background:@Opacity22(acc);color:@acc;">Sắp dạy</span>
                                    }
                                </div>
                            </a>
                        }
                        else if (!isPast)
                        {
                            <a href="@createUrl" class="tt-cell-add" title="Thêm lịch dạy">
                                <div class="tt-cell-add-icon">
                                    <i class="fa-solid fa-plus"></i>
                                </div>
                            </a>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- ═══════════════ LIST TABLE ═══════════════ -->
    <div class="tt-list-wrap">
        <div class="tt-list-head">
            <div style="font-size:.82rem;font-weight:700;color:#374151;display:flex;align-items:center;gap:6px;">
                <i class="fa-solid fa-list text-slate-400"></i>
                Danh sách lịch dạy
                <span style="background:#e0e7ff;color:#4338ca;border-radius:20px;padding:1px 9px;font-size:.72rem;font-weight:800;">@Model.Count()</span>
            </div>
            <form method="get" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <input type="hidden" name="weekStart" value="@weekStart.ToString("yyyy-MM-dd")" />
                <div class="tt-search">
                    <i class="fa-solid fa-magnifying-glass tt-search-icon"></i>
                    <input type="text" name="keyword" value="@(ViewBag.Keyword as string)"
                           placeholder="Tìm tiêu đề, phòng học..." />
                </div>
                <button type="submit" class="tt-nav-btn" style="background:#4f46e5;color:#fff;border-color:#4338ca;">Tìm</button>
                <a href="/Teacher/Schedule?weekStart=@weekStart.ToString("yyyy-MM-dd")" class="tt-nav-btn" title="Làm mới">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </form>
        </div>

        <div style="overflow-x:auto;">
            <table class="tt-table">
                <thead>
                    <tr>
                        <th>Tiêu đề / Sự kiện</th>
                        <th>Khóa học</th>
                        <th>Thời gian</th>
                        <th>Phòng học</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;padding:52px 0;color:#9ca3af;">
                                <i class="fa-regular fa-calendar-xmark" style="font-size:2rem;display:block;margin-bottom:10px;"></i>
                                <span style="font-size:.85rem;">Chưa có lịch dạy nào trong tuần này.</span><br />
                                <a href="/Teacher/Schedule/Create" style="color:#4f46e5;font-weight:700;font-size:.8rem;text-decoration:none;">+ Thêm lịch dạy mới</a>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.OrderBy(s => s.StartTime))
                    {
                        var isOnline = string.IsNullOrEmpty(item.Classroom)
                                       || item.Classroom.ToLower().Contains("online")
                                       || item.Classroom.ToLower().Contains("zoom")
                                       || item.Classroom.ToLower().Contains("meet");
                        var isPast  = item.EndTime < DateTime.Now;
                        var isNow   = item.StartTime <= DateTime.Now && DateTime.Now <= item.EndTime;
                        var bg      = Bg(item.Id);
                        var acc     = Acc(item.Id);
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:4px;height:36px;border-radius:4px;background:@acc;flex-shrink:0;"></div>
                                    <div>
                                        <div style="font-weight:700;color:#1e293b;">@item.Title</div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div style="font-size:.7rem;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;">@item.Description</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.Topic != null)
                                {
                                    <span style="background:#f0f4ff;color:#4338ca;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;">
                                        <i class="fa-solid fa-book-open" style="font-size:.6rem;"></i>
                                        @item.Topic.Title
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#d1d5db;font-style:italic;font-size:.78rem;">—</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                <div style="font-weight:700;font-size:.8rem;">@item.StartTime.ToString("dd/MM/yyyy")</div>
                                <div style="color:#6b7280;font-size:.72rem;">@item.StartTime.ToString("HH:mm") – @item.EndTime.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (isOnline)
                                {
                                    <span class="pill pill-online"><i class="fa-solid fa-video" style="font-size:.62rem;"></i>@(item.Classroom ?? "Online")</span>
                                }
                                else
                                {
                                    <span class="pill pill-offline"><i class="fa-solid fa-building" style="font-size:.62rem;"></i>@item.Classroom</span>
                                }
                            </td>
                            <td>
                                @if (isNow)
                                {
                                    <span class="pill pill-now"><span class="tt-now-dot" style="width:5px;height:5px;"></span>Đang dạy</span>
                                }
                                else if (isPast)
                                {
                                    <span class="pill pill-done">Đã xong</span>
                                }
                                else
                                {
                                    <span class="pill pill-coming"><i class="fa-regular fa-clock" style="font-size:.62rem;"></i>Sắp dạy</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div style="display:flex;justify-content:flex-end;gap:6px;">
                                    <a href="/Teacher/Schedule/Edit/@item.Id"
                                       style="display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:8px;background:#eff6ff;color:#2563eb;font-size:.72rem;font-weight:700;text-decoration:none;border:1px solid #bfdbfe;">
                                        <i class="fa-solid fa-pen-to-square" style="font-size:.6rem;"></i> Sửa
                                    </a>
                                    <a href="/Teacher/Schedule/Delete/@item.Id"
                                       style="display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;background:#fef2f2;color:#ef4444;font-size:.72rem;font-weight:700;text-decoration:none;border:1px solid #fecaca;">
                                        <i class="fa-solid fa-trash" style="font-size:.6rem;"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Fix Razor compile error: @acc22 not defined *@
@functions {
    string Opacity22(string hex) {
        // Make a CSS rgba from hex at ~22% opacity for badge background
        if (hex.StartsWith("#") && hex.Length == 7) {
            try {
                int r = Convert.ToInt32(hex.Substring(1,2),16);
                int g = Convert.ToInt32(hex.Substring(3,2),16);
                int b = Convert.ToInt32(hex.Substring(5,2),16);
                return $"rgba({r},{g},{b},.15)";
            } catch { }
        }
        return "#f0f0f0";
    }
}
