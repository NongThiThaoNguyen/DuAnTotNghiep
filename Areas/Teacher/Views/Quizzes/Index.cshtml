@model DuAnTotNghiep.Models.ViewModels.Teacher.QuizIndexViewModel
@{
    ViewData["Title"] = "Quiz - " + Model.TopicTitle;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Quiz</span>
        <h1>Quản lý Quiz</h1>
        <p>@Model.TopicTitle</p>
    </div>
    <div class="teacher-action-group">
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.TopicId" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Khóa học
        </a>
        <a asp-action="Create"
           asp-route-topicId="@Model.TopicId"
           class="btn btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Tạo Quiz
        </a>
    </div>
</div>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Tên Quiz</th>
                <th class="text-center">Câu hỏi</th>
                <th class="text-center">Lượt làm</th>
                <th class="text-center">Điểm TB</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Quizzes.Any())
            {
                <tr>
                    <td colspan="6" class="teacher-empty-row">Khóa học này chưa có Quiz nào.</td>
                </tr>
            }
            @foreach (var quiz in Model.Quizzes)
            {
                <tr>
                    <td>
                        <div class="teacher-table-title">
                            <strong>@quiz.Title</strong>
                            <span>@(quiz.Description ?? "Không có mô tả.")</span>
                        </div>
                    </td>
                    <td class="text-center teacher-number">@quiz.QuestionCount</td>
                    <td class="text-center teacher-number">@quiz.AttemptCount</td>
                    <td class="text-center teacher-number">@quiz.AverageScore.ToString("0.0")</td>
                    <td class="text-center"><span class="teacher-status">@quiz.Status</span></td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Results" asp-route-id="@quiz.Id" class="btn btn-secondary">Kết quả</a>
                            <a asp-action="ManageQuestions" asp-route-id="@quiz.Id" class="btn btn-secondary">
                                <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                Câu hỏi
                            </a>
                            <a asp-action="Edit"
                               asp-route-id="@quiz.Id"
                               class="teacher-icon-button"
                               title="Sửa"
                               aria-label="Sửa @quiz.Title"
                               data-teacher-modal
                               data-modal-title="Chỉnh sửa Quiz"
                               data-modal-size="lg">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@quiz.Id" asp-route-topicId="@Model.TopicId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="teacher-icon-button btn-action-delete"
                                        title="Xóa"
                                        aria-label="Xóa @quiz.Title"
                                        onclick="return confirm('Bạn có chắc chắn muốn xóa Quiz này?');">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
