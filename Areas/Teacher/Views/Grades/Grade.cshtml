@model DuAnTotNghiep.Models.ViewModels.Teacher.PracticeSubmissionDetailViewModel
@{
    ViewData["Title"] = "Chấm bài";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chấm bài</span>
        <h1>@Model.TaskTitle</h1>
        <p>@Model.StudentName · @Model.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <a asp-action="Pending" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Bài chờ chấm
    </a>
</div>

<div class="teacher-grading-layout">
    <div class="teacher-dashboard-main">
        <section class="teacher-panel">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Yêu cầu</span>
                    <h2>Đề bài</h2>
                </div>
            </div>
            <div class="teacher-submission-box">@Model.TaskDescription</div>
        </section>

        <section class="teacher-panel">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Bài làm</span>
                    <h2>Nội dung học viên nộp</h2>
                </div>
            </div>
            <div class="teacher-submission-box">
                @if (string.IsNullOrWhiteSpace(Model.StudentAnswer))
                {
                    <span class="teacher-muted">Không có nội dung văn bản.</span>
                }
                else
                {
                    @Model.StudentAnswer
                }

                @if (!string.IsNullOrWhiteSpace(Model.FileUrl))
                {
                    <div class="teacher-callout mt-3">
                        <span>Tệp đính kèm</span>
                        <a href="@Model.FileUrl" target="_blank" rel="noopener">Xem tệp tài liệu</a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
                {
                    <div class="teacher-callout mt-3">
                        <span>Bản ghi âm</span>
                        <audio controls>
                            <source src="@Model.AudioUrl" type="audio/mpeg" />
                            Trình duyệt của bạn không hỗ trợ phát âm thanh.
                        </audio>
                    </div>
                }
            </div>
        </section>
    </div>

    <aside class="teacher-panel teacher-grading-panel">
        <div class="teacher-section-header">
            <div>
                <span class="teacher-section-kicker">Giáo viên</span>
                <h2>Điểm và phản hồi</h2>
            </div>
        </div>

        <form asp-action="Grade" asp-route-id="@Model.Id" method="post" class="teacher-form">
            <div>
                <label for="score">Điểm</label>
                <input id="score" name="score" value="@Model.Score" type="number" step="0.1" min="0" max="100" required />
                <p class="teacher-field-help">Nhập điểm từ 0.0 đến 100.0.</p>
            </div>
            <div>
                <label for="feedback">Phản hồi</label>
                <textarea id="feedback" name="feedback" rows="5">@Model.TeacherFeedback</textarea>
            </div>
            <div class="teacher-form-actions">
                <a asp-action="Pending" class="btn btn-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">Lưu điểm</button>
            </div>
        </form>
    </aside>
</div>
