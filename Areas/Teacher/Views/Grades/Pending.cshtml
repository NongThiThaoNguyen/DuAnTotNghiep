@model List<DuAnTotNghiep.Models.ViewModels.Teacher.PendingSubmissionViewModel>
@{
    ViewData["Title"] = "Bài chờ chấm";
    var pendingCount = ViewBag.PendingCount as int? ?? Model.Count;
    var courseOptions = ViewBag.CourseOptions as List<string> ?? new List<string>();
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chấm điểm</span>
        <h1>
            Bài chờ chấm
            @if (pendingCount > 0)
            {
                <span class="badge bg-danger ms-2" id="pendingCountBadge" style="font-size: 0.55em; vertical-align: middle; border-radius: 20px; padding: 4px 12px;">@pendingCount</span>
            }
        </h1>
        <p>Các bài thực hành học viên đã nộp và đang chờ giáo viên phản hồi.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-table-list" aria-hidden="true"></i>
        Sổ điểm
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Toolbar tìm kiếm & lọc -->
<div class="teacher-toolbar mb-4">
    <div class="teacher-toolbar-field is-wide">
        <label for="pendingSearchInput">Tìm kiếm</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="pendingSearchInput" class="form-control" placeholder="Nhập tên học viên hoặc tên bài tập..." />
        </div>
    </div>

    <div class="teacher-toolbar-field">
        <label for="pendingCourseFilter">Khóa học</label>
        <select id="pendingCourseFilter" class="form-select">
            <option value="">-- Tất cả khóa học --</option>
            @foreach (var course in courseOptions)
            {
                <option value="@course">@course</option>
            }
        </select>
    </div>
</div>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0" id="pendingTable">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Bài tập</th>
                <th>Khóa học</th>
                <th class="text-center">Ngày nộp</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr id="emptyModelRow">
                    <td colspan="5" class="teacher-empty-row">Không có bài chờ chấm.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="pending-row"
                        data-student="@item.StudentName.ToLower()"
                        data-task="@item.TaskTitle.ToLower()"
                        data-course="@item.TopicName.ToLower()">
                        <td><strong>@item.StudentName</strong></td>
                        <td>@item.TaskTitle</td>
                        <td>@item.TopicName</td>
                        <td class="text-center">@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="teacher-action-group">
                                <a asp-action="Grade" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Chấm bài
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            <tr id="noDataRow" style="display: none;">
                <td colspan="5" class="teacher-empty-row">Không tìm thấy bài tập phù hợp.</td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('pendingSearchInput');
            const courseFilter = document.getElementById('pendingCourseFilter');
            const rows = document.querySelectorAll('.pending-row');
            const noDataRow = document.getElementById('noDataRow');
            const badge = document.getElementById('pendingCountBadge');

            function filterTable() {
                const searchText = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const selectedCourse = courseFilter ? courseFilter.value.trim().toLowerCase() : '';
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const studentName = row.getAttribute('data-student') || '';
                    const taskTitle = row.getAttribute('data-task') || '';
                    const courseName = row.getAttribute('data-course') || '';

                    const matchesSearch = !searchText ||
                        studentName.includes(searchText) ||
                        taskTitle.includes(searchText);
                    const matchesCourse = !selectedCourse || courseName === selectedCourse;

                    if (matchesSearch && matchesCourse) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noDataRow) {
                    noDataRow.style.display = (rows.length > 0 && visibleCount === 0) ? '' : 'none';
                }

                if (badge) {
                    badge.textContent = visibleCount;
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', filterTable);
            }
            if (courseFilter) {
                courseFilter.addEventListener('change', filterTable);
            }
        });
    </script>
}

