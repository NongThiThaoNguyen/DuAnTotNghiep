@model List<DuAnTotNghiep.Models.ViewModels.Teacher.PendingSubmissionViewModel>
@{
    ViewData["Title"] = "Bài chờ chấm";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chấm điểm</span>
        <h1>Bài chờ chấm</h1>
        <p>Các bài thực hành học viên đã nộp và đang chờ giáo viên phản hồi.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-table-list" aria-hidden="true"></i>
        Sổ điểm
    </a>
</div>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Bài tập</th>
                <th class="text-center">Ngày nộp</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="teacher-empty-row">Không có bài chờ chấm.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.StudentName</strong></td>
                    <td>@item.TaskTitle</td>
                    <td class="text-center">@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Grade" asp-route-id="@item.Id" class="btn btn-primary">Chấm điểm</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
