@model IEnumerable<DuAnTotNghiep.Models.PracticeTask>
@{
    ViewData["Title"] = "Quản lý Bài tập";
    var keyword = ViewBag.Keyword as string;
    var topicId = ViewBag.TopicId as int?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Đánh giá thực hành</span>
        <h1>Quản lý bài tập</h1>
        <p>Tạo và theo dõi bài viết, luyện nghe, trắc nghiệm ngắn và bài thực hành kỹ năng.</p>
    </div>
    <div class="teacher-action-group">
        <a asp-action="Submissions" class="btn btn-secondary">
            <i class="fa-solid fa-inbox" aria-hidden="true"></i>
            Bài học viên nộp
        </a>
        <a asp-action="Create"
           asp-route-topicId="@topicId"
           class="btn btn-primary"
           data-teacher-modal
           data-modal-title="Thêm bài tập mới"
           data-modal-size="lg">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Thêm bài tập
        </a>
    </div>
</div>

<form method="get" class="teacher-toolbar mb-4" aria-label="Bộ lọc bài tập">
    <div class="teacher-toolbar-field is-wide">
        <label for="assignmentKeyword">Tìm kiếm</label>
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="assignmentKeyword" type="text" name="keyword" value="@keyword" placeholder="Tên bài tập hoặc từ khóa" />
        </div>
    </div>

    <div class="teacher-toolbar-field">
        <label for="assignmentTopic">Khóa học</label>
        <select id="assignmentTopic" name="topicId" asp-items="ViewBag.Topics" class="form-select">
            <option value="">Tất cả khóa học</option>
        </select>
    </div>

    <div class="teacher-action-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
            Lọc
        </button>
        <a asp-action="Index" class="teacher-icon-button" title="Làm mới" aria-label="Làm mới bộ lọc">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </a>
    </div>
</form>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Bài tập</th>
                <th>Khóa học</th>
                <th class="text-center">Dạng bài</th>
                <th class="text-center">Độ khó</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="teacher-empty-row">Không tìm thấy bài tập nào.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="teacher-table-title">
                            <strong>@item.Title</strong>
                            <span>@item.Instruction</span>
                        </div>
                    </td>
                    <td>@(item.Topic?.Title ?? "Tổng quát")</td>
                    <td class="text-center"><span class="teacher-status">@item.TaskType</span></td>
                    <td class="text-center teacher-number">@item.DifficultyLevel</td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Submissions" asp-route-taskId="@item.Id" class="btn btn-secondary">Bài nộp</a>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="teacher-icon-button"
                               title="Sửa"
                               aria-label="Sửa @item.Title"
                               data-teacher-modal
                               data-modal-title="Chỉnh sửa bài tập"
                               data-modal-size="lg">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="teacher-icon-button btn-action-delete"
                               title="Xóa"
                               aria-label="Xóa @item.Title"
                               data-teacher-modal
                               data-modal-title="Xóa bài tập"
                               data-modal-size="md">
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="teacher-pagination" aria-label="Phân trang bài tập">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="/Teacher/Assignments?page=@p&keyword=@keyword&topicId=@topicId"
               class="btn @(currentPage == p ? "btn-primary" : "btn-secondary")"
               aria-current="@(currentPage == p ? "page" : null)">
                @p
            </a>
        }
    </nav>
}
