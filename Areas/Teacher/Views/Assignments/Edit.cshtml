@model DuAnTotNghiep.Models.PracticeTask
@{
    ViewData["Title"] = "Chỉnh sửa bài tập";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Bài tập</span>
        <h1>Chỉnh sửa bài tập</h1>
        <p>Cập nhật đề bài, kỹ năng, độ khó và trạng thái giao bài.</p>
    </div>
</div>

<div class="teacher-panel teacher-form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="teacher-form">
        <div asp-validation-summary="ModelOnly" class="teacher-validation-summary"></div>
        <input type="hidden" asp-for="Id" />

        <div class="teacher-form-grid">
            <div class="teacher-field-wide">
                <label asp-for="Title">Tên bài tập</label>
                <input asp-for="Title" required />
                <span asp-validation-for="Title" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="TopicId">Khóa học đính kèm</label>
                <select asp-for="TopicId" asp-items="ViewBag.TopicId" required></select>
                <span asp-validation-for="TopicId" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="SkillId">Kỹ năng đánh giá</label>
                <select asp-for="SkillId" asp-items="ViewBag.SkillId" required></select>
                <span asp-validation-for="SkillId" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="TaskType">Dạng bài tập</label>
                <select asp-for="TaskType" required>
                    <option value="SHORT_ANSWER">Trả lời ngắn</option>
                    <option value="MCQ">Trắc nghiệm</option>
                    <option value="TRUE_FALSE">Đúng / Sai</option>
                    <option value="LISTENING">Luyện nghe</option>
                </select>
                <span asp-validation-for="TaskType" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="DifficultyLevel">Độ khó</label>
                <select asp-for="DifficultyLevel" required>
                    <option value="BASIC">Cơ bản</option>
                    <option value="MEDIUM">Trung bình</option>
                    <option value="ADVANCED">Nâng cao</option>
                </select>
                <span asp-validation-for="DifficultyLevel" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="Status">Trạng thái giao bài</label>
                <select asp-for="Status" required>
                    <option value="PUBLISHED">Đã giao</option>
                    <option value="DRAFT">Bản nháp</option>
                    <option value="PENDING">Chờ duyệt</option>
                    <option value="ARCHIVED">Lưu trữ</option>
                </select>
                <span asp-validation-for="Status" class="teacher-field-error"></span>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="Instruction">Yêu cầu & đề bài</label>
                <textarea asp-for="Instruction" rows="6" required></textarea>
                <span asp-validation-for="Instruction" class="teacher-field-error"></span>
            </div>
        </div>

        <div class="teacher-form-actions">
            <a asp-action="Index" class="btn btn-secondary teacher-page-cancel">Hủy</a>
            <button type="button" class="btn btn-secondary teacher-modal-cancel" data-teacher-modal-close>Hủy</button>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
    </form>
</div>
