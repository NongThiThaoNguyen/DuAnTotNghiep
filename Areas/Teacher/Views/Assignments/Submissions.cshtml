@model IEnumerable<DuAnTotNghiep.Models.PracticeSubmission>
@{
    ViewData["Title"] = "Bài tập học viên nộp";
    var taskId = ViewBag.TaskId as int?;
    var status = ViewBag.Status as string;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Bài nộp</span>
        <h1>Bài làm học viên nộp</h1>
        <p>Chấm điểm và phản hồi bài thực hành kỹ năng của học viên.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Danh sách bài tập
    </a>
</div>

<form method="get" class="teacher-toolbar mb-4" aria-label="Bộ lọc bài nộp">
    <div class="teacher-toolbar-field is-wide">
        <label for="submissionTask">Bài tập</label>
        <select id="submissionTask" name="taskId" asp-items="ViewBag.Tasks" class="form-select">
            <option value="">Tất cả bài tập</option>
        </select>
    </div>

    <div class="teacher-toolbar-field">
        <label for="submissionStatus">Trạng thái</label>
        <select id="submissionStatus" name="status" class="form-select">
            <option value="">Tất cả</option>
            <option value="SUBMITTED" selected="@(status == "SUBMITTED" ? "selected" : null)">Học viên mới nộp</option>
            <option value="AI_REVIEWED" selected="@(status == "AI_REVIEWED" ? "selected" : null)">AI đã nhận xét</option>
            <option value="TEACHER_REVIEWED" selected="@(status == "TEACHER_REVIEWED" ? "selected" : null)">Giáo viên đã chấm</option>
            <option value="GRADED" selected="@(status == "GRADED" ? "selected" : null)">Đã chấm</option>
        </select>
    </div>

    <div class="teacher-action-group">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
            Lọc
        </button>
        <a asp-action="Submissions" class="teacher-icon-button" title="Làm mới" aria-label="Làm mới bộ lọc">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </a>
    </div>
</form>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Đề bài</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Điểm số</th>
                <th class="text-center">Thời gian nộp</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="teacher-empty-row">Không tìm thấy bài nộp nào.</td>
                </tr>
            }
            @foreach (var sub in Model)
            {
                <tr>
                    <td><strong>@sub.Student.FullName</strong></td>
                    <td>@sub.PracticeTask.Title</td>
                    <td class="text-center">
                        <span class="teacher-status @(sub.Status == "SUBMITTED" ? "is-warning" : "is-success")">@sub.Status</span>
                    </td>
                    <td class="text-center teacher-number">@(sub.Score.HasValue ? sub.Score.Value.ToString("0.0") + "đ" : "Chưa chấm")</td>
                    <td class="text-center">@sub.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Grade" asp-route-id="@sub.Id" class="btn btn-primary">
                                @(sub.Status == "TEACHER_REVIEWED" || sub.Status == "GRADED" ? "Xem lại" : "Chấm điểm")
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="teacher-pagination" aria-label="Phân trang bài nộp">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="/Teacher/Assignments/Submissions?page=@p&taskId=@taskId&status=@status"
               class="btn @(currentPage == p ? "btn-primary" : "btn-secondary")"
               aria-current="@(currentPage == p ? "page" : null)">
                @p
            </a>
        }
    </nav>
}
