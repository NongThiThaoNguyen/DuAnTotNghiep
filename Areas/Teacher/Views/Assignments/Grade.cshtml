@model DuAnTotNghiep.Models.PracticeSubmission
@{
    ViewData["Title"] = "Chấm điểm bài làm - " + Model.Student.FullName;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chấm bài</span>
        <h1>Chấm điểm bài nộp</h1>
        <p>@Model.Student.FullName · @Model.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <a asp-action="Submissions" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Bài nộp
    </a>
</div>

<div class="teacher-grading-layout">
    <div class="teacher-dashboard-main">
        <section class="teacher-panel">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Đề bài</span>
                    <h2>@Model.PracticeTask.Title</h2>
                </div>
            </div>
            <div class="teacher-submission-box">@Model.PracticeTask.Instruction</div>
        </section>

        <section class="teacher-panel">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Bài làm</span>
                    <h2>Nội dung học viên nộp</h2>
                </div>
            </div>
            <div class="teacher-submission-box">
                @if (string.IsNullOrEmpty(Model.SubmissionText))
                {
                    <span class="teacher-muted">Không có nội dung văn bản.</span>
                }
                else
                {
                    @Model.SubmissionText
                }

                @if (!string.IsNullOrEmpty(Model.FileUrl))
                {
                    <div class="teacher-callout mt-3">
                        <span>Tệp đính kèm</span>
                        <a href="@Model.FileUrl" target="_blank" rel="noopener">Xem tệp tài liệu</a>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.AudioUrl))
                {
                    <div class="teacher-callout mt-3">
                        <span>Bản ghi âm</span>
                        <audio controls>
                            <source src="@Model.AudioUrl" type="audio/mpeg" />
                            Trình duyệt của bạn không hỗ trợ phát âm thanh.
                        </audio>
                    </div>
                }
            </div>
        </section>

        @if (!string.IsNullOrEmpty(Model.AiFeedback))
        {
            <section class="teacher-panel">
                <div class="teacher-section-header">
                    <div>
                        <span class="teacher-section-kicker">Tham khảo</span>
                        <h2>Đánh giá gợi ý từ AI</h2>
                    </div>
                </div>
                <div class="teacher-submission-box">@Model.AiFeedback</div>
            </section>
        }
    </div>

    <aside class="teacher-panel teacher-grading-panel">
        <div class="teacher-section-header">
            <div>
                <span class="teacher-section-kicker">Giáo viên</span>
                <h2>Bảng chấm điểm</h2>
            </div>
        </div>
        <form asp-action="Grade" asp-route-id="@Model.Id" method="post" class="teacher-form">
            <dl class="teacher-detail-grid is-compact">
                <div>
                    <dt>Học viên</dt>
                    <dd>@Model.Student.FullName</dd>
                </div>
                <div>
                    <dt>Thời gian nộp</dt>
                    <dd>@Model.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
            </dl>

            <div>
                <label for="Score">Điểm số (thang 100)</label>
                <input id="Score" type="number" step="0.1" name="Score" value="@(Model.Score ?? 0)" min="0" max="100" required />
                <p class="teacher-field-help">Nhập điểm từ 0.0 đến 100.0.</p>
            </div>

            <div>
                <label for="TeacherFeedback">Nhận xét của giáo viên</label>
                <textarea id="TeacherFeedback" name="TeacherFeedback" rows="5" placeholder="Nhập lời khuyên, nhận định chi tiết cho học viên">@Model.TeacherFeedback</textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">Hoàn tất chấm điểm</button>
        </form>
    </aside>
</div>
