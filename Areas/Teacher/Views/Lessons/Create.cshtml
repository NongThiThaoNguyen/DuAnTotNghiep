@model DuAnTotNghiep.Models.ViewModels.Teacher.CreateLessonViewModel
@{
    ViewData["Title"] = "Thêm bài học mới";
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Bài học</span>
        <h1>Thêm bài học mới</h1>
        <p>@Model.TopicTitle</p>
    </div>
    <a asp-action="Index" asp-route-courseId="@Model.TopicId" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Danh sách bài học
    </a>
</div>

<div class="teacher-panel teacher-form-panel">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="teacher-form">
        <div asp-validation-summary="ModelOnly" class="teacher-validation-summary"></div>
        <input type="hidden" asp-for="TopicId" />
        <input type="hidden" asp-for="TopicTitle" />
        <input type="hidden" asp-for="DifficultyLevel" />

        <div class="teacher-form-grid">
            <div>
                <label asp-for="Title">Tên bài học</label>
                <input asp-for="Title" required />
                <span asp-validation-for="Title" class="teacher-field-error"></span>
            </div>

            <div>
                <label asp-for="EstimatedMinutes">Thời lượng (phút)</label>
                <input asp-for="EstimatedMinutes" type="number" min="1" required />
                <span asp-validation-for="EstimatedMinutes" class="teacher-field-error"></span>
            </div>

            <div class="teacher-field-wide">
                <label asp-for="Summary">Tóm tắt bài học</label>
                <input asp-for="Summary" />
                <span asp-validation-for="Summary" class="teacher-field-error"></span>
            </div>
        </div>

        <section class="teacher-subpanel" aria-labelledby="lessonVideoHeading">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Video</span>
                    <h2 id="lessonVideoHeading">Nguồn video bài giảng</h2>
                </div>
            </div>
            <div class="teacher-form-grid">
                <div>
                    <label asp-for="VideoUrl">Nhúng link YouTube hoặc Vimeo</label>
                    <input asp-for="VideoUrl" placeholder="https://www.youtube.com/embed/..." />
                    <span asp-validation-for="VideoUrl" class="teacher-field-error"></span>
                </div>
                <div>
                    <label asp-for="UploadVideo">Tải lên tệp video</label>
                    <input type="file" asp-for="UploadVideo" accept=".mp4,.webm,.avi" />
                    <p class="teacher-field-help">Hỗ trợ .mp4, .webm, .avi. Tối đa 100MB.</p>
                </div>
            </div>
        </section>

        <section class="teacher-subpanel" aria-labelledby="lessonContentHeading">
            <div class="teacher-section-header">
                <div>
                    <span class="teacher-section-kicker">Nội dung</span>
                    <h2 id="lessonContentHeading">Nội dung bài học</h2>
                </div>
            </div>

            <div class="teacher-method-tabs" role="radiogroup" aria-label="Cách nhập nội dung bài học">
                <label>
                    <input type="radio" asp-for="InputMethod" value="EDITOR" onchange="switchMethod('EDITOR')" />
                    <span><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Biên soạn thủ công</span>
                </label>
                <label>
                    <input type="radio" asp-for="InputMethod" value="UPLOAD" onchange="switchMethod('UPLOAD')" />
                    <span><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i> Tải lên tài liệu</span>
                </label>
                <label>
                    <input type="radio" asp-for="InputMethod" value="AI" onchange="switchMethod('AI')" />
                    <span><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Trợ lý AI</span>
                </label>
            </div>

            <div id="method-AI" class="teacher-method-panel is-hidden">
                <label for="aiPrompt">Yêu cầu tạo giáo án</label>
                <div class="teacher-inline-control">
                    <input type="text" id="aiPrompt" placeholder="Ví dụ: Soạn bài giảng về cách chia động từ thì hiện tại đơn" />
                    <button type="button" id="btnGenerateAi" class="btn btn-secondary" onclick="generateAiContent()">
                        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                        Tạo nội dung
                    </button>
                </div>
            </div>

            <div id="method-EDITOR" class="teacher-method-panel">
                <label asp-for="Content">Trình soạn nội dung</label>
                <textarea asp-for="Content" rows="12" id="lessonContentEditor"></textarea>
            </div>

            <div id="method-UPLOAD" class="teacher-method-panel is-hidden">
                <label asp-for="UploadFile">Tệp tài liệu bài học</label>
                <input type="file" asp-for="UploadFile" accept=".pdf,.doc,.docx" />
                <p class="teacher-field-help">Hỗ trợ .pdf, .doc, .docx. Tối đa 10MB.</p>
            </div>
        </section>

        <div class="teacher-form-actions">
            <a asp-action="Index" asp-route-courseId="@Model.TopicId" class="btn btn-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary">Lưu bài học</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function switchMethod(method) {
            document.querySelectorAll('.teacher-method-panel').forEach(function (element) {
                element.classList.add('is-hidden');
            });
            document.getElementById('method-' + method).classList.remove('is-hidden');

            if (method === 'AI') {
                document.getElementById('method-EDITOR').classList.remove('is-hidden');
            }
        }

        function generateAiContent() {
            const prompt = document.getElementById('aiPrompt').value;
            if (!prompt) {
                window.showToast('warning', 'Vui lòng nhập chủ đề cho AI.');
                return;
            }

            const btn = document.getElementById('btnGenerateAi');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Đang xử lý';
            btn.disabled = true;

            $.post('@Url.Action("GenerateAiContent", "Lessons", new { area = "Teacher" })', { prompt: prompt }, function (res) {
                if (res.success && typeof tinymce !== 'undefined') {
                    tinymce.get('lessonContentEditor').setContent(res.content);
                    window.showToast('success', 'Đã tạo nội dung. Bạn có thể chỉnh sửa thêm bên dưới.');
                } else {
                    window.showToast('error', res.message || 'Không thể tạo nội dung với AI.');
                }
            }).fail(function () {
                window.showToast('error', 'Không thể kết nối đến máy chủ AI.');
            }).always(function () {
                btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles me-2"></i>Tạo nội dung';
                btn.disabled = false;
            });
        }

        setTimeout(function () {
            if (typeof tinymce !== 'undefined') {
                tinymce.remove('#lessonContentEditor');
                tinymce.init({
                    selector: '#lessonContentEditor',
                    plugins: 'advlist autolink lists link image charmap preview anchor pagebreak searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media table emoticons help',
                    toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | forecolor backcolor emoticons | code',
                    menubar: false,
                    height: 400,
                    content_style: 'body { font-family: "Noto Sans", Arial, sans-serif; font-size: 14px; line-height: 1.6; }',
                    setup: function (editor) {
                        editor.on('change', function () {
                            editor.save();
                        });
                    }
                });
            }
        }, 100);
    </script>
}
