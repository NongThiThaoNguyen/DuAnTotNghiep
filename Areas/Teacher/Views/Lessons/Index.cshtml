@model DuAnTotNghiep.Models.ViewModels.Teacher.LessonIndexViewModel
@{
    ViewData["Title"] = "Bài học - " + Model.CourseTitle;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Bài học</span>
        <h1>Bài học trong khóa</h1>
        <p>@Model.CourseTitle</p>
    </div>
    <div class="teacher-action-group">
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Khóa học
        </a>
        <a asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Thêm bài học
        </a>
    </div>
</div>

<div class="teacher-table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th class="text-center">#</th>
                <th>Bài học</th>
                <th class="text-center">Thời lượng</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Lessons.Any())
            {
                <tr>
                    <td colspan="5" class="teacher-empty-row">Khóa học này chưa có bài học nào.</td>
                </tr>
            }
            @foreach (var item in Model.Lessons)
            {
                <tr>
                    <td class="text-center">@item.OrderIndex</td>
                    <td>
                        <div class="teacher-table-title">
                            <strong>@item.Title</strong>
                            <span>@(item.Summary ?? "Không có tóm tắt.")</span>
                        </div>
                    </td>
                    <td class="text-center teacher-number">@(item.EstimatedMinutes ?? 0) phút</td>
                    <td class="text-center">
                        <span class="teacher-status">@item.Status</span>
                    </td>
                    <td>
                        <div class="teacher-action-group">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="teacher-icon-button" title="Chi tiết" aria-label="Xem chi tiết @item.Title">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="teacher-icon-button" title="Sửa" aria-label="Sửa @item.Title">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" asp-route-courseId="@Model.CourseId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="teacher-icon-button btn-action-delete"
                                        title="Xóa"
                                        aria-label="Xóa @item.Title"
                                        onclick="return confirm('Bạn có chắc chắn muốn xóa bài học này?');">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
