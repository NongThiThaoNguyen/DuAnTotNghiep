@model DuAnTotNghiep.Models.ViewModels.Teacher.LessonDetailViewModel
@{
    ViewData["Title"] = "Chi tiết bài học - " + Model.Title;
}

<div class="teacher-page-header">
    <div>
        <span class="teacher-page-kicker">Chi tiết bài học</span>
        <h1>@Model.Title</h1>
        <p>@(Model.Summary ?? "Không có tóm tắt.")</p>
    </div>
    <div class="teacher-action-group">
        <a asp-action="Index" asp-route-courseId="@Model.TopicId" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Bài học
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            Chỉnh sửa
        </a>
    </div>
</div>

<div class="teacher-panel mb-4">
    <div class="teacher-meta-pills mb-3">
        <span class="teacher-status">Khóa học: @Model.TopicTitle</span>
        <span class="teacher-status is-success">@Model.Status</span>
        <span class="teacher-status">@(Model.EstimatedMinutes ?? 0) phút</span>
    </div>
    <dl class="teacher-detail-grid">
        <div>
            <dt>Ngày tạo</dt>
            <dd>@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
        </div>
        <div>
            <dt>Cập nhật</dt>
            <dd>@Model.UpdatedAt.ToString("dd/MM/yyyy")</dd>
        </div>
        <div>
            <dt>Loại nội dung</dt>
            <dd>@(Model.ContentType ?? "EDITOR")</dd>
        </div>
        <div>
            <dt>Trạng thái</dt>
            <dd>@Model.Status</dd>
        </div>
    </dl>
</div>

<article class="teacher-panel teacher-lesson-content">
    @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
    {
        <div class="teacher-media-frame mb-4">
            <iframe src="@Model.VideoUrl"
                    title="Video bài học"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    }

    <div class="teacher-rich-content">
        @Html.Raw(Model.Content)
    </div>
</article>
