@model DuAnTotNghiep.Models.ViewModels.AILearn.QuizViewModel
@{
    if (Model.IsExamMode)
    {
        Layout = "~/Views/Shared/_ExamLayout.cshtml";
    }
    else
    {
        Layout = "_AILearnLayout";
    }
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
}

@if (Model.IsExamMode)
{
<div class="exam-quiz quiz-taking-shell">
    <!-- Header -->
    <div class="quiz-taking-header">
        <div>
            <div class="quiz-taking-meta">
                <span class="quiz-badge">@Model.CourseTitle</span>
                <span class="quiz-badge quiz-badge-security">Chế độ thi bảo mật</span>
            </div>
            <h1>@Model.Title</h1>
        </div>
        <div class="quiz-header-actions">
            <div class="quiz-taking-timer">
                <i class="fa-regular fa-clock"></i>
                <span id="timerValue" data-limit="@Model.TimeLimitMinutes">@Model.TimeLimitMinutes:00</span>
            </div>
            <button type="button" class="quiz-submit-top" id="submitQuizBtn">Nộp bài <i class="fa-solid fa-arrow-right"></i></button>
        </div>
        <div class="quiz-progress">
            <div><span>Tiến độ bài làm: <strong id="answeredCountText">0</strong> / @Model.TotalQuestions câu</span><strong id="answeredPercentText">0%</strong></div>
            <div class="quiz-progress-track"><span id="progressBar"></span></div>
        </div>
    </div>

    <form asp-controller="Quiz" asp-action="Submit" method="post" id="quizForm" class="quiz-taking-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="quizId" value="@Model.QuizId" />
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="quiz-current-question @(i == 0 ? "is-current" : "is-hidden")" data-question-id="@q.Id" data-question-index="@(i + 1)">
                <div class="quiz-question-heading">
                    <span class="quiz-question-number">@(i + 1)</span>
                    <div><span class="quiz-question-label">Câu @(i + 1) / @Model.TotalQuestions</span><h2>@q.QuestionText</h2></div>
                </div>
                <input type="hidden" name="answers[@q.Id]" class="selected-option-input" />
                <div class="quiz-answer-grid">
                    @{
                        string[] letters = new string[] { "A", "B", "C", "D" };
                    }
                    @for (int o = 0; o < q.Options.Count; o++)
                    {
                        var opt = q.Options[o];
                        var letter = letters[o % 4];
                        <div class="exam-option-label" data-letter="@letter">
                            <div class="exam-option-letter">@letter</div>
                            <div class="exam-option-text">@opt.OptionText</div>
                        </div>
                    }
                </div>
                <div class="quiz-question-footer">
                    <button type="button" class="quiz-nav-button quiz-prev-button" data-quiz-prev>Câu trước <i class="fa-solid fa-chevron-left"></i></button>
                    <span>@(i + 1) / @Model.TotalQuestions</span>
                    <button type="button" class="quiz-nav-button quiz-next-button" data-quiz-next>Câu tiếp theo <i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>
        }
        <aside class="quiz-question-palette">
            <div class="quiz-palette-heading"><h2><i class="fa-solid fa-list"></i> Danh sách câu hỏi</h2><span>@Model.TotalQuestions câu</span></div>
            <div class="quiz-palette-legend"><span><i class="is-answered"></i> Đã chọn</span><span><i></i> Chưa làm</span></div>
            <div class="quiz-palette-list">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <button type="button" class="quiz-palette-button @(i == 0 ? "is-current" : "")" data-quiz-index="@(i + 1)">@(i + 1)</button>
                }
            </div>
            <button type="button" class="quiz-submit-side" id="submitQuizBtnSide">Nộp bài thi <i class="fa-solid fa-arrow-right"></i></button>
        </aside>
    </form>
</div>
}
else
{
<div class="card-ailearn">
    <div class="quiz-header">
        <div><span class="purple-badge">Khóa học: @Model.CourseTitle</span><h2 class="h4 font-weight-bold mb-0">@Model.Title</h2></div>
        <div class="quiz-timer"><i class="fa-regular fa-clock"></i><span id="timerValue" data-limit="@Model.TimeLimitMinutes">@Model.TimeLimitMinutes:00</span></div>
    </div>
    <p class="text-muted small mb-4">@Model.Description</p>
    <form asp-controller="Quiz" asp-action="Submit" method="post" id="quizForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="quizId" value="@Model.QuizId" />
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="question-container" data-question-id="@q.Id"><h3 class="question-text">@(i + 1). @q.QuestionText</h3><input type="hidden" name="answers[@q.Id]" class="selected-option-input" /><div class="quiz-options-list">
                @for (int o = 0; o < q.Options.Count; o++) { var opt = q.Options[o]; <div class="quiz-option-item" data-letter="@("ABCD"[o % 4])"><div class="quiz-option-letter">@("ABCD"[o % 4])</div><div class="quiz-option-text">@opt.OptionText</div></div> }
            </div></div>
        }
        <div class="flex justify-end pt-4 pb-8"><button type="button" class="btn-primary-ailearn" id="submitQuizBtn">Nộp bài kiểm tra</button></div>
    </form>
</div>
}

@section Scripts {
    <script src="~/js/quiz.js" asp-append-version="true"></script>
    <script src="~/js/fullscreen-exam.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.FullscreenExam) {
                window.FullscreenExam.init({
                    attemptId: @Model.AttemptId,
                    attemptType: 'QUIZ',
                    maxViolations: @Model.MaxViolations,
                    reportUrl: '/Quiz/ReportViolation',
                    formId: 'quizForm',
                    autoSubmitOnMaxViolations: true,
                    terminationUrl: '/Quiz'
                });
            }
        });
    </script>
}
