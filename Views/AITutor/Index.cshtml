@model DuAnTotNghiep.Models.ViewModels.AILearn.ChatViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_AILearnLayout";
    ViewData["Title"] = "AI Tutor";
    var candidateKeys = new[] { Configuration["Gemini:ApiKey"], Configuration["GoogleAI:ApiKey"], Configuration["AI:ApiKey"], Configuration["OpenAI:ApiKey"] };
    var apiKey = candidateKeys.FirstOrDefault(k => !string.IsNullOrWhiteSpace(k)) ?? "";
    var enableOfflineMock = Configuration.GetValue<bool>("Gemini:EnableOfflineMock", false) || Configuration.GetValue<bool>("AI:EnableOfflineMock", false);
    var isOnline = !string.IsNullOrWhiteSpace(apiKey) && !enableOfflineMock;
    var candidateModels = new[] { Configuration["Gemini:Model"], Configuration["GoogleAI:Model"], Configuration["AI:Model"] };
    var modelName = candidateModels.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m)) ?? "gemini-3.6-flash";
    var rawStudentAvatarUrl = ViewBag.StudentAvatarUrl as string;
    var studentAvatarUrl = string.IsNullOrWhiteSpace(rawStudentAvatarUrl)
        || rawStudentAvatarUrl.Contains("/default-images/avatar.png", StringComparison.OrdinalIgnoreCase)
        || rawStudentAvatarUrl.Contains("/images/default-avatar.png", StringComparison.OrdinalIgnoreCase)
        ? "/images/default-avatar.svg"
        : rawStudentAvatarUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <style>
        .chat-tutor-status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        .online-dot {
            background-color: #10b981;
            box-shadow: 0 0 8px #10b981;
        }
        .offline-dot {
            background-color: #f59e0b;
            box-shadow: 0 0 8px #f59e0b;
        }
        .chat-offline-banner {
            background-color: #fffbeb;
            border: 1px solid #fef3c7;
            color: #b45309;
            padding: 8px 16px;
            font-size: 11px;
            text-align: center;
        }
    </style>
}

<div class="chat-container-ailearn">
    <!-- Chat Header -->
    <div class="chat-header-ailearn">
        <div class="chat-tutor-profile">
            <div class="chat-tutor-avatar">
                <img src="/images/ai-tutor.svg" alt="AI Tutor" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                <span class="chat-tutor-status @(isOnline ? "bg-emerald-500" : "bg-amber-500")"></span>
            </div>
            <div class="chat-tutor-info">
                <h3>AI English Tutor</h3>
                @if (isOnline)
                {
                    <span class="flex items-center gap-1">
                        <span class="chat-tutor-status-dot online-dot"></span>
                        Đang hoạt động &bull; @modelName
                    </span>
                }
                else
                {
                    <span class="flex items-center gap-1 text-amber-600">
                        <span class="chat-tutor-status-dot offline-dot"></span>
                        Chế độ Offline (Mô phỏng)
                    </span>
                }
            </div>
        </div>
        <div>
            <button class="btn btn-sm btn-outline-secondary" id="btnResetChat" title="Bắt đầu cuộc trò chuyện mới" onclick="resetChat();">
                <i class="fa-solid fa-arrows-rotate me-1" id="resetIcon"></i>Làm mới
            </button>
        </div>
    </div>

    <!-- Offline Mode Warning Banner -->
    @if (!isOnline)
    {
        <div class="chat-offline-banner flex items-center justify-center gap-1.5 font-medium">
            <i class="fa-solid fa-circle-info"></i>
            <span>Hệ thống đang chạy ngoại tuyến do chưa kết nối API key. Một số câu trả lời sẽ được mô phỏng.</span>
        </div>
    }

    <!-- Hidden configs -->
    <input type="hidden" id="conversationId" value="@Model.ConversationId" />
    <input type="hidden" id="studentAvatarUrl" value="@studentAvatarUrl" />
    @Html.AntiForgeryToken()

    <!-- Messages Log -->
    <div class="chat-messages-log" id="chatMessagesLog">
        @foreach (var msg in Model.Messages)
        {
            var isStudent = (msg.SenderType == "STUDENT");
            <div class="chat-bubble-wrapper @(isStudent ? "student" : "ai")">
                <img src="@(isStudent ? studentAvatarUrl : "/images/ai-tutor.svg")" alt="Avatar" class="chat-bubble-avatar" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                <div class="chat-bubble-content">
                    <p class="chat-bubble-text">@msg.MessageText</p>
                    <span class="chat-bubble-time">@msg.TimeLabel</span>
                </div>
            </div>
        }
    </div>



    <!-- Input bar -->
    <div class="chat-input-bar">
        <div class="chat-notice-bar">
            <i class="fa-solid fa-triangle-exclamation chat-notice-icon"></i>
            <span>Lưu ý: Vui lòng không sử dụng từ ngữ tục tĩu hoặc phát ngôn phản cảm.</span>
        </div>
        <form class="chat-input-form" id="chatForm">
            <input type="text" placeholder="Nhập câu hỏi tiếng Anh của bạn tại đây..." id="chatInput" autocomplete="off" required />
            <button type="submit" class="chat-send-btn">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
