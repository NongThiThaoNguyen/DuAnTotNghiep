@{
    ViewData["Title"] = "AI Study English";
    ViewData["MetaDescription"] = "AI Study English giúp học viên học tiếng Anh theo lộ trình, giảng viên theo dõi lớp học và quản trị viên vận hành nội dung trong một hệ thống thống nhất.";
}

<section class="public-section public-hero public-animate" aria-labelledby="landingHeroTitle">
    <div>
        <p class="public-eyebrow">AI Study English</p>
        <h1 id="landingHeroTitle">Học tiếng Anh có lộ trình rõ ràng</h1>
        <p class="public-lede">
            Học viên biết bài tiếp theo, giảng viên theo sát lớp, quản trị viên vận hành nội dung trong cùng một hệ thống.
        </p>
        <div class="public-hero-actions">
            <a asp-area="" asp-controller="Account" asp-action="Register" class="public-button">Bắt đầu học</a>
            <a asp-area="" asp-controller="Account" asp-action="Login" class="public-button-secondary">Đăng nhập</a>
        </div>
    </div>

    <figure class="public-preview">
        <img src="~/images/landing/student-dashboard-preview.png" alt="Bảng học viên AI Study English với tiến độ học tập và lộ trình hiện tại" />
    </figure>
</section>

<section id="features" class="public-section public-animate" aria-labelledby="featuresTitle">
    <header class="public-section-header">
        <h2 id="featuresTitle">Một hệ thống, ba không gian làm việc</h2>
        <p>Mỗi vai trò có một màn hình riêng, nhưng vẫn dùng chung nhịp giao diện classic của AI Study English.</p>
    </header>
    <div class="public-feature-grid">
        <article class="public-feature public-feature--primary">
            <h3>Lộ trình cho học viên</h3>
            <p>Bài tiếp theo, tiến độ và kết quả kiểm tra được đặt gần nhau để người học không mất thời gian tìm đường.</p>
        </article>
        <article class="public-feature">
            <h3>Công cụ cho giảng viên</h3>
            <p>Khóa học, tài liệu, điểm số, điểm danh và tin nhắn nằm trong cùng một workspace.</p>
        </article>
        <article class="public-feature">
            <h3>Vận hành cho quản trị</h3>
            <p>Bảng quản trị ưu tiên dữ liệu dễ quét, trạng thái rõ và thao tác nhanh.</p>
        </article>
    </div>
</section>

<section id="student" class="public-section public-role-row public-role-row--image-left public-animate" aria-labelledby="studentTitle">
    <figure class="public-preview">
        <img src="~/images/landing/student-learning-path-preview.png" alt="Lộ trình học của học viên với các bước học và tiến độ" />
    </figure>
    <div class="public-role-copy">
        <p class="public-eyebrow">Không gian học viên</p>
        <header class="public-section-header">
            <h2 id="studentTitle">Biết mình nên học gì tiếp theo</h2>
            <p>Lộ trình học, placement test, kế hoạch hôm nay và tiến độ được gom lại để học viên đi tiếp mà không phải đoán.</p>
        </header>
        <ul class="public-role-points">
            <li>Bài học hiện tại và bài tiếp theo rõ ràng.</li>
            <li>Tiến độ học tập hiển thị ngay trong dashboard.</li>
        </ul>
    </div>
</section>

<section id="teacher" class="public-section public-role-row public-role-row--image-right public-animate" aria-labelledby="teacherTitle">
    <div class="public-role-copy">
        <p class="public-eyebrow">Không gian giảng viên</p>
        <header class="public-section-header">
            <h2 id="teacherTitle">Một bàn làm việc gọn để theo lớp</h2>
            <p>Tài liệu, tin nhắn, lịch dạy, điểm danh và báo cáo được đặt trong shell đồng nhất để giảng viên thao tác nhanh hơn.</p>
        </header>
        <ul class="public-role-points">
            <li>Hộp thư và lớp học nằm trong cùng luồng làm việc.</li>
            <li>Giao diện giữ nhịp với Admin và Student.</li>
        </ul>
    </div>
    <figure class="public-preview">
        <img src="~/images/landing/teacher-workspace-preview.png" alt="Không gian giảng viên với sidebar, header và hộp thư tin nhắn" />
    </figure>
</section>

<section id="admin" class="public-section public-final-cta public-animate" aria-labelledby="adminTitle">
    <header class="public-section-header">
        <p class="public-eyebrow">Không gian quản trị</p>
        <h2 id="adminTitle">Toàn bộ hệ thống dùng chung một ngôn ngữ giao diện</h2>
        <p>Admin, Teacher và Student chia sẻ font, màu, trạng thái active, header và responsive shell để sản phẩm không bị rời rạc.</p>
    </header>
    <div class="public-hero-actions">
        <a asp-area="" asp-controller="Account" asp-action="Register" class="public-button">Tạo tài khoản</a>
        <a asp-area="" asp-controller="Account" asp-action="Login" class="public-button-secondary">Vào hệ thống</a>
    </div>
</section>
