@using System.Security.Claims
@inject DuAnTotNghiep.Services.Interfaces.INotificationService NotificationService
@{
    var displayName = User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "Giảng viên";
    var initials = string.Join("", displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "GV";
    }

    var unreadCount = 0;
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdClaim, out var userId))
    {
        unreadCount = await NotificationService.GetUnreadCountAsync(userId);
    }
}

<header class="teacher-account-strip rs-account-strip">
    <div class="teacher-account-context rs-account-context">
        <span class="teacher-account-eyebrow rs-account-eyebrow">Giảng viên</span>
        <span class="teacher-account-page rs-account-page">@ViewData["Title"]</span>
    </div>

    <div class="teacher-account-actions rs-account-actions">
        <div class="rs-notification-wrapper" style="position: relative;">
            <button type="button"
                    id="notificationBellBtn"
                    class="teacher-notification-button rs-notification-button"
                    aria-label="Thông báo"
                    aria-expanded="false">
                <i class="fa-regular fa-bell" aria-hidden="true"></i>
                <span id="notificationBadge" class="student-notification-count @(unreadCount > 0 ? "" : "d-none")">@Math.Min(unreadCount, 99)</span>
            </button>

            <div id="notificationDropdownMenu" class="rs-notification-dropdown d-none" aria-hidden="true">
                <div class="rs-notification-dropdown-header">
                    <span class="rs-notification-dropdown-title">Thông báo</span>
                    <button type="button" id="markAllNotificationsReadBtn" class="rs-notification-mark-all">Đánh dấu tất cả đã đọc</button>
                </div>
                <div id="notificationDropdownBody" class="rs-notification-dropdown-body">
                    <div class="rs-notification-loading">Đang tải thông báo...</div>
                </div>
            </div>
        </div>

        <a class="teacher-account-profile rs-account-profile"
           asp-area="Teacher"
           asp-controller="Profile"
           asp-action="Index"
           aria-label="Mở hồ sơ cá nhân">
            <span class="teacher-account-name rs-account-name">
                <strong>@displayName</strong>
                <small>Hồ sơ giảng viên</small>
            </span>
            <span class="teacher-account-avatar rs-account-avatar" aria-hidden="true">@initials</span>
        </a>
    </div>
</header>
