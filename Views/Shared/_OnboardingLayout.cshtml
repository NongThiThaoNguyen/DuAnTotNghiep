<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Study English</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuAnTotNghiep.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-shell.css" asp-append-version="true" />
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <style>
        .onboarding-topbar-wrap {
            position: relative;
            z-index: 50;
        }
        /* Thin hover trigger strip */
        .onboarding-topbar-trigger {
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, #2563eb, #4f46e5);
            cursor: pointer;
            z-index: 51;
            transition: opacity 0.2s ease;
        }
        .onboarding-topbar-wrap:hover .onboarding-topbar-trigger {
            opacity: 0;
        }
        /* The actual topbar — hidden by default, slides down on hover */
        .onboarding-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.65rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
            /* Auto-hide: collapsed */
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.2s ease;
            padding-top: 0;
            padding-bottom: 0;
        }
        .onboarding-topbar-wrap:hover .onboarding-topbar {
            max-height: 60px;
            opacity: 1;
            padding-top: 0.65rem;
            padding-bottom: 0.65rem;
        }

        .onboarding-brand {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            font-weight: 800;
            font-size: 1rem;
            color: #0f172a;
            text-decoration: none;
        }
        .onboarding-brand-mark {
            width: 2rem;
            height: 2rem;
            border-radius: 0.5rem;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.95rem;
            box-shadow: 0 4px 10px rgba(37,99,235,0.25);
        }
        .onboarding-logout {
            font-size: 0.82rem;
            font-weight: 600;
            color: #64748b;
            background: none;
            border: none;
            cursor: pointer;
            transition: color 0.15s ease;
        }
        .onboarding-logout:hover { color: #ef4444; }
        .onboarding-main {
            flex: 1 1 auto;
            padding: 1.5rem 1rem 3rem;
            width: 100%;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="role-shell onboarding-shell h-full flex flex-col min-h-screen bg-slate-50">
    <a class="rs-skip-link" href="#mainContent">Bỏ qua đến nội dung chính</a>

    <!-- Topbar (auto-hide — hover top strip to reveal) -->
    <div class="onboarding-topbar-wrap">
        <div class="onboarding-topbar-trigger" title="Di chuyển chuột vào đây để hiện menu" aria-hidden="true"></div>
        <header class="onboarding-topbar">
            <a class="onboarding-brand" href="/Dashboard">
                <span class="onboarding-brand-mark">✦</span>
                <span>AI Study English</span>
            </a>
            <div>
                <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="onboarding-logout">
                        Đăng xuất
                    </button>
                </form>
            </div>
        </header>
    </div>

    <main id="mainContent" class="onboarding-main">
        <div class="w-full">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
