<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Study English</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuAnTotNghiep.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-shell.css" asp-append-version="true" />
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="role-shell onboarding-shell h-full flex flex-col min-h-screen">
    <a class="rs-skip-link" href="#mainContent">Bỏ qua đến nội dung chính</a>

    <!-- Header nhỏ đơn giản (Tùy chọn) -->
    <header class="onboarding-topbar">
        <a class="onboarding-brand" href="/Dashboard">
            <span class="rs-sidebar-logo-mark flex h-10 w-10 items-center justify-center rounded-lg text-sm font-extrabold">D</span>
            <span>AI Study English</span>
        </a>
        <div>
            <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="onboarding-logout">
                    Đăng xuất
                </button>
            </form>
        </div>
    </header>

    <main id="mainContent" class="onboarding-main">
        <div class="w-full">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
