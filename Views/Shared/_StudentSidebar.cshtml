@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool IsActive(string controller, string? area = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (area == null)
        {
            return controllerMatches && string.IsNullOrEmpty(currentArea);
        }
        return controllerMatches && string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(bool isActive) => "c26-nav-link role-nav-link student-nav-link rs-nav-link" + (isActive ? " is-active" : "");
}

<aside id="studentSidebar"
       class="student-sidebar role-sidebar student-sidebar-closed rs-sidebar is-closed"
       aria-label="Điều hướng học viên"
       data-rs-sidebar
       data-rs-closed-class="student-sidebar-closed">

    <div class="student-sidebar-body rs-sidebar-body" style="padding: 0; display: flex; flex-direction: column; height: 100%;">

        <!-- Brand -->
        <a href="/Dashboard" class="c26-brand student-brand rs-brand" aria-label="AI Study English">
            <span class="c26-brand-mark student-brand-mark rs-brand-mark" aria-hidden="true">✦</span>
            <span class="c26-brand-text student-brand-copy rs-brand-copy">
                <span class="c26-brand-title">AI Study English</span>
                <span class="c26-brand-sub">Học viên</span>
            </span>
        </a>

        <!-- Nav Body -->
        <div style="flex: 1; overflow-y: auto; padding: 8px 0;">

            <!-- Group: Học tập -->
            <div class="c26-nav-group">
                <p class="c26-nav-label student-nav-section rs-nav-section">Học tập</p>
                <nav aria-label="Học tập">
