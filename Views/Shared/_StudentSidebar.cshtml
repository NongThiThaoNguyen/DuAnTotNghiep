                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 4H4a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-4M14 4l6 6-4 4H11v-4l3-6Z"/>
                        </svg>
                        <span>Ghi chú</span>
                    </a>
                    <a href="/Achievements" class="@NavClass(IsActive("Achievements"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 2.2 4.45 4.91.72-3.55 3.46.84 4.89L12 14.2l-4.4 2.32.84-4.89-3.55-3.46 4.91-.72L12 3Zm-3 14.5V22l3-2 3 2v-4.5"/>
                        </svg>
                        <span>Thành tích</span>
                    </a>
                    <a href="/Student/Profile/EditLearningProfile" class="@NavClass(IsActive("Profile", "Student") || IsActive("Profile"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <circle cx="12" cy="8" r="4" stroke-width="1.8"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 20a7 7 0 0 1 14 0"/>
                        </svg>
                        <span>Hồ sơ &amp; cài đặt</span>
                    </a>
                </nav>
            </div>

        </div><!-- end nav body -->

        <!-- Footer -->
        <div class="c26-sidebar-footer student-sidebar-footer rs-sidebar-footer">
            <a href="/Account/Logout" class="c26-logout-link student-logout-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m16 17 5-5-5-5m5 5H9m3 5v2H4V5h8v2"/>
                </svg>
                <span>Đăng xuất</span>
            </a>
        </div>

    </div>
</aside>

<script>
    (function () {
        const sidebar = document.getElementById('studentSidebar');
        if (sidebar && window.AdminSidebarState) {
            const key = 'student-sidebar-scroll-top';
            window.AdminSidebarState.restore(sidebar, window.sessionStorage, key);
            window.AdminSidebarState.revealActive(sidebar, sidebar.querySelector('.c26-nav-link.is-active'));
            window.AdminSidebarState.bind(sidebar, window.sessionStorage, key);
        }
    })();
</script>
