                            <rect x="3" y="3" width="7" height="9" rx="1.5" stroke-width="1.8"/>
                            <rect x="14" y="3" width="7" height="5" rx="1.5" stroke-width="1.8"/>
                            <rect x="14" y="12" width="7" height="9" rx="1.5" stroke-width="1.8"/>
                            <rect x="3" y="16" width="7" height="5" rx="1.5" stroke-width="1.8"/>
                        </svg>
                        <span>Hôm nay</span>
                    </a>
                    <a href="/Student" class="@NavClass(IsActive("Home", "Student"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12 12 3l9 9M5 10v10h14V10M9 20v-6h6v6"/>
                        </svg>
                        <span>Tổng quan học tập</span>
