                        </svg>
                        <span>Lộ trình học</span>
                    </a>
                    <a href="/Student/StudyPlan/Today" class="@NavClass(IsActive("StudyPlan", "Student"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="1.8"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 2v4M16 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
                        </svg>
                        <span>Kế hoạch học</span>
                    </a>
                    <a href="/Student/Schedule" class="@NavClass(IsActive("Schedule", "Student"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
                            <path stroke-linecap="round" stroke-width="1.8" d="M8 2v4M16 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
                        </svg>
                        <span>Lịch học</span>
                    </a>
                    <a href="/Student/Progress" class="@NavClass(IsActive("Progress", "Student"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
