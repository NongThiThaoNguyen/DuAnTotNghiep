@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool IsActive(string controller, string? area = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (area == null)
        {
            return controllerMatches && string.IsNullOrEmpty(currentArea);
        }

        return controllerMatches && string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(bool isActive) => "role-nav-link student-nav-link rs-nav-link" + (isActive ? " is-active" : "");
}

<aside id="studentSidebar" class="student-sidebar role-sidebar student-sidebar-closed rs-sidebar is-closed" aria-label="Điều hướng học viên" data-rs-sidebar data-rs-closed-class="student-sidebar-closed">
    <div class="student-sidebar-body rs-sidebar-body">
        <a href="/Dashboard" class="student-brand rs-brand" aria-label="AI Study English - Học viên">
            <span class="student-brand-mark rs-brand-mark">D</span>
            <span class="student-brand-copy rs-brand-copy">
                <strong>AI Study English</strong>
                <small>Không gian học tập</small>
            </span>
        </a>

        <div class="student-nav-section rs-nav-section">Học tập</div>
        <nav class="student-nav-list rs-nav-list" aria-label="Học tập">
            <a href="/Dashboard" class="@NavClass(IsActive("Dashboard"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 13h6V4H4v9Zm10 7h6v-9h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z" /></svg>
                <span>Hôm nay</span>
            </a>
            <a href="/Student" class="@NavClass(IsActive("Home", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12 12 3l9 9M5 10v10h14V10M9 20v-6h6v6" /></svg>
                <span>Tổng quan học tập</span>
            </a>
            <a href="/Student/LearningPath" class="@NavClass(IsActive("LearningPath", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4v16M19 4v16M5 7h6a3 3 0 0 1 3 3v4a3 3 0 0 0 3 3h2M2 4h6M16 20h6" /></svg>
                <span>Lộ trình học</span>
            </a>
            <a href="/Student/StudyPlan/Today" class="@NavClass(IsActive("StudyPlan", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h3m2 0h3m-8 4h3" /></svg>
                <span>Kế hoạch học</span>
            </a>
            <a href="/Student/Progress" class="@NavClass(IsActive("Progress", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 20V10m7 10V4m7 16v-7M3 20h18" /></svg>
                <span>Tiến độ</span>
            </a>
        </nav>

        <div class="student-nav-section rs-nav-section">Luyện tập</div>
        <nav class="student-nav-list rs-nav-list" aria-label="Luyện tập">
            <a href="/Student/PlacementTest/Intro" class="@NavClass(IsActive("PlacementTest", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 4h8m-7 4h6m-7 4h8m-8 4h5M6 2h12v20H6V2Z" /></svg>
                <span>Kiểm tra đầu vào</span>
            </a>
            <a href="/Courses" class="@NavClass(IsActive("Courses"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Zm16 0A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z" /></svg>
                <span>Khóa học</span>
            </a>
            <a href="/Quiz" class="@NavClass(IsActive("Quiz"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m8 12 2.5 2.5L16 9M5 3h14v18H5V3Z" /></svg>
                <span>Quiz luyện tập</span>
            </a>
            <a href="/AITutor" class="@NavClass(IsActive("AITutor"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 8h10a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3h-5l-4 3v-3H7a3 3 0 0 1-3-3v-5a3 3 0 0 1 3-3Zm2 4h.01M15 12h.01M12 3v3" /></svg>
                <span>Trợ lý AI</span>
            </a>
        </nav>

        <div class="student-nav-section rs-nav-section">Cá nhân</div>
        <nav class="student-nav-list rs-nav-list" aria-label="Cá nhân">
            <a href="/Notes" class="@NavClass(IsActive("Notes"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3h14v18H5V3Zm4 5h6m-6 4h6m-6 4h4" /></svg>
                <span>Ghi chú</span>
            </a>
            <a href="/Achievements" class="@NavClass(IsActive("Achievements"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 2.2 4.45 4.91.72-3.55 3.46.84 4.89L12 14.2l-4.4 2.32.84-4.89-3.55-3.46 4.91-.72L12 3Zm-3 14.5V22l3-2 3 2v-4.5" /></svg>
                <span>Thành tích</span>
            </a>
            <a href="/Profile" class="@NavClass(IsActive("Profile") || IsActive("Profile", "Student"))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 9a7 7 0 0 0-14 0" /></svg>
                <span>Hồ sơ và cài đặt</span>
            </a>
        </nav>
    </div>

    <div class="student-sidebar-footer rs-sidebar-footer">
        <a href="/Account/Logout" class="student-logout-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m16 17 5-5-5-5m5 5H9m3 5v2H4V5h8v2" /></svg>
            <span>Đăng xuất</span>
        </a>
    </div>
</aside>

<script>
    (function () {
        const sidebar = document.getElementById('studentSidebar');
        if (sidebar && window.AdminSidebarState) {
            const key = 'student-sidebar-scroll-top';
            window.AdminSidebarState.restore(sidebar, window.sessionStorage, key);
            window.AdminSidebarState.revealActive(sidebar, sidebar.querySelector('.student-nav-link.is-active'));
            window.AdminSidebarState.bind(sidebar, window.sessionStorage, key);
        }
    })();
</script>
