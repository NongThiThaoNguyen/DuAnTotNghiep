                    </a>
                </nav>
            </div>

            <!-- Group: Cá nhân -->
            <div class="c26-nav-group">
                <p class="c26-nav-label student-nav-section rs-nav-section">Cá nhân</p>
                <nav aria-label="Cá nhân">
                    <a href="/Student/Messages" class="@NavClass(IsActive("Messages", "Student"))">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z"/>
                        </svg>
