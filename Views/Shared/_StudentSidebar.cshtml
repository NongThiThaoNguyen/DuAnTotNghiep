                        </svg>
                        <span>Tiến độ</span>
                    </a>
                </nav>
            </div>

            <!-- Group: Luyện tập -->
            <div class="c26-nav-group">
                <p class="c26-nav-label student-nav-section rs-nav-section">Luyện tập</p>
                <nav aria-label="Luyện tập">
