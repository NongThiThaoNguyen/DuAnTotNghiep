@using System.Security.Claims
@inject DuAnTotNghiep.Services.Interfaces.INotificationService NotificationService
@{
    var userName = User.FindFirstValue(ClaimTypes.Name) ?? "Học viên";
    var initials = string.Concat(userName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "HV";
    }

    var unreadCount = 0;
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdClaim, out var userId))
    {
        unreadCount = await NotificationService.GetUnreadCountAsync(userId);
    }

    var pageTitle = ViewData["Title"]?.ToString() ?? "Trang";
}

<header class="student-account-strip rs-account-strip" role="banner">

    <!-- Left: Page context -->
    <div class="c26-header-left rs-account-context">
        <span class="c26-header-eyebrow rs-account-eyebrow">Học viên</span>
        <span class="c26-header-title rs-account-page">@pageTitle</span>
    </div>

    <!-- Right: Actions -->
    <div class="c26-header-right student-account-actions rs-account-actions">

        <!-- Notification Bell -->
        <div class="rs-notification-wrapper" style="position: relative;">
            <button type="button"
                    id="notificationBellBtn"
                    class="c26-notif-btn student-notification-link rs-notification-button"
                    aria-label="Thông báo@(unreadCount > 0 ? $": {unreadCount} chưa đọc" : "")"
                    aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                          d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                @if (unreadCount > 0)
                {
                    <span id="notificationBadge"
                          class="c26-notif-badge student-notification-count">@Math.Min(unreadCount, 99)</span>
                }
                else
                {
                    <span id="notificationBadge"
                          class="c26-notif-badge student-notification-count d-none">0</span>
                }
            </button>

            <div id="notificationDropdownMenu"
                 class="rs-notification-dropdown d-none"
                 aria-hidden="true">
                <div class="rs-notification-dropdown-header">
                    <span class="rs-notification-dropdown-title">Thông báo</span>
                    <button type="button"
                            id="markAllNotificationsReadBtn"
                            class="rs-notification-mark-all">
                        Đánh dấu tất cả đã đọc
                    </button>
                </div>
                <div id="notificationDropdownBody" class="rs-notification-dropdown-body">
                    <div class="rs-notification-loading">Đang tải thông báo...</div>
                </div>
            </div>
        </div>

        <!-- User Profile Chip -->
        <a href="/Student/Profile/EditLearningProfile"
           class="c26-profile-chip student-account-card rs-account-profile"
           aria-label="Tài khoản: @userName">
            <span class="c26-avatar student-account-avatar rs-account-avatar"
                  aria-hidden="true">@initials</span>
            <span class="c26-profile-info" style="display:flex;flex-direction:column;min-width:0;">
                <span class="c26-profile-name rs-account-name">@userName</span>
                <span class="c26-profile-role" style="font-size:10.5px;color:var(--c26-text-muted);">Hồ sơ học viên</span>
            </span>
        </a>

    </div>
</header>
