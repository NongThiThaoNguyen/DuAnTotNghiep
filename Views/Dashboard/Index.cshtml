@model DuAnTotNghiep.Models.ViewModels.Student.StudentDashboardViewModel
@{
    Layout = "_AILearnLayout";
    ViewData["Title"] = "Tổng quan";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<!-- Welcome Section -->
<div class="dashboard-header-block">
    <h1>Chào @Model.StudentName</h1>
    <p>Tiếp tục từ phần bạn đang học hoặc xem lại tiến độ trong tuần.</p>
</div>

<section class="dashboard-next-task" aria-labelledby="next-task-title">
    <div class="dashboard-next-task-copy">
        <span class="dashboard-next-task-label">Nhiệm vụ tiếp theo</span>
        @if (Model.NextTask != null)
        {
            <h2 id="next-task-title">@Model.NextTask.Title</h2>
            <p>@Model.NextTask.NodeType · khoảng @Model.NextTask.EstimatedMinutes phút</p>
        }
        else
        {
            <h2 id="next-task-title">Xem lại lộ trình học hiện tại</h2>
            <p>Chọn một nội dung phù hợp để bắt đầu phiên học hôm nay.</p>
        }
    </div>
    <a href="@(Model.NextTask?.TargetUrl ?? "/Student/LearningPath")" class="dashboard-next-task-action">
        Bắt đầu học
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
</section>

<!-- Stats Row Grid -->
<div class="dashboard-stats-row">
    <!-- Stat 1: Study time -->
    <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon-box time">
            <i class="fa-solid fa-clock"></i>
        </div>
        <div class="dashboard-stat-info">
            <span class="dashboard-stat-label">Thời gian học tuần này</span>
            <span class="dashboard-stat-value">@Model.StudyMinutesThisWeek phút</span>
            <span class="dashboard-stat-subtext green">Tổng thời lượng ghi nhận</span>
        </div>
    </div>

    <!-- Stat 2: Completed lessons -->
    <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon-box success">
            <i class="fa-solid fa-book-open"></i>
        </div>
        <div class="dashboard-stat-info">
            <span class="dashboard-stat-label">Bài đã hoàn thành</span>
            <span class="dashboard-stat-value">@Model.CompletedLessons bài</span>
            <span class="dashboard-stat-subtext green">Đã hoàn thành trong lộ trình</span>
        </div>
    </div>

    <!-- Stat 3: Avg score -->
    <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon-box info">
            <i class="fa-solid fa-chart-line"></i>
        </div>
        <div class="dashboard-stat-info">
            <span class="dashboard-stat-label">Điểm trung bình</span>
            <span class="dashboard-stat-value">@(Model.HasQuizAttempts ? $"{Model.AverageQuizScore.ToString("0.0")}đ" : "Chưa có dữ liệu")</span>
            <span class="dashboard-stat-subtext green">Từ các bài quiz đã làm</span>
        </div>
    </div>

    <!-- Stat 4: Streak -->
    <div class="dashboard-stat-card">
        <div class="dashboard-stat-icon-box streak">
            <i class="fa-solid fa-fire"></i>
        </div>
        <div class="dashboard-stat-info">
            <span class="dashboard-stat-label">Chuỗi ngày học</span>
            <span class="dashboard-stat-value">@Model.StreakDays ngày</span>
            <span class="dashboard-stat-subtext orange">Duy trì nhịp học đều</span>
        </div>
    </div>
</div>

<!-- Main Section columns -->
<div class="dashboard-cols-layout">
    <!-- Left Column -->
    <div>
        <!-- Learning Path Progress Card -->
        <div class="dashboard-panel-card">
            <div class="path-timeline-header">
                <h3>Lộ trình học tập của bạn</h3>
                <span>@Model.ProgressPercent%</span>
            </div>
            <div class="progress-bar-ailearn mb-4">
                <div class="progress-bar-fill" style="width: @Model.ProgressPercent%"></div>
            </div>

            <div class="path-timeline-list">
                <div class="path-timeline-node completed">Mục tiêu hiện tại: @(Model.CurrentLevel ?? "Chưa xác định")</div>
                <div class="path-timeline-node">Mục tiêu tiếp theo: @(Model.TargetLevel ?? "Chưa xác định")</div>
            </div>
        </div>

        <!-- Khóa học của bạn Card -->
        <div class="dashboard-panel-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0"><i class="fa-solid fa-graduation-cap text-primary me-2"></i>Khóa học của bạn</h2>
                <a href="/Courses" class="btn btn-sm btn-outline-primary rounded-pill">Xem tất cả</a>
            </div>

            @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
            {
                <div class="row g-3">
                    @foreach (var c in Model.EnrolledCourses)
                    {
                        <div class="col-md-6">
                            <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <span class="badge bg-primary-subtle text-primary mb-1">@c.SkillName</span>
                                    <h5 class="fw-bold mb-1 text-truncate">@c.Title</h5>
                                    <small class="text-muted block">@c.LessonCount bài học</small>
                                </div>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between text-xs font-bold mb-1">
                                        <span>Tiến độ</span>
                                        <span class="text-primary">@c.ProgressPercent%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(c.ProgressPercent)%" aria-valuenow="@c.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 bg-light rounded-3">
                    <i class="fa-solid fa-book-open text-muted fs-3 mb-2"></i>
                    <h6 class="fw-bold mb-1">Chưa tham gia khóa học nào</h6>
                    <p class="text-muted text-xs mb-3">Bạn chưa bắt đầu khóa học nào. Hãy khám phá các khóa học ngay!</p>
                    <a href="/Courses" class="btn btn-sm btn-primary">Khám phá khóa học</a>
                </div>
            }
        </div>

        <!-- Việc cần làm Card -->
        <div class="dashboard-panel-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0"><i class="fa-solid fa-list-check text-warning me-2"></i>Việc cần làm</h2>
                <span class="badge bg-warning-subtle text-warning">@Model.TodoItems.Count việc</span>
            </div>

            @if (Model.TodoItems != null && Model.TodoItems.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var todo in Model.TodoItems)
                    {
                        string badgeClass = todo.Type == "QUIZ" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary";
                        string typeName = todo.Type == "QUIZ" ? "Quiz" : "Bài học";

                        <div class="p-3 border rounded-3 bg-white d-flex align-items-center justify-between gap-2 shadow-sm">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @badgeClass">@typeName</span>
                                <div>
                                    <h6 class="fw-bold mb-0">@todo.Title</h6>
                                    <small class="text-muted text-xs">Hạn: @(todo.DueDate.HasValue ? todo.DueDate.Value.ToString("dd/MM/yyyy") : "Đang mở")</small>
                                </div>
                            </div>
                            <a href="@(string.IsNullOrEmpty(todo.TargetUrl) ? "/Student/LearningPath" : todo.TargetUrl)" class="btn btn-sm btn-primary rounded-pill px-3 shrink-0">Làm ngay</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 bg-light rounded-3">
                    <i class="fa-solid fa-circle-check text-success fs-3 mb-2"></i>
                    <h6 class="fw-bold mb-1">Không có việc cần làm sắp tới</h6>
                    <p class="text-muted text-xs mb-0">Bạn đã hoàn thành tất cả công việc!</p>
                </div>
            }
        </div>

        <!-- AI Recommendations Card -->
        <div class="dashboard-panel-card">
            <h2><i class="fa-solid fa-bookmark text-primary me-2"></i>Gợi ý ôn tập</h2>
            <div class="ai-recommendation-list">
                <div class="ai-recommendation-card">
                    <span class="ai-rec-title">@Html.Raw(Model.AiRecommendation)</span>
                    @if (Model.NextTask != null)
                    {
                        <a href="@Model.NextTask.TargetUrl" class="ai-rec-btn">Tiếp tục học</a>
                    }
                    else
                    {
                        <a href="/Courses" class="ai-rec-btn">Xem khóa học</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div>
        <!-- Lịch học sắp tới Card -->
        <div class="dashboard-panel-card">
            <h2><i class="fa-regular fa-calendar-days text-info me-2"></i>Lịch học sắp tới</h2>
            @if (Model.UpcomingSchedule != null)
            {
                <div class="p-3 border border-info-subtle bg-info-subtle rounded-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-info text-white">Buổi học gần nhất</span>
                        <small class="fw-bold text-info">@Model.UpcomingSchedule.StartTime.ToString("HH:mm, dd/MM/yyyy")</small>
                    </div>
                    <h6 class="fw-bold mb-1">@Model.UpcomingSchedule.Title</h6>
                    @if (!string.IsNullOrEmpty(Model.UpcomingSchedule.TopicTitle))
                    {
                        <small class="text-muted d-block mb-2">Chủ đề: @Model.UpcomingSchedule.TopicTitle</small>
                    }
                    <div class="row g-2 pt-2 border-top text-xs">
                        <div class="col-6">
                            <span class="text-muted d-block">Giảng viên</span>
                            <strong>@Model.UpcomingSchedule.TeacherName</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block">Phòng học</span>
                            <strong>@(string.IsNullOrEmpty(Model.UpcomingSchedule.Classroom) ? "Trực tuyến" : Model.UpcomingSchedule.Classroom)</strong>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.UpcomingSchedule.MeetUrl))
                    {
                        <div class="mt-3">
                            <a href="@Model.UpcomingSchedule.MeetUrl" target="_blank" class="btn btn-success btn-sm w-100 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-xs">
                                <i class="fa-solid fa-video"></i> 🎥 Tham gia Google Meet ngay
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 bg-light rounded-3">
                    <i class="fa-regular fa-clock text-muted fs-4 mb-2"></i>
                    <h6 class="fw-bold mb-1">Chưa có lịch học sắp tới</h6>
                    <p class="text-muted text-xs mb-0">Theo dõi lịch thông báo từ nhà trường và giảng viên.</p>
                </div>
            }
        </div>

        <!-- AI Tutor Quick Chat Card -->
        <div class="tutor-banner-card">
            <h3>Trợ lý học tập</h3>
            <p>Nhận giải thích cho bài tập hoặc gợi ý cách ôn lại phần chưa chắc.</p>
            <a href="/AITutor" class="tutor-banner-btn">
                <span>Mở trợ lý học tập</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- Recent Activities Card -->
        <div class="dashboard-panel-card">
            <h2>Hoạt động gần đây</h2>
            <div class="timeline-list">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-item-info">
                            <span class="timeline-item-title">Bắt đầu hành trình học tập</span>
                            <span class="timeline-item-time">Bắt đầu từ lộ trình hiện tại và ghi lại các hoạt động học mới nhất.</span>
                        </div>
                    </div>
                }
                else
                {
                    foreach (var act in Model.RecentActivities)
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="timeline-item-info">
                                <span class="timeline-item-title">@act.Title</span>
                                <span class="timeline-item-time">@act.CreatedAt.ToString("HH:mm dd/MM") - @act.ActivityTypeLabel</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
